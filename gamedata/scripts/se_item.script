	unregister_story_object_by_id(self.id)
	cse_alife_inventory_box.on_unregister(self)
end
function se_invbox:can_switch_online()
	if(self.secret_item) then
		return false
	end
	return cse_alife_inventory_box.can_switch_online(self)
end

