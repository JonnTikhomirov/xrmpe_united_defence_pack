	to_log(sModule..":> InitControls") --/#~#

	-- список поиска объектов
	self.find_object_frame = xml:InitFrame("frame_right_clean:find_object_frame", owner.frame_right)
	self.find_object_list = xml:InitListBox("frame_right_clean:find_object_frame:find_object_list", self.find_object_frame)
	self.find_object_list:ShowSelectedItem(true)
	owner:Register(self.find_object_list, "clean_find_object_list")

	self.find_object_frame_controls = { self.find_object_list }

	-- раздел поиска объекта, информации об объекте, удаления выбранного объекта
	self.find_object_info = xml:InitFrame("frame_right_clean:find_object_info", owner.frame_right)
	self.info_location_caption = xml:InitStatic("frame_right_clean:find_object_info:info_location_caption", self.find_object_info)
	self.info_location_text = xml:InitStatic("frame_right_clean:find_object_info:info_location_text", self.find_object_info)
	self.info_smart_caption = xml:InitStatic("frame_right_clean:find_object_info:info_smart_caption", self.find_object_info)
	self.info_smart_text = xml:InitStatic("frame_right_clean:find_object_info:info_smart_text", self.find_object_info)

	-- разделитель
	self.separator = xml:InitFrameLine("frame_right_clean:separator", owner.frame_right)

	self.find_object_info_controls = { self.info_location_caption, self.info_location_text, self.info_smart_caption, self.info_smart_text, self.separator }

	-- раздел поиска объекта, кнопки
	self.find_object_buttons = xml:InitFrame("frame_right_clean:find_object_buttons", owner.frame_right)
