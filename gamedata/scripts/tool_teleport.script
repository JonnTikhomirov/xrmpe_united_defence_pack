local sModule = script_name() --/ строковое имя файла-модуля
local sim = alife() --/ кеширование алайфа
local sNoValue = game.translate_string("tool_no_value") --/ стандартный текст для отсутствия чего-либо (прочерк)

class "teleport"

function teleport:__init(owner_name)
	--to_log(sModule..":> __init") --/#~#
	self.owner_script = _G[owner_name]
	--self.ltx_path_save = self.owner_script.GetFullPath("$tool_misc$", owner_name.."\\teleport_custom.ltx")-- +UP
	self.ltx_path_save = "misc\\"..owner_name.."\\teleport_custom.ltx"-- +UP
	self.tLocations = {} --/ массив идентификаторов локаций
	self.tSmarts = {} --/ массив смартов для перехода
	self.tPoints = {} --/ массив произвольных точек для перехода (конфиг)
	self.tObjects = {} --/ массив найденных объектов для перехода
	self.tCustomPoints = {} --/ массив произвольных точек в разделе телепорта
	self.bSmartsLoaded = false --/ флаг загрузки информации о смартах
	self.checkbox_boxes_default = false --/ флаг состояния чекбокса "искать в контейнерах" по умолчанию
	self.checkbox_current_location_default = false --/ флаг состояния чекбокса "искать на текущей локации" по умолчанию
	self.checkbox_other_locations_default = false --/ флаг состояния чекбокса "искать на других локациях" по умолчанию
	self.color = { --/ цветовое оформление списка точек
		[0] = GetARGB(255, 216, 186, 140), --/ точка
		[1] = GetARGB(255,  49, 174,  66)  --/ заголовок
	}
end

function teleport:__finalize() end

-- инициализация элементов
