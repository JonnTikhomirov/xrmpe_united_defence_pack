-- инициализация событий
function teleport:InitCallbacks(owner)
	--to_log(sModule..":> InitCallbacks") --/#~#
	owner:AddCallback("teleport_location_list", ui_events.LIST_ITEM_CLICKED, self.OnLocationListItemClicked, self)
	owner:AddCallback("teleport_custom_list", ui_events.WINDOW_LBUTTON_DB_CLICK, self.OnCustomListMouseDblClicked, self)
	owner:AddCallback("teleport_find_object_list", ui_events.LIST_ITEM_CLICKED, self.OnFindObjectListItemClicked, self)
	owner:AddCallback("teleport_find_object_list", ui_events.WINDOW_LBUTTON_DB_CLICK, self.OnFindObjectListMouseDblClicked, self)
	owner:AddCallback("teleport_point_list", ui_events.WINDOW_LBUTTON_DB_CLICK, self.OnPointListMouseDblClicked, self)
	owner:AddCallback("teleport_btn_save", ui_events.BUTTON_CLICKED, self.OnBtnSave, self)
	owner:AddCallback("teleport_btn_load", ui_events.BUTTON_CLICKED, self.OnBtnLoad, self)
	owner:AddCallback("teleport_btn_delete", ui_events.BUTTON_CLICKED, self.OnBtnDelete, self)
	owner:AddCallback("teleport_btn_current", ui_events.BUTTON_CLICKED, self.OnBtnCurrent, self)
	owner:AddCallback("teleport_btn_go", ui_events.BUTTON_CLICKED, self.OnBtnGo, self)
	owner:AddCallback("teleport_btn_fly", ui_events.BUTTON_CLICKED, self.OnBtnFly, self) -- +UDP
	owner:AddCallback("teleport_checkbox_gamezone", ui_events.BUTTON_CLICKED, self.OnCheckGamezone, self) -- +UDP
	owner:AddCallback("teleport_checkbox_invulnerable", ui_events.BUTTON_CLICKED, self.OnCheckInvulnerable, self) -- +UDP
	owner:AddCallback("teleport_btn_name_ok", ui_events.BUTTON_CLICKED, self.OnBtnNameOk, self)
	owner:AddCallback("teleport_btn_name_cancel", ui_events.BUTTON_CLICKED, self.OnBtnNameCancel, self)
	owner:AddCallback("teleport_textbox_name", ui_events.EDIT_TEXT_COMMIT, self.OnBtnNameOk, self)
	owner:AddCallback("teleport_btn_jump_plus", ui_events.BUTTON_CLICKED, self.OnBtnJumpPlus, self)
	owner:AddCallback("teleport_btn_jump_minus", ui_events.BUTTON_CLICKED, self.OnBtnJumpMinus, self)
	owner:AddCallback("teleport_btn_jump_left", ui_events.BUTTON_CLICKED, self.OnBtnJumpLeft, self)
	owner:AddCallback("teleport_btn_jump_forward", ui_events.BUTTON_CLICKED, self.OnBtnJumpForward, self)
	owner:AddCallback("teleport_btn_jump_back", ui_events.BUTTON_CLICKED, self.OnBtnJumpBack, self)
	owner:AddCallback("teleport_btn_jump_right", ui_events.BUTTON_CLICKED, self.OnBtnJumpRight, self)
	owner:AddCallback("teleport_textbox_find", ui_events.EDIT_TEXT_COMMIT, self.OnBtnFind, self)
	owner:AddCallback("teleport_btn_find", ui_events.BUTTON_CLICKED, self.OnBtnFind, self)
	owner:AddCallback("teleport_btn_reset", ui_events.BUTTON_CLICKED, self.OnBtnReset, self)
	owner:AddCallback("teleport_btn_go_2", ui_events.BUTTON_CLICKED, self.OnBtnGo, self)
end

-- подготовка данных при загрузке (объекты недоступны)
function teleport:PrepareData(ltx)
	--to_log(sModule..":> PrepareData start")
	local iCntLocations, iCntPoints = 0, 0
	local trim = string.trim
	local sPointCaption = game.translate_string("tool_teleport_point_caption")

	--/ чтение состояния чекбоксов по умолчанию
	self.checkbox_boxes_default = Get_Cfg_Bool(ltx, "teleport_settings", "checkbox_boxes_default", false)
	self.checkbox_current_location_default = Get_Cfg_Bool(ltx, "teleport_settings", "checkbox_current_location_default", false)
	self.checkbox_other_locations_default = Get_Cfg_Bool(ltx, "teleport_settings", "checkbox_other_locations_default", false)

	--/ чтение таблицы локаций
	local locations = Get_IniSection(ltx, "locations", "table", "key2num")
	for i = 1, table.size(locations) do
		local item = locations[i]
		local location = trim(item[1])
		iCntLocations = iCntLocations + 1
		table.insert(self.tLocations, { id = location, name = item[2] and string.gsub(trim(item[2]), "\"", "") or game.translate_string(location) })

		if Get_Cfg_Bool(ltx, "teleport_settings", "load_static_points", true) then
			--/ чтение таблицы возможных точек телепорта по локации
			local points = Get_IniSection(ltx, location, "list", nil, ",")
			for _,v in pairs(points) do
				if v and v[1] and v[2] and v[3] and v[4] and v[5] then
					iCntPoints = iCntPoints + 1
					local point = {
						id = iCntPoints,
						location = location,
						name = v[6] and string.format("%s", game.translate_string(trim(v[6]))) or string.format("%s %d", sPointCaption, iCntPoints),
						pos = vector():set(tonumber(trim(v[1])),tonumber(trim(v[2])),tonumber(trim(v[3]))),
						lvid = tonumber(trim(v[4])),
						gvid = tonumber(trim(v[5]))
					}
					table.insert(self.tPoints, point)
				end
			end
		end
	end
	self.tPoints = self.owner_script.SortTableByValue(self.tPoints, "asc", "name")

	--to_log(sModule..":> PrepareData locations=[%d], points=[%d]", iCntLocations, iCntPoints)

	-- проверка доступности пространства имён IO (OGSR)
	--if type(io) ~= "table" then return end --/>--+UP

	--/ чтение редактируемых точек из файла
	iCntPoints = 0
	local points = Get_IniSection(ltx, "custom_points", "list", nil, ",")
	for _,v in pairs(points) do
		if v and #v == 7 and v[1] and v[2] and v[3] and v[4] then
			iCntPoints = iCntPoints + 1
			local point = {
				location = trim(v[1]),
				name = v[7] and string.gsub(trim(v[7]), "\"", "") or string.format("%s - %s %d", game.translate_string(v[1]), sPointCaption, iCntPoints),
				pos = vector():set(tonumber(trim(v[2])),tonumber(trim(v[3])),tonumber(trim(v[4]))),
				lvid = v[5] and tonumber(trim(v[5])),
				gvid = v[6] and tonumber(trim(v[6]))
			}
			table.insert(self.tCustomPoints, point)
		end
	end
	self.tCustomPoints = self.owner_script.SortTableByValue(self.tCustomPoints, "asc", "name")

	--to_log(sModule..":> PrepareData custom points=[%d]", iCntPoints)
end

-- подготовка данных при открытии диалога в игре (объекты доступны)
function teleport:PrepareRuntimeData(ltx)
	if self.bSmartsLoaded then return end --/>
	--to_log(sModule..":> PrepareRuntimeData start")

	local gg, iCntSmarts = game_graph(), 0

	if Get_Cfg_Bool(ltx, "teleport_settings", "load_smarts", true) then
		-- чтение списка смартов
		local board = sim_board.get_sim_board()
		for obj_name, smart in pairs(board.smarts_by_names) do
			iCntSmarts = iCntSmarts + 1
			table.insert(self.tSmarts, {
				id = obj_name,
				location = level.name(),--sim:level_name(gg:vertex(smart.m_game_vertex_id):level_id()), -- +UDP
				name = smart_names.get_smart_terrain_name(smart),
				pos = smart.position,
				lvid = smart.m_level_vertex_id,
				gvid = smart.m_game_vertex_id
			})
		end
		self.tSmarts = self.owner_script.SortTableByValue(self.tSmarts, "asc", "id")
		--to_log(sModule..":> PrepareRuntimeData smarts=[%d]", iCntSmarts)
	end

	self.bSmartsLoaded = true
end

-- запись редактируемых точек в файл
function teleport:SaveCustomPoints()
	-- проверка доступности пространства имён IO (OGSR)
	--if type(io) ~= "table" then return end --/>--+UDP
	if true then return end --+UDP не пишем в VFS
	to_log(sModule..":> SaveCustomPoints start to %s", self.ltx_path_save)

	local iCntPoints = 0
	local file = io.open(self.ltx_path_save, "w")
	if file ~= nil then
		file:write("[custom_points]\n")
		if next(self.tCustomPoints) then
			local tPoints = self.owner_script.SortTableByValue(self.tCustomPoints, "asc", "location")
			for _, v in ipairs(tPoints) do
				iCntPoints = iCntPoints + 1
				file:write(string.format("%s, %.3f, %.3f, %.3f, %s, %s, \"%s\"\n", v.location, v.pos.x, v.pos.y, v.pos.z, v.lvid or "", v.gvid or "", v.name))
			end
		end
		file:close()
	end

	to_log(sModule..":> SaveCustomPoints points=[%d]", iCntPoints)
end

-- установка состояния доп. диалога и органов управления под ним
function teleport:SetNameDialog(show)
	-- (раз)блокировка органов управления под доп. диалогом
	local enable = not show
	self.custom_list:Enable(enable)
	self.textbox_jump:Enable(enable)
	self.btn_jump_plus:Enable(enable)
	self.btn_jump_minus:Enable(enable)
	self.btn_jump_left:Enable(enable)
	self.btn_jump_forward:Enable(enable)
	self.btn_jump_back:Enable(enable)
	self.btn_jump_right:Enable(enable)
	self.btn_load:Enable(enable)
	self.btn_save:Enable(enable)
	self.btn_delete:Enable(enable)
	self.btn_current:Enable(enable)
	self.textbox_gv:Enable(enable)
	self.textbox_lv:Enable(enable)
	self.textbox_x:Enable(enable)
	self.textbox_y:Enable(enable)
	self.textbox_z:Enable(enable)
	self.btn_go:Enable(enable)

	-- показ/скрытие диалога
	self.owner:SetFrameShowState(show, self.dlg_name_frame, self.dlg_name_frame_controls)
end

-- нажатия на кнопки
function teleport:OnKeyboard(activeTab, dik, keyboard_action)
	if activeTab ~= sModule then return true end --/>
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_ESCAPE then
			if self.dlg_name_frame:IsShown() then
				self:SetNameDialog(false)
				return false --/>
			end
		end
		self.owner_script.FilterTextboxes(sModule)
	end
	return true --/>
end

-- открытие и инициализация раздела
function teleport:OnTabChange()
	--to_log(sModule..":> OnTabChange start")
	self.location_list:Show(true)
	-- первый элемент (телепорт) добавляем и далее выбираем по умолчанию
	self.owner:AddPrimaryListItem(self.location_list, game.translate_string("tool_teleport_custom"), "custom", self.color[0])
	-- разделительная пустая строка
	--self.owner:AddPrimaryListItem(self.location_list, "", "null", self.color[0])-- +UDP
	-- второй элемент (поиск объекта) добавляем также вручную
	self.owner:AddPrimaryListItem(self.location_list, game.translate_string("tool_teleport_find_object"), "find_object", self.color[0])
	-- разделительная пустая строка
	--self.owner:AddPrimaryListItem(self.location_list, "", "null", self.color[0])-- +UDP
	-- остальные элементы списка локаций
	for _,location in ipairs(self.tLocations) do
		self.owner:AddPrimaryListItem(self.location_list, location.name, location.id, self.color[0])
	end
	self:SetLocation("custom")-- +UDP
end

-- установка выбранной локации
function teleport:SetLocation(location)
	self:HideFields()
	self:ClearFields()

	if location == "custom" then
		-- подраздел "Телепорт"
		self.owner:SetFrameShowState(true, self.custom_frame, self.custom_frame_controls)
		self.owner:SetFrameShowState(true, self.custom_frame_buttons, self.custom_frame_buttons_controls)
		self.owner:SetFrameShowState(true, self.common_buttons, self.common_buttons_controls)
		self.textbox_jump:SetText("5")
		-- заполнение списка редактируемых точек
		for key, point in ipairs(self.tCustomPoints) do
			self.owner:AddSecondaryListItem(self.custom_list, string.format("%s; %s; %.1f, %.1f, %.1f", point.gvid or sNoValue, point.lvid or sNoValue, point.pos.x, point.pos.y, point.pos.z), point.name, key, self.color[0])
		end
	elseif location == "find_object" then
		-- подраздел "Поиск"
		self.owner:SetFrameShowState(true, self.find_object_frame, self.find_object_frame_controls)
		self.owner:SetFrameShowState(true, self.find_object_info, self.find_object_info_controls)
		self.owner:SetFrameShowState(true, self.find_object_buttons, self.find_object_buttons_controls)
		-- предзаполнение списка объектов
		self.owner:AddSecondaryListItem(self.find_object_list, game.translate_string("tool_teleport_filter"), nil, "null", self.color[0])
		self.find_object_list:Enable(false)
		self.info_location_text:TextControl():SetText(sNoValue)
		self.info_smart_text:TextControl():SetText(sNoValue)
	else
		-- подразделы локаций
		self.owner:SetFrameShowState(true, self.point_frame, self.point_frame_controls)
		self.owner:SetFrameShowState(true, self.common_buttons, self.common_buttons_controls)
		-- заполнение списка смартов
		self.owner:AddSecondaryListItem(self.point_list, game.translate_string("tool_teleport_smarts_caption"), nil, "null", self.color[1])
		for _, point in ipairs(self.tSmarts) do
			if point.location == location then
				self.owner:AddSecondaryListItem(self.point_list, point.id, point.name, point.id, self.color[0])
			end
		end
		-- заполнение списка произвольных точек
		self.owner:AddSecondaryListItem(self.point_list, "", nil, "null", self.color[1])
		self.owner:AddSecondaryListItem(self.point_list, game.translate_string("tool_teleport_points_caption"), nil, "null", self.color[1])
		for _, point in ipairs(self.tPoints) do
			if point.location == location then
				self.owner:AddSecondaryListItem(self.point_list, string.format("%d; %d; %.1f, %.1f, %.1f", point.gvid, point.lvid, point.pos.x, point.pos.y, point.pos.z), point.name, point.id, self.color[0])
			end
		end
	end
end

-- выбор локации
function teleport:OnLocationListItemClicked()
	--to_log(sModule..":> OnLocationListItemClicked start")

	local location = self.owner:GetListItemSelectedValue(self.location_list)
	if not location or location == "null" then return end --/>

	self:SetLocation(location)
end

-- кнопка Поиск (фильтр)
function teleport:OnBtnFind()
	--to_log(sModule..":> OnBtnFind start")
	self.find_object_list:ScrollToBegin()
	self.find_object_list:RemoveAll()

	self.tObjects = {}
	local iCntObjectsAdded, iCntObjectsAll, obj = 0, 0, nil
	local sFilter = self.owner_script.StringLowerRus(self.textbox_find:GetText():trim())
	--to_log(sModule..":> OnBtnFind filter=[%s]", sFilter)

	if sFilter:len() >= 3 then
		local bFindInBoxes = self.checkbox_boxes:GetCheck()
		local bFindAtCurrentLocation = self.checkbox_current_location:GetCheck()
		local bFindAtOtherLocations = self.checkbox_other_locations:GetCheck()
		local sCurrentLevelName = level.name()
		local gg = game_graph()
		for i = 1, 65535 do
			-- +UDP
			--obj = sim:object(i)
			obj = level.object_by_id(i)
			-- -UDP
			if obj then
				--if bFindInBoxes and obj.parent_id ~= 0 or obj.parent_id == 65535 then-- +UDP
				if bFindInBoxes and obj:parent() or not obj:parent() then-- +UDP
					-- ищем истинные локацию и координаты, если объект находится в контейнере
					local obj_location, obj_pos = nil, nil
					-- +UDP
					--if obj.parent_id ~= 65535 then
						-- -- объект в контейнере
						-- local parent_obj = sim:object(obj.parent_id)
						-- if parent_obj then -- если контейнер найден, берём его показатели
						-- 	obj_location = sim:level_name(gg:vertex(parent_obj.m_game_vertex_id):level_id())
						-- 	obj_pos = parent_obj.position
						-- end
					-- else
					-- 	-- объект не в контейнере
					-- 	obj_location = sim:level_name(gg:vertex(obj.m_game_vertex_id):level_id())
					-- 	obj_pos = obj.position
					obj_location = level.name()
					if obj:parent() then
						obj_pos = obj:parent():position()
					else
						obj_pos = obj:position()
					-- -UDP
					end
					if obj_location and (bFindAtCurrentLocation and sCurrentLevelName == obj_location or bFindAtOtherLocations and sCurrentLevelName ~= obj_location) then
						-- определяем имя объекта
						local obj_name, name = obj:name(), nil
						if ObjIsHuman(obj) then
							name = Get_CharName(obj)
						elseif ObjIsMonster(obj) then
							name = Get_MobClass(obj)
						elseif ObjIsOutfit(obj) or ObjIsWeapon(obj) or ObjIsAmmo(obj) or ObjIsDetector(obj) or ObjIsFood(obj) or ObjIsMedical(obj) or ObjIsArtefact(obj) then
							name = Get_InvName(obj:section())--obj:section_name())--+UDP
						end
						if name then
							name = game.translate_string(name)
							if string.find(self.owner_script.StringLowerRus(name), sFilter, 1, true) or string.find(self.owner_script.StringLowerRus(obj_name), sFilter, 1, true) then
								-- to_log(sModule..":> OnBtnFind check object name=[%s], obj_name=[%s], id=[%s]", tostring(name), obj_name, tostring(i))
								iCntObjectsAdded = iCntObjectsAdded + 1
								local item = { object_id = i, name1 = obj_name, name2 = name, location = obj_location, position = obj_pos }
								table.insert(self.tObjects, item)
							end
							iCntObjectsAll = iCntObjectsAll + 1
						end
					end
				end
			end
			-- больше 100 объектов не выводим
			if iCntObjectsAdded >= 100 then break end
		end
	end

	self.tObjects = self.owner_script.SortTableByValue(self.tObjects, "asc", "name1")

	for k,v in ipairs(self.tObjects) do
		self.owner:AddSecondaryListItem(self.find_object_list, v.name1, v.name2, k, self.color[0])
	end

	if self.find_object_list:GetSize() == 0 then
		self.owner:AddSecondaryListItem(self.find_object_list, game.translate_string(sFilter:len() >= 3 and "tool_teleport_empty" or "tool_teleport_filter"), nil, "null", self.color[0])
		self.find_object_list:Enable(false)
		self.info_location_text:TextControl():SetText(sNoValue)
		self.info_smart_text:TextControl():SetText(sNoValue)
	else
		self.find_object_list:Enable(true)
	end
	--to_log(sModule..":> OnBtnFind objects=[%d/%d]", iCntObjectsAdded, iCntObjectsAll)
end

-- кнопка Сброс (фильтр)
function teleport:OnBtnReset()
	--to_log(sModule..":> OnBtnReset start")
	self.textbox_find:SetText("")
	self:OnBtnFind()
end

-- выбор элемента списка объектов
function teleport:OnFindObjectListItemClicked()
	local item_id = self.owner:GetListItemSelectedValue(self.find_object_list)
	if not item_id or item_id == "null" then return end --/>

	local item = self.tObjects[tonumber(item_id)]
	--local obj = sim:object(item.object_id) -- ищем исходный объект -- +UDP
	local obj = level.object_by_id(item.object_id)-- +UDP
	if obj then
		self.info_location_text:TextControl():SetText(game.translate_string(item.location))
		-- поиск смарта, ближайшего к текущей позиции выбранного предмета
		local min_dist, smart_name = 100000000, nil
		for _,v in ipairs(self.tSmarts) do
			if item.location == v.location then
				local dist = item.position:distance_to_sqr(v.pos)
				if dist < min_dist then
					min_dist = dist
					smart_name = v.name
				end
			end
		end
		if smart_name then
			self.info_smart_text:TextControl():SetText(smart_name)
		else
			self.info_smart_text:TextControl():SetText(sNoValue)
		end
	else
		self.info_location_text:TextControl():SetText(sNoValue)
		self.info_smart_text:TextControl():SetText(sNoValue)
	end
end

-- двойной клик на элементе списка редактируемых точек
function teleport:OnCustomListMouseDblClicked()
	--to_log(sModule..":> OnCustomListMouseDblClicked start")
	self:OnBtnLoad()
end

-- очистка полей
function teleport:ClearFields(clear_all)
	--to_log(sModule..":> ClearFields start, clear_all=[%s]", tostring(clear_all))
	if clear_all then
		self.location_list:ScrollToBegin()
		self.location_list:RemoveAll()
	end
	self.custom_list:ScrollToBegin()
	self.custom_list:RemoveAll()
	self.find_object_list:ScrollToBegin()
	self.find_object_list:RemoveAll()
	self.info_location_text:TextControl():SetText("")
	self.info_smart_text:TextControl():SetText("")
	self.point_list:ScrollToBegin()
	self.point_list:RemoveAll()
	self.textbox_gv:SetText("")
	self.textbox_lv:SetText("")
	self.textbox_x:SetText("")
	self.textbox_y:SetText("")
	self.textbox_z:SetText("")
	self.checkbox_boxes:SetCheck(self.checkbox_boxes_default)
	self.checkbox_current_location:SetCheck(self.checkbox_current_location_default)
	self.checkbox_other_locations:SetCheck(self.checkbox_other_locations_default)
	self.textbox_find:SetText("")
end

-- скрытие полей
function teleport:HideFields(hide_all)
	--to_log(sModule..":> HideFields start")
	if hide_all then
		self.location_list:Show(false)
	end
	self.owner:SetFrameShowState(false, self.point_frame)
	self.owner:SetFrameShowState(false, self.find_object_frame)
	self.owner:SetFrameShowState(false, self.custom_frame)
	self.owner:SetFrameShowState(false, self.custom_frame_buttons)
	self.owner:SetFrameShowState(false, self.common_buttons)
	self.owner:SetFrameShowState(false, self.find_object_info)
	self.owner:SetFrameShowState(false, self.find_object_buttons)
	self:SetNameDialog(false)
end

-- двойной клик на элементе списка точек
function teleport:OnPointListMouseDblClicked()
	--to_log(sModule..":> OnPointListMouseDblClicked start")
	self:OnBtnGo()
end

-- двойной клик на элементе списка объектов
function teleport:OnFindObjectListMouseDblClicked()
	--to_log(sModule..":> OnFindObjectListMouseDblClicked start")
	self:OnBtnGo()
end

-- кнопка Перейти
function teleport:OnBtnGo()
	--to_log(sModule..":> OnBtnGo start")
	local location = self.owner:GetListItemSelectedValue(self.location_list, true) -- сфокусированный элемент в приоритете
	if not location or location == "null" then return end --/>

	if location == "custom" then
		-- телепорт по координатам
		local pos_x = tonumber(self.textbox_x:GetText())
		local pos_y = tonumber(self.textbox_y:GetText())
		local pos_z = tonumber(self.textbox_z:GetText())
		if not (pos_x and pos_y and pos_z) then return end --/>
		local gvid = tonumber(self.textbox_gv:GetText())
		local lvid = tonumber(self.textbox_lv:GetText())
		location = level.name()--location = gvid and sim:level_name(game_graph():vertex(gvid):level_id()) or level.name() -- +UDP
		self:MakeJump(location, gvid, lvid, vector():set(pos_x, pos_y, pos_z))
	elseif location == "find_object" then
		-- переход к объекту
		local item_id = self.owner:GetListItemSelectedValue(self.find_object_list)
		if not item_id or item_id == "null" then return end --/>

		local item = self.tObjects[tonumber(item_id)]
		-- +UDP
		-- local obj = sim:object(item.object_id) -- ищем исходный объект
		-- if obj and obj.parent_id ~= 65535 then obj = sim:object(obj.parent_id) or obj end -- если объект в контейнере, получаем контейнер
		-- if obj then -- если объект или контейнер найден, перемещаемся к нему
		-- 	local location = sim:level_name(game_graph():vertex(obj.m_game_vertex_id):level_id())
		-- 	self:MakeJump(location, obj.m_game_vertex_id, obj.m_level_vertex_id, obj.position)
		-- end
		self:MakeJump(location, 0, 0, item:position())
		-- -UDP
	else
		-- переход на смарты и сконфигурированные точки
		local point_id = self.owner:GetListItemSelectedValue(self.point_list)
		if not point_id or point_id == "null" then return end --/>

		local point, id = nil, tonumber(point_id)
		if id then
			-- тип точки - произвольная
			for _, item in ipairs(self.tPoints) do
				if item.id == id then
					point = item
					break
				end
			end
		else
			-- тип точки - смарт
			for _, item in ipairs(self.tSmarts) do
				if item.id == point_id then
					point = item
					break
				end
			end
		end
		if not point then return end --/>
		
		self:MakeJump(location, point.gvid, point.lvid, point.pos)
	end

	self.owner:OnQuit()
end

-- +UDP
function DisableFly()
	get_console():execute("g_no_clip off")
	keylogger.unbind_console_key("F6")
	keylogger.unbind_console_key("F7")
	keylogger.unbind_console_key("w")
	keylogger.unbind_console_key("s")
	keylogger.unbind_console_key("a")
	keylogger.unbind_console_key("d")
	keylogger.unbind_console_key("ESCAPE")
end

function teleport:OnBtnFly()

	if not getLocalActor() then return end
	if _G.tool_flying == true then
		DisableFly()
		_G.tool_flying = false
	else
		local value = 2
		
		get_console():execute("g_no_clip on")
		keylogger.bind_console_key("F6", function() get_console():execute("hud_draw off") end)
		keylogger.bind_console_key("F7", function() get_console():execute("hud_draw on") end)
		keylogger.bind_console_key("w", 
			function() 
				getLocalActor():set_actor_position(tool.MoveAtDirection(getLocalActor():position(), device().cam_dir, 0, value))
			end)
		keylogger.bind_console_key("s", 
			function() 
				getLocalActor():set_actor_position(tool.MoveAtDirection(getLocalActor():position(), device().cam_dir, 180, value))
			end)
		keylogger.bind_console_key("a", 
			function() 
				getLocalActor():set_actor_position(tool.MoveAtDirection(getLocalActor():position(), device().cam_dir, -90, value))
			end)
		keylogger.bind_console_key("d", 
			function() 
				getLocalActor():set_actor_position(tool.MoveAtDirection(getLocalActor():position(), device().cam_dir, 90, value))
			end)
		keylogger.bind_console_key("ESCAPE", DisableFly)
		_G.tool_flying = true
		
	end
	self.owner:OnQuit()
end

function teleport:OnCheckGamezone()
	local set = self.checkbox_gamezone:GetCheck()
	if not set and xr_conditions.__local_actor_alive == nil then
		xr_conditions.__local_actor_alive = xr_conditions.local_actor_alive
		xr_conditions.local_actor_alive = function(actor, npc) return false end
	elseif xr_conditions.__local_actor_alive ~= nil then
		xr_conditions.local_actor_alive = xr_conditions.__local_actor_alive
		xr_conditions.__local_actor_alive = nil
	end
end

function teleport:OnCheckInvulnerable()
	local set = self.checkbox_invulnerable:GetCheck()
	rc.cl_set_invulnerable(LocalActor(), set)
end
-- -UDP

-- кнопка Сохранить
function teleport:OnBtnSave()
	--to_log(sModule..":> OnBtnSave start")
	if self.dlg_name_frame:IsShown() then return end

	local pos_x = tonumber(self.textbox_x:GetText())
	local pos_y = tonumber(self.textbox_y:GetText())
	local pos_z = tonumber(self.textbox_z:GetText())
	if not (pos_x and pos_y and pos_z) then return end --/>

	self.textbox_name:SetText(string.format("%s - ", game.translate_string(level.name())))

	self:SetNameDialog(true)
end

-- кнопка диалога Сохранить
function teleport:OnBtnNameOk()
	--to_log(sModule..":> OnBtnNameOk start")
	if self.dlg_name_frame:IsShown() then
		self:SetNameDialog(false)
	end

	local name = self.textbox_name:GetText():trim()
	if not name then return end --/>

	local pos_x = tonumber(self.textbox_x:GetText())
	local pos_y = tonumber(self.textbox_y:GetText())
	local pos_z = tonumber(self.textbox_z:GetText())
	if not (pos_x and pos_y and pos_z) then return end --/>

	local point = {
		location = level.name(),
		name = name,
		pos = vector():set(pos_x, pos_y, pos_z),
		lvid = tonumber(self.textbox_lv:GetText()),
		gvid = tonumber(self.textbox_gv:GetText())
	}
	table.insert(self.tCustomPoints, point)

	self.tCustomPoints = self.owner_script.SortTableByValue(self.tCustomPoints, "asc", "name")

	self:SaveCustomPoints()
	self:SetLocation("custom")
end

-- кнопка Загрузить
function teleport:OnBtnLoad()
	--to_log(sModule..":> OnBtnLoad start")

	local point_id = self.owner:GetListItemSelectedValue(self.custom_list)
	if not point_id or point_id == "null" then return end --/>

	local id = tonumber(point_id)
	local point = id and self.tCustomPoints[id] or nil
	if not point then return end --/>

	self.textbox_gv:SetText(point.gvid and tostring(point.gvid) or "")
	self.textbox_lv:SetText(point.lvid and tostring(point.lvid) or "")
	self.textbox_x:SetText(string.format("%.3f", point.pos.x))
	self.textbox_y:SetText(string.format("%.3f", point.pos.y))
	self.textbox_z:SetText(string.format("%.3f", point.pos.z))
end

-- кнопка Удалить
function teleport:OnBtnDelete()
	--to_log(sModule..":> OnBtnDelete start")

	local point_id = self.owner:GetListItemSelectedValue(self.custom_list)
	if not point_id or point_id == "null" then return end --/>

	local id = tonumber(point_id)
	for k, item in ipairs(self.tCustomPoints) do
		if k == id then
			table.remove(self.tCustomPoints, k)
			self.tCustomPoints = self.owner_script.SortTableByValue(self.tCustomPoints, "asc", "name")
			self:SaveCustomPoints()
			self:SetLocation("custom")
			break
		end
	end
end

-- кнопка Центрировать на игроке
function teleport:OnBtnCurrent()
	--to_log(sModule..":> OnBtnCurrent start")
	-- +UDP
	-- self.textbox_gv:SetText(string.format("%d", db.actor:game_vertex_id()))
	-- self.textbox_lv:SetText(string.format("%d", db.actor:level_vertex_id()))
	-- local pos = db.actor:position()
	self.textbox_gv:SetText(string.format("%d", (getLocalActor() or db.actor):game_vertex_id()))
	self.textbox_lv:SetText(string.format("%d", (getLocalActor() or db.actor):level_vertex_id()))
	local pos = (getLocalActor() or db.actor):position()
	-- -UDP
	self.textbox_x:SetText(string.format("%.3f", pos.x))
	self.textbox_y:SetText(string.format("%.3f", pos.y))
	self.textbox_z:SetText(string.format("%.3f", pos.z))
end

-- кнопка диалога Отменить
function teleport:OnBtnNameCancel()
	--to_log(sModule..":> OnBtnNameCancel start")
	if self.dlg_name_frame:IsShown() then
		self:SetNameDialog(false)
	end
end

-- переход на выбранную точку
function teleport:MakeJump(sMap, idGv, idLv, pos)
	to_log(sModule..":> MakeJump start sMap=[%s], gv=[%d], lv=[%d], pos=[%s]", sMap, idGv, idLv, string.format("%.3f, %.3f, %.3f", pos.x, pos.y, pos.z))
	if not pos then return end --/>

	if not sMap or sMap == level.name() then
		-- перемещение в пределах текущей локации
		-- +UDP
		-- db.actor:set_actor_position(pos)
		(getLocalActor() or db.actor):set_actor_position(pos)
		-- -UDP
		return --/>
	end

	if not (idGv and idLv) then return end --/>

	-- перемещение на другую локацию
	-- +UDP
	-- local sobj = alife():create("level_changer", db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id())
	-- local pk = get_netpk(sobj)
	-- local data = pk:get()
	-- data.shapes:addSphere(3)
	-- data.dest_game_vertex_id = idGv
	-- data.dest_level_vertex_id = idLv
	-- data.dest_position = pos
	-- data.dest_level_name = sMap
	-- data.silent_mode = 1
	-- pk:set(data)

	-- -- самоудаление точки перехода при срабатывании
	-- xr_s.register_callback("actor_save", function() alife():release(sobj, true) end)
	-- -UDP
end

-- кнопка Прыжок плюс
function teleport:OnBtnJumpPlus()
	--to_log(sModule..":> OnBtnJumpPlus start")
	local value = tonumber(self.textbox_jump:GetText()) or 1
	if math.ceil(value) > value then value = math.ceil(value) else value = value + 1 end
	if value > 9999 then value = 9999 end
	self.textbox_jump:SetText(string.format("%d", value))
end

-- кнопка Прыжок минус
function teleport:OnBtnJumpMinus()
	--to_log(sModule..":> OnBtnJumpMinus start")
	local value = tonumber(self.textbox_jump:GetText()) or 1
	if math.floor(value) < value then value = math.floor(value) else value = value - 1 end
	if value < 1 then value = 1 end
	self.textbox_jump:SetText(string.format("%d", value))
end

-- кнопка Прыжок влево
function teleport:OnBtnJumpLeft()
	--to_log(sModule..":> OnBtnJumpLeft start")
	local value = tonumber(self.textbox_jump:GetText())
	if not value then return end --/>
	-- +UDP
	-- db.actor:set_actor_position(self.owner_script.MoveAtDirection(db.actor:position(), db.actor:direction(), -90, value))
	local actor = getLocalActor() or db.actor
	actor:set_actor_position(self.owner_script.MoveAtDirection(actor:position(), actor:direction(), -90, value))
	-- -UDP	
end

