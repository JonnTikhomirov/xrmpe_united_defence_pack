--------------------------------------------------------------------------------
---rc.script--------------------------------------------------------------------
-- Remote commands - RPC-слой для команд клиент-сервер--------------------------
-- Made by JohnTikhomirov ------------------------------------------------------
-- 31.01.26 --------------------------------------------------------------------
--------------------------------------------------------------------------------


local RC_COMMANDS = {}
local RC_ADMIN_KEYS = {}
local WRITTERS = {
	bool = function(packet, value)
		packet:w_bool(value)
	end,
	u8 = function(packet, value)
		packet:w_u8(value)
	end,
	u16 = function(packet, value)
		packet:w_u16(value)
	end,
	u32 = function(packet, value)
		packet:w_u32(value)
	end,
	s8 = function(packet, value)
		packet:w_s8(value)
	end,
	s16 = function(packet, value)
		packet:w_s16(value)
	end,
	s32 = function(packet, value)
		packet:w_s32(value)
	end,
	float = function(packet, value)
		packet:w_float(value)
	end,
	vec3 = function(packet, value)
		packet:w_vec3(value)
	end,
	stringZ = function(packet, value)
		packet:w_stringZ(value)
	end
}
local READERS = {
	bool = function(packet)
		return packet:r_bool()
	end,
	u8 = function(packet)
		return packet:r_u8()
	end,
	u16 = function(packet)
		return packet:r_u16()
	end,
	u32 = function(packet)
		return packet:r_u32()
	end,
	s8 = function(packet)
		return packet:r_s8()
	end,
	s16 = function(packet)
		return packet:r_s16()
	end,
	s32 = function(packet)
		return packet:r_s32()
	end,
	float = function(packet)
		return packet:r_float()
	end,
	vec3 = function(packet)
		return packet:r_vec3()
	end,
	stringZ = function(packet)
		return packet:r_stringZ()
	end
}
local RC_PENDING = {}
local RC_REQUEST_SEQ = 0
local RC_RANDOM_SEEDED = false

local RC_CALL_MAGIC  = "__RC_CALL__"
local RC_RESP_MAGIC  = "__RC_RESP__"

local RC_STATUS_OK     = 0
local RC_STATUS_ERROR  = 1
local RC_STATUS_DENIED = 2

function init()
	local fname = getFS():update_path("$app_data_root$", "radmins.ltx")
	if fname and getFS():exist(fname) then
		file = io.open(fname)
		local str = file:read("*a")
		file:close()
		local data = lua_helper.fParse_CustomData(str)
		if data.rcadmins then
			for k, v in pairs(data.rcadmins) do
				if v == "<<no_value>>" then
					RC_ADMIN_KEYS[k] = true
				else
					RC_ADMIN_KEYS[string.lower(k)] = string.toboolean(v or "true")
				end
			end
		else
			to_log("RC.init: section 'rcadmins' not found in 'radmins.ltx'")
		end
	elseif not OnClient() then
		to_log("RC.init: 'radmins.ltx' not found")
	end
	to_log("RC.init: success")
end

local ok, err = pcall(init)
if not ok then
	to_log("RC.init: error '%s'", err)
end

local function command_key(meta, args_values)
	local acc = meta.name
	
	if(meta.args) then
		local args_acc = ""
		for _, a in ipairs(meta.args) do
			if(args_acc ~= "") then
				args_acc = args_acc .. ","
			end
			args_acc = args_acc .. a.name .. ":" .. a.type
			if args_values and args_values[a.name] then
				args_acc = args_acc .. string.exformat("='%s'", args_values[a.name])
			end
		end
		acc = acc.."("..args_acc..")"
	end

	return acc
end

local function write_args(packet, args_meta, args_values)
	-- args_meta: array of {name=..., type=...}
	-- args_values: table { name = value, ... }
	for _, a in ipairs(args_meta) do
		local val = args_values[a.name]
		if val == nil then
			-- если аргумент обязательный — отказ
			return false, string.format("missing arg '%s'", a.name)
		end

		local writer = WRITTERS[a.type]
		if not writer then
			return false, string.format("writer for type '%s' not found", a.type)
		end

		-- записываем значение
		writer(packet, val)
	end
	return true
end

local function read_args(packet, args_meta)
	local ctx = {}
	for _, a in ipairs(args_meta) do
		ctx[a.name] = READERS[a.type](packet)
	end
	return ctx
end

-------------------------------------------------------------------------------
-- Значения по умолчанию для возвращаемых полей
-------------------------------------------------------------------------------
local function default_ret_value(tp)
	if tp == "bool" then
		return false
	elseif tp == "stringZ" then
		return ""
	elseif tp == "vec3" then
		if vector then
			return vector(0, 0, 0)
		end
		return { x = 0, y = 0, z = 0 }
	end

	return 0
end

-------------------------------------------------------------------------------
-- Запись/чтение возвращаемого результата
-------------------------------------------------------------------------------
local function write_ret_values(packet, ret_meta, values)
	values = values or {}

	for _, r in ipairs(ret_meta or {}) do
		local val = values[r.name]

		if val == nil then
			val = default_ret_value(r.type)
		end

		local writer = WRITTERS[r.type]
		if not writer then
			error(string.format("writer for return type '%s' not found", r.type))
		end

		writer(packet, val)
	end
end

local function read_ret_values(packet, ret_meta)
	local values = {}

	for _, r in ipairs(ret_meta or {}) do
		local reader = READERS[r.type]
		if not reader then
			error(string.format("reader for return type '%s' not found", r.type))
		end

		values[r.name] = reader(packet)
	end

	return values
end

local function register(def)
	-- детерминированный ID
	local id = command_key(def)

	if RC_COMMANDS[id] then
		to_log(lua_fix.fmt2str("RC.register: collision (overrided) '%s', id: %s", def.name, id))
	end

	RC_COMMANDS[id] = def

	return id
end

-- ================= SERVER =================

-------------------------------------------------------------------------------
-- Транспорт.
-- ВАЖНО: это место нужно адаптировать под твой мод/API.
-- На сервере должен быть способ создать пакет и отправить его клиенту.
-------------------------------------------------------------------------------
local function rc_generate_packet(msg_type)
	if not msg_type then
		to_log("RC.rc_generate_packet: msg_type is nil")
		return nil
	end

	if not game_cl or not game_cl.GenerateGameMessage then
		to_log("RC.rc_generate_packet: game_cl.GenerateGameMessage not found")
		return nil
	end

	return game_cl.GenerateGameMessage(msg_type)
end

local function rc_send_response_packet(packet, game_id)
	if not game_id or game_id == 0 then
		to_log("RC.rc_send_response_packet: target gameID is 0")
		return
	end

	u_EventSendToReliable(packet, game_id)
end

-------------------------------------------------------------------------------
-- Серверная отправка ответа
-------------------------------------------------------------------------------
local function sv_send_response(token, command_id, status, ret_meta, result_or_error, client_id)
	local packet = rc_generate_packet(GM_REMOTE_COMMAND_RESPONSE)
	if not packet then
		to_log("RC.sv_send_response: cannot generate response packet")
		return
	end

	packet:w_stringZ(RC_RESP_MAGIC)
	packet:w_stringZ(tostring(token or ""))
	packet:w_stringZ(tostring(command_id or ""))
	packet:w_u8(status)

	if status == RC_STATUS_OK then
		local ok, err = pcall(write_ret_values, packet, ret_meta, result_or_error)
		if not ok then
			to_log("RC.sv_send_response: failed to write result: %s", tostring(err))
			return
		end
	else
		packet:w_stringZ(tostring(result_or_error or ""))
	end

	rc_send_response_packet(packet, client_id)
end

local function sv_read_auth(packet)
	local key = packet:r_stringZ() or ""

	local access = RC_ADMIN_KEYS[key]
	if access == nil then
		access = RC_ADMIN_KEYS[string.lower(key)]
	end

	if access == true then
		return true, nil, key
	elseif access == false then
		return false, string.exformat("access denied, blocked key '%s'", key), key
	else
		return false, string.exformat("access denied, key '%s'", key), key
	end
end

-- Совместимость со старым sv_handle_batch
local function sv_authorize(packet)
	local ok, msg = sv_read_auth(packet)

	if ok then
		return true
	end

	return msg
end

function sv_handle(packet, client_id)
	if not OnServer() then
		return
	end

	local auth_ok, auth_msg, key = sv_read_auth(packet)
	local id = packet:r_stringZ()

	---------------------------------------------------------------------------
	-- Новый формат: вызов команды с возвратом результата
	--
	-- Формат запроса:
	-- key:stringZ
	-- RC_CALL_MAGIC:stringZ
	-- token:stringZ
	-- gameID:u16
	-- command_id:stringZ
	-- args...
	---------------------------------------------------------------------------
	if id == RC_CALL_MAGIC then
		local token = packet:r_stringZ() or ""
		local requested_game_id = packet:r_u16()
		local command_id = packet:r_stringZ()

		if not command_id then
			to_log("RC.sv_handle: call request without command id")
			return
		end

		local target_game_id = requested_game_id

		if client_id then
			client_id = tonumber(client_id)

			if client_id and client_id ~= 0 then
				target_game_id = client_id
			end
		end

		local command = RC_COMMANDS[command_id]

		if not command then
			sv_send_response(
				token,
				command_id,
				RC_STATUS_ERROR,
				nil,
				"unknown command",
				target_game_id
			)
			return
		end

		if not command.sv_handler then
			sv_send_response(
				token,
				command_id,
				RC_STATUS_ERROR,
				nil,
				"command has no sv_handler",
				target_game_id
			)
			return
		end

		if not command.ret then
			sv_send_response(
				token,
				command_id,
				RC_STATUS_ERROR,
				nil,
				"command has no return schema",
				target_game_id
			)
			return
		end

		if not command.allow_unauthorized and not auth_ok then
			sv_send_response(
				token,
				command_id,
				RC_STATUS_DENIED,
				nil,
				auth_msg or "access denied",
				target_game_id
			)
			return
		end

		local ok, args_or_err = pcall(read_args, packet, command.args or {})
		if not ok then
			sv_send_response(
				token,
				command_id,
				RC_STATUS_ERROR,
				nil,
				tostring(args_or_err),
				target_game_id
			)
			return
		end

		local ctx = {
			key = key,
			authorized = auth_ok,
			auth_message = auth_msg,
			game_id = target_game_id,
			client_id = target_game_id,
			token = token,
		}

		local ok2, result_or_err = pcall(command.sv_handler, args_or_err, ctx)
		if not ok2 then
			sv_send_response(
				token,
				command_id,
				RC_STATUS_ERROR,
				nil,
				tostring(result_or_err),
				target_game_id
			)
			return
		end

		if type(result_or_err) ~= "table" then
			if command.ret and command.ret[1] then
				result_or_err = {
					[command.ret[1].name] = result_or_err
				}
			else
				result_or_err = {}
			end
		end

		sv_send_response(
			token,
			command_id,
			RC_STATUS_OK,
			command.ret,
			result_or_err,
			target_game_id
		)

		return
	end

	---------------------------------------------------------------------------
	-- Старый формат одиночной команды
	---------------------------------------------------------------------------
	if not auth_ok then
		to_log("RC.sv_handle: %s, command: %s", tostring(auth_msg), id)
		return
	end

	local command = RC_COMMANDS[id]

	if not command then
		to_log("RC.sv_handle: unknown command: %s", id)
		return
	end

	if not command.sv_handler then
		to_log("RC.sv_handle: handlers not found, command: %s", id)
		return
	end

	if not command.args then
		to_log("RC.sv_handle: args not defined, command: %s", id)
		return
	end

	local ok, args_or_err = pcall(read_args, packet, command.args)
	if not ok then
		to_log(
			"RC.sv_handle: read args failed, command: %s, error: %s",
			id,
			tostring(args_or_err)
		)
		return
	end

	local ok2, err = pcall(command.sv_handler, args_or_err)
	if not ok2 then
		to_log(
			"RC.sv_handle: command %s failed: %s",
			id,
			tostring(err)
		)
	else
		to_log("RC.sv_handle: handler '%s' executed", id)
	end
end

function sv_handle_batch(packet)
	if not OnServer() then return end

	local auth = sv_authorize(packet)
	if type(auth) == "string" then
		to_log("RC.sv_handle_batch: auth failed: %s", tostring(auth))
		return
	end

	local count = packet:r_u8()
	if type(count) ~= "number" or count <= 0 then
		to_log("RC.sv_handle_batch: invalid count: %s", tostring(count))
		return
	end

	for i = 1, count do
		local id = packet:r_stringZ()
		if not id then
			to_log("RC.sv_handle_batch: missing id at index %d", i)
			return
		end

		local meta = RC_COMMANDS[id]
		if not meta then
			to_log("RC.sv_handle_batch: unknown command '%s' at index %d", tostring(id), i)
			-- пропускаем чтение аргументов: чтобы не ломать поток, нужно знать схему.
			-- так как схемы нет — безопаснее прекратить обработку батча
			return
		end

		if not meta.args then
			to_log("RC.sv_handle_batch: command '%s' has no args definition at index %d", id, i)
			return
		end

		-- читаем аргументы (read_args может бросить ошибку)
		local ok, args_or_err = pcall(read_args, packet, meta.args)
		if not ok then
			to_log("RC.sv_handle_batch: failed to read args for '%s' at index %d: %s", id, i, tostring(args_or_err))
			return
		end

		-- вызываем handler
		if not meta.sv_handler then
			to_log("RC.sv_handle_batch: no sv_handler for '%s' at index %d", id, i)
			return
		end

		local ok2, err = pcall(meta.sv_handler, args_or_err)
		if not ok2 then
			to_log("RC.sv_handle_batch: handler '%s' failed at index %d: %s", id, i, tostring(err))
			-- по умолчанию продолжаем обрабатывать дальше; если хочешь атомарности — return тут
		else
			to_log("RC.sv_handle_batch: handler '%s' executed at index %d", id, i)
		end
	end
end

-- ================= CLIENT =================

-------------------------------------------------------------------------------
-- Токен запроса. Нужен, чтобы клиент понял, на какой именно вызов пришёл ответ.
-- Особенно важно, если сервер шлёт ответ не адресно, а всем клиентам.
-------------------------------------------------------------------------------
local function cl_next_request_token()
	RC_REQUEST_SEQ = RC_REQUEST_SEQ + 1

	local t = time_global and time_global() or os.clock()

	if not RC_RANDOM_SEEDED then
		math.randomseed(tonumber(t) or 0)
		RC_RANDOM_SEEDED = true
	end

	return string.format(
		"rc_%d_%s_%d",
		RC_REQUEST_SEQ,
		tostring(t),
		math.random(1000000, 9999999)
	)
end

local function cl_make_packet(id)
	local key = get_console():get_string("cdkey")
	if not key or key == "" then
		for k, v in pairs(RC_ADMIN_KEYS) do
			if k ~= "" and v == true then
				key = k
				break
			end
		end
	end
	if not key or key == "" then
		to_log("RC.cl_make_packet: no admin key, command: %s", id)
		return nil
	end

	local packet = game_cl.GenerateGameMessage(GM_REMOTE_COMMAND)
	packet:w_stringZ(key)
	packet:w_stringZ(id)
	return packet
end

local function cl_send(id, args)
	if not id then
		to_log("RC.cl_send: error: no command id")
		return
	end
	local command = RC_COMMANDS[id]
	if not command then
		to_log("RC.cl_send: error: command not found, id: %s", id)
		return
	end

	local packet = cl_make_packet(id)
	if not packet then return end

	if not args then
		args = {}
	end

	for _, a in ipairs(command.args) do
		WRITTERS[a.type](packet, args[a.name])
	end
	
	if(skip) then
		to_log("RC.cl_send: skip command, id: %s", id)
		return
	end

	u_EventSendReliable(packet)
	to_log("RC.cl_send: sended: %s", command_key(command, args))
end

-- CLIENT: отправка батча
-- commands_array = {
--   { id = RC_SET_TIME, args = { hour = 12, minute = 30 } },
--   { id = RC_SET_SURGE, args = { state = 1, skip_message = false } },
--   ...
-- }
function cl_send_batch(commands_array)
	if not commands_array or #commands_array == 0 then
		to_log("RC.cl_send_batch: nothing to send")
		return false
	end

	-- выбираем ключ
	local key = get_console():get_string("cdkey")
	if not key or key == "" then
		for k, v in pairs(RC_ADMIN_KEYS) do
			if k ~= "" and v == true then
				key = k
				break
			end
		end
	end
	if not key or key == "" then
		to_log("RC.cl_send_batch: no admin key")
		return false
	end

	local packet = game_cl.GenerateGameMessage(GM_REMOTE_COMMAND_BATCH)
	packet:w_stringZ(key)

	-- ограничение: не больше 255 команд в одном пакете
	if #commands_array > 255 then
		to_log("RC.cl_send_batch: too many commands (%d)", #commands_array)
		return false
	end

	packet:w_u8(#commands_array)

	-- сериализация каждой команды
	for i, cmd in ipairs(commands_array) do
		if not cmd or not cmd.id then
			to_log("RC.cl_send_batch: invalid command at index %d", i)
			return false
		end
		local meta = RC_COMMANDS[cmd.id]
		if not meta then
			to_log("RC.cl_send_batch: unknown command id '%s' at index %d", tostring(cmd.id), i)
			return false
		end

		packet:w_stringZ(cmd.id) -- у тебя id — строка
		local args_table = cmd.args or {}

		-- записываем args (используем write_args)
		local ok, err = write_args(packet, meta.args or {}, args_table)
		if not ok then
			to_log("RC.cl_send_batch: serialize failed for '%s' index %d: %s", cmd.id, i, tostring(err))
			return false
		end
	end

	u_EventSendReliable(packet)
	to_log("RC.cl_send_batch: sent %d commands", #commands_array)
	return true
end

--------------------------------------------------------------------------------
-- CLIENT: callable RPC
--------------------------------------------------------------------------------

local function cl_make_call_packet(require_key)
	local key = get_console():get_string("cdkey") or ""

	-- Если cdkey пустой, пробуем взять локальный админ-ключ,
	-- как это делает текущий cl_make_packet.
	if key == "" then
		for k, v in pairs(RC_ADMIN_KEYS) do
			if k ~= "" and v == true then
				key = k
				break
			end
		end
	end

	if require_key and key == "" then
		return nil, "no admin key"
	end

	local packet = game_cl.GenerateGameMessage(GM_REMOTE_COMMAND)

	packet:w_stringZ(key)
	packet:w_stringZ(RC_CALL_MAGIC)

	return packet
end

-------------------------------------------------------------------------------
-- cl_call(command_id, args, callback)
--
-- callback(ok, values, err, status)
--
-- ok:
--   true  -- сервер ответил успешно
--   false -- ошибка сети/отправки/обработки
--
-- values:
--   таблица возвращаемых полей команды
--
-- err:
--   текст ошибки
--
-- status:
--   RC_STATUS_OK / RC_STATUS_ERROR / RC_STATUS_DENIED
-------------------------------------------------------------------------------
function cl_call(command_id, args, callback)
	if not command_id then
		to_log("RC.cl_call: error: no command id")
		return nil
	end

	local command = RC_COMMANDS[command_id]
	if not command then
		to_log("RC.cl_call: error: command not found, id: %s", tostring(command_id))
		return nil
	end

	if not command.ret then
		to_log("RC.cl_call: error: command is not callable, id: %s", tostring(command_id))
		return nil
	end

	local token = cl_next_request_token()

	local packet, packet_err = cl_make_call_packet(not command.allow_unauthorized)
	if not packet then
		to_log("RC.cl_call: cannot make packet: %s", tostring(packet_err))

		if callback then
			callback(false, nil, packet_err, RC_STATUS_ERROR)
		end

		return nil
	end

	local local_game_id = LocalActor()

	if local_game_id == 0 then
		to_log("RC.cl_call: warning: local gameID is 0, server may not be able to reply")
	end

	packet:w_stringZ(token)
	packet:w_u16(local_game_id)
	packet:w_stringZ(command_id)

	local ok, err = write_args(packet, command.args or {}, args or {})
	if not ok then
		to_log("RC.cl_call: serialize failed: %s", tostring(err))

		if callback then
			callback(false, nil, err, RC_STATUS_ERROR)
		end

		return nil
	end

	RC_PENDING[token] = {
		command_id = command_id,
		callback = callback,
	}

	u_EventSendReliable(packet)

	to_log("RC.cl_call: sent callable command: %s", command_key(command, args))

	return token
end

-------------------------------------------------------------------------------
-- CLIENT: обработка ответа от сервера
--
-- Эту функцию нужно вызывать из клиентского обработчика того сообщения,
-- которое указано в GM_REMOTE_COMMAND_RESPONSE.
-------------------------------------------------------------------------------
function cl_handle(packet)
	if not OnClient() then
		return
	end

	local magic = packet:r_stringZ()
	if magic ~= RC_RESP_MAGIC then
		return
	end

	local token = packet:r_stringZ()
	local command_id = packet:r_stringZ()
	local status = packet:r_u8()

	local pending = RC_PENDING[token]
	if not pending then
		return
	end

	RC_PENDING[token] = nil

	if pending.command_id ~= command_id then
		return
	end

	local command = RC_COMMANDS[command_id]
	if not command then
		return
	end

	if status == RC_STATUS_OK then
		local ok, values_or_err = pcall(read_ret_values, packet, command.ret or {})

		if ok then
			if pending.callback then
				pending.callback(true, values_or_err, nil, status)
			end
		else
			if pending.callback then
				pending.callback(false, nil, tostring(values_or_err), RC_STATUS_ERROR)
			end
		end
	else
		local msg = packet:r_stringZ()

		if pending.callback then
			pending.callback(false, nil, msg, status)
		end
	end
end

-- ================= COMMANDS =================

RC_CHECK_AUTH = register {
	name = "check_auth",

	-- Разрешаем серверу выполнить эту команду даже если ключ не прошёл.
	-- Иначе сервер просто отбросил бы пакет до выполнения команды.
	allow_unauthorized = true,

	args = {},

	ret = {
		{ name = "authorized", type = "bool" },
		{ name = "message",    type = "stringZ" },
	},

	sv_handler = function(args, ctx)
		ctx = ctx or {}

		return {
			authorized = ctx.authorized == true,
			message = ctx.authorized and "authorized" or (ctx.auth_message or "access denied"),
		}
	end,
}

-------------------------------------------------------------------------------
-- Удобная клиентская обёртка
--
-- callback(authorized, message, values, status)
-------------------------------------------------------------------------------
function cl_check_auth(callback)
	return cl_call(RC_CHECK_AUTH, {}, function(ok, values, err, status)
		local authorized = ok and values and values.authorized or false
		local message = (values and values.message) or err or ""

		if callback then
			callback(authorized, message, values, status)
		end
	end)
end

RC_SET_ENVTIME = register {
	name = "set_envtime",
	args = {
		{ name = "hour", type = "u8" },
		{ name = "minute", type = "u8" }
	},
	sv_handler = function(args)
		get_console():execute(string.format("sv_setenvtime %d:%d", args.hour, args.minute))
	end
}
function cl_set_envtime(hour, minute)
	cl_send(RC_SET_ENVTIME, {hour = hour, minute = minute})
end

RC_SET_SURGE = register {
	name = "set_surge",
	args = {
		{ name = "state", type = "u8" },
		{ name = "skip_message", type = "bool" }
	},
	sv_handler = function(args)
		if args.state == 0 then
			surge_manager.stop_surge()
		elseif args.state == 1 then
			disable_info("SURGE_NOT_ALLOWED")
			surge_manager.start_surge()
		elseif args.state == 2 then
			surge_manager.skip_surge(args.skip_message)
		end
	end
}
function cl_set_surge(state, skip_message)
	cl_send(RC_SET_SURGE, {state = state, skip_message = skip_message})
end

RC_SET_WEATHER = register{
	name = "SET_WEATHER",
	args = {
		{ name = "section", type = "stringZ" },
		{ name = "is_fx", type = "bool" },
		{ name = "set_now", type = "bool" }
	},
	sv_handler = function(args)
		level_weathers.get_weather_manager().last_hour = level.get_time_hours()
		if args.is_fx then
			level.set_weather_fx(args.section)
		else
			level.set_weather(args.section, args.set_now)
		end
	end,
}
function cl_set_weather(section, is_fx, set_now)
	cl_send(RC_SET_WEATHER, {section = section, is_fx = is_fx, set_now = set_now})
end

RC_FIX_WEATHER = register{
	name = "FIX_WEATHER",
	args = {
		{ name = "is_fixed", type = "bool" }
	},
	sv_handler = function(args)
		local manager = level_weathers.get_weather_manager()
		if args.is_fixed then
			manager.select_weather = function (self, now) return end
		else
			manager.select_weather = level_weathers.WeatherManager.select_weather
		end
	end,
}
function cl_fix_weather(is_fixed)
	if is_fixed == nil then
		is_fixed = true
	end
	cl_send(RC_FIX_WEATHER, {is_fixed = is_fixed})
end

RC_SPAWN = register{
	name = "SPAWN",
	args = {
		{ name = "section", type = "stringZ" },
		{ name = "pos", type = "vec3" },
		{ name = "lvid", type = "u32" },
		{ name = "gvid", type = "u32" },
		{ name = "npc_id", type = "u32" },
		{ name = "count", type = "u16" },
	},
	sv_handler = function(args)
		for i = 1,args.count,1 do
			if args.npc_id == 0 then
				alife():create(args.section, args.pos, args.lvid, args.gvid)
			else
				alife():create(args.section, args.pos, args.lvid, args.gvid, args.npc_id)
			end
		end
	end,
}
function cl_spawn(section, pos, lvid, gvid, npc_id, count)
	if npc_id == nil then
		npc_id = 0
	end
	if count == nil then
		count = 1
	end
	cl_send(RC_SPAWN, {section = section, pos = pos, lvid = lvid, gvid = gvid, npc_id = npc_id, count = count})
end

RC_SPAWN_AMMO = register{
	name = "SPAWN_AMMO",
	args = {
		{ name = "section", type = "stringZ" },
		{ name = "pos", type = "vec3" },
		{ name = "lvid", type = "u32" },
		{ name = "gvid", type = "u32" },
		{ name = "npc_id", type = "u32" },
		{ name = "count", type = "u16" },
	},
	sv_handler = function(args)
		create_ammo(args.section, args.pos, args.lvid, args.gvid, args.npc_id, args.count)
	end,
}
function cl_spawn_ammo(section, pos, lvid, gvid, npc_id, count)
	if npc_id == nil then
		npc_id = 0
	end
	if count == nil then
		count = 1
	end
	cl_send(RC_SPAWN_AMMO, {section = section, pos = pos, lvid = lvid, gvid = gvid, npc_id = npc_id, count = count})
end

RC_ADD_ENVTIME = register {
	name = "add_envtime",
	args = {
		{ name = "hours", type = "u8" },
		{ name = "minutes", type = "u8" }
	},
	sv_handler = function(args)
		local hour = level.get_time_hours() + args.hours
		local minute = level.get_time_minutes() + args.minutes
		if hour > 23 then hour = 0 end
		if minute > 59 then
			minute = 0
			hour = hour+1
		end
		get_console():execute(string.format("sv_setenvtime %d:%d", hour, minute))
	end
}
function cl_add_envtime(hours, minutes)
	cl_send(RC_ADD_ENVTIME, {hours = hours, minutes = minutes})
end