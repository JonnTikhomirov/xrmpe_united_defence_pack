function inc_surges_counter(id)
	check_for_statistic_table(id)
	actor_statistic[id].surges = actor_statistic[id].surges + 1
end
function inc_completed_quests_counter(id)
	check_for_statistic_table(id)
	actor_statistic[id].completed_quests = actor_statistic[id].completed_quests + 1
end
function inc_killed_monsters_counter(id)
	check_for_statistic_table(id)
	actor_statistic[id].killed_monsters = actor_statistic[id].killed_monsters + 1
end
function inc_killed_stalkers_counter(id)
	check_for_statistic_table(id)
	actor_statistic[id].killed_stalkers = actor_statistic[id].killed_stalkers + 1
end
function inc_founded_artefacts_counter(art_id, actor_id)
	check_for_statistic_table(actor_id)
	
	if(taken_artefacts[art_id]==nil) then
		if OnServer() or (getLocalActor():id() and actor_id == getLocalActor():id()) then
			actor_statistic[actor_id].artefacts_founded = actor_statistic[actor_id].artefacts_founded + 1
		end
		taken_artefacts[art_id] = art_id
		local cl_art = level.object_by_id(art_id)
		if(cl_art and cl_art:section()) then
			artefacts_table[cl_art:section()] = true
		end
	end
end
function inc_founded_secrets_counter(id)
	check_for_statistic_table(id)
	actor_statistic[id].founded_secrets = actor_statistic[id].founded_secrets + 1
end

function set_best_monster(obj, actor_id)
	if IsStalker(obj) then
--		actor_statistic.best_monster = "stalker"
	else
		local community = monster_classes[get_clsid(obj)]
		if not(community) then
			abort("Statistic ERROR: cannot find monster class for [%s] clsid [%s]", obj:name(), tostring(get_clsid(obj)))
		end
		if(obj) then
			local rank = obj:monster_rank()
			if(community=="flesh") then
				if(rank==250) then
					community = community.."_strong"
				else
					community = community.."_weak"
				end
			elseif(community=="poltergeist") then
				if(rank==501) then
					community = community.."_flame"
				else
					community = community.."_tele"
				end
			elseif(community=="boar") then
				if(rank==200) then
					community = community.."_strong"
				else
					community = community.."_weak"
				end
			elseif(community=="pseudodog") then
				if(rank==400) then
					community = community.."_strong"
				else
					community = community.."_weak"
				end
			elseif(community=="bloodsucker") then
				if(rank==700) then
					community = community.."_strong"
				elseif(rank==500) then
					community = community.."_normal"
				else
					community = community.."_weak"
				end
			end
			check_for_statistic_table(actor_id)
			if(rank>actor_statistic[actor_id].best_monster_rank) then
				actor_statistic[actor_id].best_monster_rank = rank
				actor_statistic[actor_id].best_monster = community
			end
		end
	end
end

function set_best_weapon(hit_amount, actor)
	local active_item = actor:active_item()
	if(active_item) then
		local s = active_item:section()
		for w in string.gfind(s, "%w+") do
			if(weapons_table[w]~=nil) then
				weapons_table[w] = weapons_table[w] + hit_amount
			end
		end
		
		local amount = 0
		for k,v in pairs(weapons_table) do
			if(v>amount) then
				check_for_statistic_table(actor:id())
				amount = v
				if(k=="rgd5" or k=="f1") then
					actor_statistic[actor:id()].favorite_weapon_sect = "grenade_"..k
				else
					actor_statistic[actor:id()].favorite_weapon_sect = "wpn_"..k
				end
				if(k=="desert") then
					actor_statistic[actor:id()].favorite_weapon_sect = "wpn_desert_eagle"
				--elseif(k=="rg") then
				--	actor_statistic[actor:id()].favorite_weapon_sect = "wpn_rg-6"
				--elseif(k=="rgm") then
				--	actor_statistic[actor:id()].favorite_weapon_sect = "wpn_rgm-40"
				end
			end
		end
	end
end

function save(package)
	local i = 0
	for k,v in pairs(actor_statistic) do
		i = i + 1
	end
	package:w_u8(i)
	for k,v in pairs(actor_statistic) do
		package:w_u16(k)
		package:w_u16(actor_statistic[k].surges)
		package:w_u16(actor_statistic[k].completed_quests)
		package:w_u32(actor_statistic[k].killed_monsters)
		package:w_u32(actor_statistic[k].killed_stalkers)
		package:w_u16(actor_statistic[k].founded_secrets)
		package:w_u16(actor_statistic[k].artefacts_founded)
		package:w_u32(actor_statistic[k].best_monster_rank)
		package:w_stringZ(tostring(actor_statistic[k].best_monster))
		package:w_stringZ(tostring(actor_statistic[k].favorite_weapon_sect))
	end
	i = 0
	for k,v in pairs(weapons_table) do
		i = i + 1
	end
	package:w_u8(i)
	for k,v in pairs(weapons_table) do
		package:w_stringZ(tostring(k))
		package:w_float(v)
	end
	i = 0
	for k,v in pairs(artefacts_table) do
		i = i + 1
	end
	package:w_u8(i)
	for k,v in pairs(artefacts_table) do
		package:w_stringZ(tostring(k))
		package:w_bool(v)
	end
	i = 0
	for k,v in pairs(taken_artefacts) do
		i = i + 1
	end
	package:w_u8(i)
	for k,v in pairs(taken_artefacts) do
		package:w_u32(k)
	end
end

function load(package)
	local n = package:r_u8()
	
	for i = 1,n do
		local actor_id = package:r_u16()
		check_for_statistic_table(actor_id)
		actor_statistic[actor_id].surges  			= package:r_u16()
		actor_statistic[actor_id].completed_quests 	= package:r_u16()
		actor_statistic[actor_id].killed_monsters  	= package:r_u32()
		actor_statistic[actor_id].killed_stalkers  	= package:r_u32()
		actor_statistic[actor_id].founded_secrets  	= package:r_u16()
		actor_statistic[actor_id].artefacts_founded	= package:r_u16()
		actor_statistic[actor_id].best_monster_rank = package:r_u32()
		
		local str = package:r_stringZ()
		if(str~="nil") then
			actor_statistic[actor_id].best_monster = str
		end
		str = package:r_stringZ()
		if(str~="nil") then
			actor_statistic[actor_id].favorite_weapon_sect = str
		end
	end
	
	weapons_table = {}
	n = package:r_u8()
	for i = 1,n do
		local k = package:r_stringZ()
		local v = package:r_float()
		weapons_table[k] = v
	end
	artefacts_table = {}
	n = package:r_u8()
	for i = 1,n do
		log("n "..tostring(n))
		local k = package:r_stringZ()
		local v = package:r_bool()
		artefacts_table[k] = v
	end
	
		taken_artefacts = {}
	n = package:r_u8()
	for i = 1,n do
		local k = package:r_u32()
		taken_artefacts[k] = k
	end
end

function write_data_for(gameID)
	if not actor_statistic[gameID] then
		return
	end
	
	local packet = game_cl.GenerateGameMessage(GM_SCRIPT_UPDATE_STATISTIC)
	packet:w_u16(gameID)
	packet:w_u16(actor_statistic[gameID].surges)
	packet:w_u16(actor_statistic[gameID].completed_quests)
	packet:w_u32(actor_statistic[gameID].killed_monsters)
	packet:w_u32(actor_statistic[gameID].killed_stalkers)
	packet:w_u16(actor_statistic[gameID].founded_secrets)
	packet:w_u16(actor_statistic[gameID].artefacts_founded)
	packet:w_u32(actor_statistic[gameID].best_monster_rank)
	packet:w_stringZ(tostring(actor_statistic[gameID].best_monster))
	packet:w_stringZ(tostring(actor_statistic[gameID].favorite_weapon_sect))
	u_EventSendToReliable(packet, gameID)
end

function read_data(packet)
	local id = packet:r_u16()
	check_for_statistic_table(id)
	actor_statistic[id].surges = packet:r_u16()
	actor_statistic[id].completed_quests = packet:r_u16()
	actor_statistic[id].killed_monsters = packet:r_u32()
	actor_statistic[id].killed_stalkers = packet:r_u32()
	actor_statistic[id].founded_secrets = packet:r_u16()
	actor_statistic[id].artefacts_founded = packet:r_u16()
	actor_statistic[id].best_monster_rank = packet:r_u32()
	actor_statistic[id].best_monster = packet:r_stringZ()		
	actor_statistic[id].favorite_weapon_sect = packet:r_stringZ()
	
	if actor_statistic[id].best_monster == "nil" then
		actor_statistic[id].best_monster = nil
	end
	
	if actor_statistic[id].favorite_weapon_sect == "nil" then
		actor_statistic[id].favorite_weapon_sect = nil
	end
end

function pioneer_functor()
	if not story_flags.has_flag("PIONEER_ACHIEVEMENT_GAINED") then
		if story_flags.has_flag("ZAT_B14_GIVE_ITEM_LINKER")
				and story_flags.has_flag("JUP_B1_COMPLETE_END")
				and story_flags.has_flag("JUP_B206_ANOMALOUS_GROVE_DONE") then
			story_flags.give_flag("PIONEER_ACHIEVEMENT_GAINED")
			news_manager.send_tip(getLocalActor(), "st_ach_pioneer", nil, "pioneer", nil, nil)
		end
	end
	return story_flags.has_flag("PIONEER_ACHIEVEMENT_GAINED")
end

