function marked_by_zone_functor()
	if story_flags.has_flag("ACTOR_MARKED_BY_ZONE_3_TIMES") then
		return true
	end
	local counter_name = "actor_marked_by_zone_cnt"
	local cnt_value = xr_logic.pstor_retrieve(db.actor, counter_name, 0)
	if cnt_value > 2 then
		story_flags.give_flag("ACTOR_MARKED_BY_ZONE_3_TIMES")
		news_manager.send_tip(getLocalActor(), "st_ach_marked_by_zone", nil, "marked_by_zone", nil, nil)
		return true
	end

	return false
end

function information_dealer_functor()
	if story_flags.has_flag("ACTOR_INFORMATION_DEALER") then
		return true
	end

	local info_table = {
		[1] = "ZAT_B40_PDA_1_SALED",
		[2] = "ZAT_B40_PDA_2_SALED",
		[3] = "JUP_B46_DUTY_FOUNDER_PDA_SOLD",
		[4] = "JUP_B207_MERC_PDA_WITH_CONTRACT_SOLD",
		[5] = "JUP_B207_DEALERS_PDA_SOLD",
		[6] = "JUP_A9_EVACUATION_INFO_SOLD",
		[7] = "JUP_A9_MEETING_INFO_SOLD",
		[8] = "JUP_A9_LOSSES_INFO_SOLD",
		[9] = "JUP_A9_DELIVERY_INFO_SOLD",
		[10] = "ZAT_B12_DOCUMENTS_SOLD_1",
		[11] = "ZAT_B12_DOCUMENTS_SOLD_2",
		[12] = "ZAT_B12_DOCUMENTS_SOLD_3",
		[13] = "ZAT_B40_NOTEBOOK_SALED",
		[14] = "DEVICE_FLASH_SNAG_SOLD",
		[15] = "DEVICE_PDA_PORT_BANDIT_LEADER_SOLD",
		[16] = "JUP_B10_UFO_MEMORY_2_SOLD"
	}
	local count = 0
	for k,v in pairs (info_table) do
		if story_flags.has_flag(v) then
			count = count + 1
		end
		if count >= 10 then
			news_manager.send_tip(getLocalActor(), "st_ach_information_dealer", nil, "information_dealer", nil, nil)
			story_flags.give_flag("ACTOR_INFORMATION_DEALER")
		end
	end
	return story_flags.has_flag("ACTOR_INFORMATION_DEALER")
end

function friend_of_stalkers_functor()
	if not story_flags.has_flag("SIM_STALKER_HELP_HARDER") then
		if story_flags.has_flag("JUP_B220_TRAPPER_ZATON_CHIMERA_HUNTED_TOLD")
				and story_flags.has_flag("JUP_A12_STALKER_PRISONER_HELPED")
				and story_flags.has_flag("JUP_A10_VANO_GIVE_TASK_END")
				and story_flags.has_flag("ZAT_B5_STALKER_LEADER_END")
				and story_flags.has_flag("ZAT_B7_TASK_END") then
			story_flags.give_flag("SIM_STALKER_HELP_HARDER")
			news_manager.send_tip(getLocalActor(), "st_ach_friend_of_stalkers", nil, "friend_of_stalkers", nil, nil)
			xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, {"stalker", 100})
		end
	end
	return story_flags.has_flag("SIM_STALKER_HELP_HARDER")
end


function wheel_litter_sisyphus_functor()
    local wheel_litter = get_story_object("zat_wheel_litter_sisyphus")
    local zone = db.zone_by_name["zat_b22_stalker_cop_place"]
    if not story_flags.has_flag("WHEEL_LITTER_SISYPHUS_GAINED") then
        if wheel_litter and zone and utils.npc_in_zone(wheel_litter, zone) then
            story_flags.give_flag("WHEEL_LITTER_SISYPHUS_GAINED")
            news_manager.send_tip(db.actor, "st_ach_wheel_litter_sisyphus", nil, "friend_of_stalkers", nil, nil)
        end
    end
    return story_flags.has_flag("WHEEL_LITTER_SISYPHUS_GAINED")
end
