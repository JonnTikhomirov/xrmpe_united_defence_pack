function diplomat_functor()
	if not story_flags.has_flag("DIPLOMAT_ACHIEVEMENT_GAINED") then
		if story_flags.has_flag("JUP_A12_WO_SHOOTING")
				and (story_flags.has_flag("JUP_A10_BANDIT_TAKE_ALL_MONEY") or story_flags.has_flag("JUP_A10_BANDIT_TAKE_MONEY")) then
			news_manager.send_tip(getLocalActor(), "st_ach_diplomat", nil, "diplomat", nil, nil)
			xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, {"stalker", 200})
			xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, {"freedom", 200})
			xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, {"dolg", 200})
			xr_effects.inc_faction_goodwill_to_actor(db.actor, nil, {"bandit", 200})
			story_flags.give_flag("DIPLOMAT_ACHIEVEMENT_GAINED")
		end
	end
	return story_flags.has_flag("DIPLOMAT_ACHIEVEMENT_GAINED")
end

function research_man_functor()
	if story_flags.has_flag("RESEARCH_MAN_GAINED") then
		return true
	end
	local info_table = {
		[1] = "JUP_B16_TASK_DONE",
		[2] = "JUP_B1_TASK_DONE",
		[3] = "JUP_B46_TASK_DONE",
		[4] = "JUP_B47_TASK_END",
		[5] = "JUP_B32_TASK_DONE",
		[6] = "JUP_B6_TASK_DONE",
		[7] = "JUP_B206_TASK_DONE",
		[8] = "JUP_B209_TASK_DONE"
	}
	local count = 0
	for k,v in pairs (info_table) do
		if story_flags.has_flag(v) then
			count = count + 1
		end
		if count >= 4 then
			story_flags.give_flag("RESEARCH_MAN_GAINED")
			news_manager.send_tip(getLocalActor(), "st_ach_research_man", nil, "research_man", nil, nil)
			return true
		end
	end
	return false
end

function friend_of_duty_functor()
	if not story_flags.has_flag("SIM_DUTY_HELP_HARDER") then
		if story_flags.has_flag("JUP_B4_MONOLITH_SQUAD_IN_DUTY")
				and story_flags.has_flag("JUP_B46_DUTY_FOUNDER_PDA_TO_DUTY")
