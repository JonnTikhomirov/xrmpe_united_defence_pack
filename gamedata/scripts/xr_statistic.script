local default_statistic = {
    surges = 0,
    completed_quests = 0,
    killed_monsters = 0,
    killed_stalkers = 0,
    founded_secrets = 0,
    artefacts_founded = 0,
    best_monster = nil,
    favorite_weapon_sect = nil,
    best_monster_rank = 0,
}

actor_statistic = {}

local function add_actor_statistic(id)
    -- Initialize with default values
    actor_statistic[id] = {
        surges = default_statistic.surges,
        completed_quests = default_statistic.completed_quests,
        killed_monsters = default_statistic.killed_monsters,
        killed_stalkers = default_statistic.killed_stalkers,
        founded_secrets = default_statistic.founded_secrets,
        artefacts_founded = default_statistic.artefacts_founded,
        best_monster = default_statistic.best_monster,
        favorite_weapon_sect = default_statistic.favorite_weapon_sect,
        best_monster_rank = default_statistic.best_monster_rank,
    }
end

local function check_for_statistic_table(id)
	if not actor_statistic[id] then
		add_actor_statistic(id)
	end
end

function resetActorStatistic()
	for k,v in pairs(actor_statistic) do
		add_actor_statistic(k)
	end
end

function getLocalActorStatistic()
	local id = 0
	if getLocalActor() then
		id = getLocalActor():id()
	end
	
	check_for_statistic_table(id)
	
	return actor_statistic[id]
end

