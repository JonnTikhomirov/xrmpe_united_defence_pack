function wealthy_functor()
	if getLocalActor() and getLocalActor():money() >= 100000 and not story_flags.has_flag("ACTOR_WEALTHY") then
		story_flags.give_flag("ACTOR_WEALTHY")
		news_manager.send_tip(getLocalActor(), "st_ach_wealthy", nil, "wealthy", nil, nil)
	end
	return story_flags.has_flag("ACTOR_WEALTHY")
end

