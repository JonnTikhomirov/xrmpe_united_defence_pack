-- +UDP
---------------------------------------------------------------------------------------------------
-- grenade binder
----------------------------------------------------------------------------------------------------

function init_replaceable(obj)
	if not OnServer() then
		return
	end
	--db.storage[obj:id()] = { }
	local new_binder = replaceable_grenade_binder(obj)
	obj:bind_object(new_binder)
end

---------------------------------------------------------------------------------------------
class "replaceable_grenade_binder" (object_binder)
function replaceable_grenade_binder:__init(obj) super(obj)
	self.released = false
	self.replaced = false
end

function replaceable_grenade_binder:reinit()
	object_binder.reinit(self)
	self.replacement_sect = utils.cfg_get_string(system_ini(), self.object:section(), "replacement_sect", self.object, false, "")
	if self.replacement_sect and self.replacement_sect ~= "" then
		self.object:set_fastcall(self.fastcall, self)
	end
end

function replaceable_grenade_binder:fastcall()
	if self.released or self.replaced then
		return true
	end

	if self.parent_id == nil and self.object:parent() and self.object:parent():clsid() == clsid.wpn_grenade_f1_s then
		self.parent_id = self.object:parent():id()
		update_parents_info(self.object:id(), self.object:parent())
	end
	if self.object:parent() == nil and self.parent_id ~= nil then
		self.replaced = true
		self.vel = utils.get_grenade_velocity(self.object)
		local sobj = utils.replace_object(self.object, self.replacement_sect, function (id, obj) utils.apply_impulse(obj, self.vel) end)
		if sobj then
			update_parents_info(sobj.id, self.object)
		end
		return true
	end
	return false
end

function replaceable_grenade_binder:net_destroy()
	self.released = true
	object_binder.net_destroy(self)
end
