---------------------------------------------------------------------------------------------
-- Функция для бинда
---------------------------------------------------------------------------------------------

function bind( obj )
--    printf( "BIND HELICOPTER id=%d", obj:id() )
if OnClient() then
	obj:bind_object(heli_binder_cl(obj))-- +UP нужно играть партиклы и звуки
return
end
		 local ini = obj:spawn_ini()
		 if ini and ini:section_exist("logic") then
		obj:bind_object( heli_binder( obj, ini ) )
	end
end

---------------------------------------------------------------------------------------------
-- Биндер вертолётов
---------------------------------------------------------------------------------------------
class "heli_binder" ( object_binder )

function heli_binder:__init( obj, ini ) super( obj )
	self.ini         = ini
	self.initialized = false
	self.loaded      = false
	self.heli_fire = heli_fire.get_heli_firer(obj)
end

function heli_binder:reload( section )
	object_binder.reload( self, section )
end

function heli_binder:reinit()
	object_binder.reinit( self )

	--printf( "heli_binder:reinit()" )

	db.storage[self.object:id()] = {}
	self.st = db.storage[self.object:id()]

	self.heliObject = self.object:get_helicopter()

	self.object:set_callback( callback.helicopter_on_point, self.on_point, self )
	self.object:set_callback( callback.helicopter_on_hit,   self.on_hit,   self )

	self.last_hit_snd_timeout = 0

	local ltx = system_ini()

	self.flame_start_health   = utils.cfg_get_number( ltx, "helicopter", "flame_start_health", self.object, true )

	local object_ini = self.object:spawn_ini()
	self.snd_hit	= utils.cfg_get_string( object_ini, "helicopter", "snd_hit", self.object, false, "", "heli_hit")
	self.snd_damage = utils.cfg_get_string( object_ini, "helicopter", "snd_damage", self.object, false, "", "heli_damaged")
	self.snd_down	= utils.cfg_get_string( object_ini, "helicopter", "snd_down", self.object, false, "", "heli_down")
	
	-- на случай загрузки
	self.st.last_alt       = self.heliObject:GetRealAltitude()
	self.st.alt_check_time = time_global() + 1000
end

function heli_binder:update( delta )
	object_binder.update( self, delta )
	
	--printf( "heli_binder update" )
--	printf( "%d", self.object:level_vertex_light( db.actor:level_vertex_id() ) )
	
	if not self.initialized and db.actor then
		self.initialized = true
		xr_logic.initialize_obj( self.object, self.st, self.loaded, db.actor, modules.stype_heli )
	end

	if self.st.active_section ~= nil then
		xr_logic.issue_event( self.object, self.st[self.st.active_scheme], "update", delta )
	end


	self.object:info_clear()
	local active_section = db.storage[self.object:id()].active_section
	if active_section then
		self.object:info_add('section -- ' .. active_section)
	end
	self:check_health()

	xr_sound.update(self.object:id())
	-- +UP
	if self.m_flame_started ~= nil and self.m_flame_started ~= self.heliObject.m_flame_started then
		-- alife():create("hanging_lamp", self.object:position(), 0, 0)
		self.need_send_update = true
	end
	self.m_flame_started = self.heliObject.m_flame_started

	if self.exploded ~= nil and self.exploded ~= self.heliObject.m_exploded then
		self.need_send_update = true
	end
	self.exploded = self.heliObject.m_exploded

	if self.st.show_health ~= nil and self.st.show_health ~= self.heli_fire.show_health then
		self.need_send_update = true
	end
	self.st.show_health = self.heli_fire.show_health

	if self.need_send_update == true then
		send_script_update(self.object)
	end
	-- -UP
	heli_say_update(self.object)-- +UP
end

function heli_binder:net_spawn( data )
	if not object_binder.net_spawn( self, data ) then
		return false
	end
	
	db.add_obj( self.object )
	db.add_heli( self.object )

	return true
end

function heli_binder:net_destroy()
	db.del_obj( self.object )
	db.del_heli( self.object )

	object_binder.net_destroy( self )
end

function heli_binder:net_save_relevant()
	return true
end

function heli_binder:save( packet )
	object_binder.save( self, packet )
	set_save_marker(packet, "save", false, "heli_binder")
	--printf( "heli_binder: save")

	xr_logic.save_obj( self.object, packet )
	 set_save_marker(packet, "save", true, "heli_binder")
end

function heli_binder:load( packet )
	self.loaded = true
	set_save_marker(packet, "load", false, "heli_binder")
	--printf("generic_object_binder:load(): self.object:name()='%s'", self.object:name())
	object_binder.load( self, packet )

	--printf( "heli_binder: load")

	xr_logic.load_obj( self.object, packet )
	set_save_marker(packet, "load", true, "heli_binder")
end

function heli_binder:check_health()
	local heli = self.heliObject

	--printf( "heli health: %d", heli:GetfHealth() )

	-- if not heli.m_dead then-- +UP
		local health = get_heli_health( self.heliObject, self.st )
	-- +UP
	if self.health ~= nil and health ~= self.health then
		self.need_send_update = true
	end
	if heli.m_dead then
		self.heliObject:TurnEngineSound(false)
	end
	self.health = health

	if not heli.m_dead then
	-- -UP
		if health < self.flame_start_health and not heli.m_flame_started then
			heli_start_flame( self.object )
			--xr_sound.set_sound_play(self.object:id(), self.snd_damage)
			-- +UP
			if health > 0.005 then
				heli_stop_say(self.object)
				heli_say(self.object, self.snd_damage, true)
			end
			 -- -UP
		end

		if health <= 0.005 and not self.st.immortal then
			heli_die( self.object )
			self.need_send_update = true-- +UP
			--xr_sound.set_sound_play(self.object:id(), self.snd_down)
			heli_stop_say(self.object) -- +UP
			heli_say(self.object, self.snd_down, true) -- +UP
		end
	end
end

------------------------------ callbacks ---------------------------------
function heli_binder:on_hit( power, impulse, hit_type, enemy_id )
	--printf( "heli_binder: hit callback")

	local enemy        = level.object_by_id( enemy_id )
	local enemy_cls_id = get_clsid( enemy )
	-- +UP
	--self.heli_fire.enemy = enemy
	--self.heli_fire:update_hit()
	self.heli_fire:update_hit(enemy)
	-- -UP
	-- если обидчик актёр или сталкер, то сделать его своим врагом
	if enemy_cls_id == clsid.actor or enemy_cls_id == clsid.script_stalker then
--		if not self.st.combat.enemy_id then
--			self.st.combat.enemy_id = enemy_id
--		end

		if self.st.hit then
			xr_logic.issue_event( self.object, self.st.hit, "hit_callback", self.object, power, nil, enemy, nil )
		end
	end

	-- пилоты ругаются по рации
	if self.last_hit_snd_timeout < time_global() then
		--xr_sound.set_sound_play(self.object:id(), self.snd_hit)
		self.last_hit_snd_timeout = time_global() + math.random( 4000, 8000 )
	end
end

function heli_binder:on_point( distance, position, path_idx )
	if self.st.active_section ~= nil then
		xr_logic.issue_event( self.object, self.st[self.st.active_scheme], "waypoint_callback", self.object, nil, path_idx )
	end
end

--------------------------------------------------------------------------
function get_heli_health( heli, st )
	local health
	if st.invulnerable then
		health = 1
		heli:SetfHealth( health )
	else
		health = heli:GetfHealth()
		if health < 0 then
			heli:SetfHealth( 0 )
			health = 0
		end
	end
	return health
end

function is_heli_alive( obj )
	return get_heli_health( obj:get_helicopter(), db.storage[obj:id()] ) > 0.005
end

function heli_start_flame( obj )
	obj:get_helicopter():StartFlame()
end

function heli_die( obj )
	local heli = obj:get_helicopter()
	local st   = db.storage[obj:id()]
	heli:Die()
	--db.del_heli( obj )-- +UP удаляем через heli_explode_update
	st.last_alt       = heli:GetRealAltitude()
	st.alt_check_time = time_global() + 1000
end

-- +UP
class "heli_binder_cl" (object_binder)
function heli_binder_cl:__init (obj) super(obj)
	self.flame_particle = nil
	self.flame_particle_path = nil
	self.flame_snd = nil
	self.flame_snd_path = nil
end

function heli_binder_cl:reinit()
	object_binder.reinit(self)
	local npc_id = self.object:id()
	db.storage[npc_id] = { }   
	self.st = db.storage[npc_id]
	self.st.pstor = nil
	self.st.binder = self

	self.heli = self.object:get_helicopter()

	self.flame_particle_path = utils.cfg_get_string(system_ini(), "helicopter", "smoke_particle", self.object, false, "", nil)
	self.flame_snd_path = utils.cfg_get_string(system_ini(), "helicopter", "broken_snd", self.object, false, "", nil)
end

function heli_binder_cl:net_spawn(data)
	if not object_binder.net_spawn(self, data) then
		return false
	end

	db.add_obj( self.object )
	db.add_heli( self.object )
	self.object:set_fastcall(self.fastcall, self)
	return true
end

function heli_binder_cl:net_destroy()
	db.del_obj( self.object )
	db.del_heli( self.object )
	if self.flame_particle ~= nil then
		self.flame_particle:stop()
		self.flame_particle = nil
	end
	self.heli:TurnLighting(false)
	if self.flame_snd ~= nil then
		self.flame_snd:stop()
		self.flame_snd = nil
	end
	object_binder.net_destroy( self )
end

function heli_binder_cl:update(delta)
	object_binder.update(self, delta)
	self:update_flame()

	if self.st.show_health and self.heli.m_exploded == false then
		if self.hp_static == nil then
			self:cs_add()
		end
		self:cs_update_progress_health()
	elseif (not self.st.show_health or self.heli.m_exploded == true) and self.hp_static ~= nil then
		self:cs_remove()
	end
end

function heli_binder_cl:fastcall()

	self:update_particles()
	self:update_sound()

	return self.heli.m_exploded or not db.heli[self.object:id()]-- снять апдейт если взорвались или удаляемся
end

function heli_binder_cl:update_flame()

	if self.heli.m_flame_started == true and self.heli.m_exploded == false then		
		if self.flame_particle == nil and self.flame_particle_path ~= nil then
			self.flame_particle = xr_effects.play_particle_at_npc(db.actor, self.object, { self.flame_particle_path, "front_propeller"})
		end
		self.heli:TurnLighting(true)
	else
		if self.flame_particle ~= nil then
			self.flame_particle:stop()
		end
		self.heli:TurnLighting(false)
	end
end

function heli_binder_cl:update_sound()

	local set_flame_snd = self.heli.m_flame_started

	if self.heli:GetfHealth() <= 0 then
		self.heli:TurnEngineSound(false)
		set_flame_snd = true
	end

	if set_flame_snd == true and self.heli.m_exploded == false then
		local pos = self.object:bone_position("front_propeller")

		if self.flame_snd == nil and self.flame_snd_path ~= nil then
			self.flame_snd = sound_object(self.flame_snd_path)
			self.flame_snd:play_at_pos(self.object, pos, 0, sound_object.s3d + sound_object.looped)
		end
		if self.flame_snd ~= nil then
			self.flame_snd:set_position(pos)
		end
	elseif self.flame_snd ~= nil then
		self.flame_snd:stop()
	end
end

function heli_binder_cl:update_particles()
	if not self.st.particles then
        return
    end
	for i = #self.st.particles, 1, -1 do
		local v = self.st.particles[i]
		if v ~= nil then
			if v[1]:playing() then
				local pos = self.object:position()
				if v[2] ~= nil and v[2] ~= "" then
					pos = self.object:bone_position(v[2])
				end
				v[1]:move_to(pos, self.heli:GetCurrVelocityVec())
			end
		end
	end
end

function heli_binder_cl:cs_add()
	local hud = get_hud()
	hud:AddCustomStatic("heli_boss", true)	
	self.hp_static = hud:GetCustomStatic("heli_boss")
	
	local xml = CScriptXmlInit()
	xml:ParseFile("progress_bars.xml")
	
	local w = self.hp_static:wnd()
	self.hp_progress = xml:InitProgressBar("boss_health", w )
	
	self.base_color = GetColorDef("dark_red_mpe")
	self.heal_color = GetColorDef("yellow_mpe")

	self.hp_progress:Show(true)
end

function heli_binder_cl:cs_remove()
	local hud = get_hud()
	local custom_static = hud:GetCustomStatic("heli_boss")
	if custom_static then
		hud:RemoveCustomStatic("heli_boss")
		self.hp_static = nil
		self.hp_progress:Show(false)
		self.hp_progress = nil
	end
end

function heli_binder_cl:cs_update_progress_health()
	local hud = get_hud()
	local st = hud:GetCustomStatic("heli_boss")
	if st ~= nil and self.hp_progress ~= nil then
		local w = st:wnd()
		local _progr = self.heli:GetfHealth()*100
		if _progr < 0 then
			_progr = 0
		end
		self.hp_progress:SetProgressPos(_progr)
	end
end

function send_script_update(npc)
	local heli = npc:get_helicopter()

	local packet = game_cl.GenerateGameMessage(GM_SCRIPT_HELI_UPDATE)
	packet:w_u16(npc:id())
	packet:w_float(heli:GetfHealth())
	packet:w_bool(heli.m_flame_started)
	packet:w_bool(heli.m_exploded)

	local show_health = false
	local st = db.storage[npc:id()]
	if st then
		show_health = st.show_health
	end
	packet:w_bool(show_health)

	u_EventSendReliable(packet)
end

function read_script_update(packet)
	local id = packet:r_u16()
	local health = packet:r_float()
	local burning = packet:r_bool()
	local exploded = packet:r_bool()
	local show_health = packet:r_bool()

	local st = db.storage[id]

	heli = st.object:get_helicopter()
	heli:SetfHealth(health)
	if burning == true then
		heli:StartFlame() -- на клиенте ставит флаг горения, не ставит партикл и звук
	end

	if exploded == true then
		heli:Explode() -- на клиенте ставит флаг разрушения, останавливает апдейт биндера, не взрывает
	end

	st.show_health = show_health
end

function heli_explode_update()
	for k,v in pairs(db.heli) do
		if v ~= nil then
			local st = db.storage[v:id()]
			if OnServer() then
				if st.release_time ~= nil and time_global() > st.release_time then
					st.release_time = nil
					alife():release(alife():object(v:id()))
				else
					local heli = v:get_helicopter()
					if heli.m_exploded == true and st.exploded ~= true then
						st.exploded = true
						st.release_time = time_global() + 20000 -- звук взрыва играет 20 сек
						send_script_update(v)
					end
				end
			elseif OnClient() and v:get_helicopter().m_exploded == true then
				if st.binder ~= nil then
					st.binder:update(0) -- обработчик не работает сам после взрыва
				end
			end
		end
	end
end

local function get_heli_voice_data(npc)
	local storage = db.storage[npc:id()]

	if storage.heli_voice == nil then
		db.storage[npc:id()].heli_voice = {
			sound_source_id = nil,
			queue = {},
			snd_obj = nil,
			playing = nil,
			finish_time = 0
		}
	end

	return storage.heli_voice
end

-- Добавить фразу в очередь
function heli_say(npc, sound, unique)
	if npc == nil or sound == nil then
		return
	end

	local voice = get_heli_voice_data(npc)
	
	if unique == true then
		for _, v in ipairs(voice.queue) do
			if v == sound then
				return
			end
		end
	end

	table.insert(voice.queue, sound)

	heli_say_update(npc)
end

-- Остановить звук и очистить очередь
function heli_stop_say(npc)
	if npc == nil then
		return
	end

	local voice = get_heli_voice_data(npc)
	
	if voice.snd_obj ~= nil then
		voice.snd_obj:stop()
	end
	voice.queue = {}
	voice.snd_obj = nil
	voice.playing = nil
	voice.finish_time = 0
end

-- Обновление очереди
function heli_say_update(npc)
	local voice = get_heli_voice_data(npc)
	local now = time_global()

	-- Еще проигрывается предыдущая фраза
	if voice.playing ~= nil and now < voice.finish_time then
		return
	end

	voice.playing = nil

	-- Очередь пуста
	if #voice.queue == 0 then
		return
	end

	local sound = table.remove(voice.queue, 1)

	-- Не удалось начать воспроизведение
	snd_obj = xr_sound.set_sound_play(npc:id(), sound)
	if snd_obj == nil then
		return
	end

	local duration = 0

	if sound_theme.theme[sound] ~= nil then
		duration = sound_theme.theme[sound].min_idle or 0
	end

	voice.playing = sound
	voice.finish_time = now + duration * 1000
end
