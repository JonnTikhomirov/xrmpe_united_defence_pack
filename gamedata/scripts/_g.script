---Получить сквад обьекта!!!!!
function get_object_squad(object)
	if object == nil then abort("You are trying to get squad_object from NIL object!!!") end
	local obj_id = nil
	if type(object.id) == "function" then
		obj_id = object:id()
	else
		obj_id = object.id
	end
	if OnServer then
		local se_obj = alife():object(obj_id)
		if se_obj and se_obj.group_id ~= 65535 then
			return alife():object(se_obj.group_id)
		end
	end
	return nil
end

function get_story_squad(story_id)
	local squad_id = get_story_object_id(story_id)
	return squad_id and alife():object(squad_id)
end

---Проверка по временному интервалу.
---@param val1 number
---@param val2 number
function in_time_interval(val1, val2)
	local game_hours = level.get_time_hours()
	if val1 >= val2 then
		return game_hours < val2 or game_hours >= val1
	else
		return game_hours < val2 and game_hours >= val1
	end
end

---@param show boolean
function show_all_ui(show)
		local hud = get_hud()
	if(show) then
			level.show_indicators()
--	    db.actor:restore_weapon()
			db.actor:disable_hit_marks(false)
			hud:show_messages()
	else
			if db.actor:is_talking() then
					db.actor:stop_talk()
			end
			level.hide_indicators_safe()
			hud:HideActorMenu()
			hud:HidePdaMenu()
			hud:hide_messages()
--	    db.actor:hide_weapon()
			db.actor:disable_hit_marks(true)
	end
end

-- + UP
---@param fmt string
function string_format_safe(fmt, ...)
    return string_format_fallback(fmt, false, ...)
end

---@param fmt string
function string_format_safe_errors(fmt, ...)
	return string_format_fallback(fmt, true, ...)
end

---@param fmt string
---@param mark_errors boolean
function string_format_fallback(fmt, mark_errors, ...)
    -- собираем varargs в массив вручную
    local args = {...}
    local arg_i = 0

    local result = fmt:gsub("%%[%-%+%#0%d%.]*[cdiouxXeEfgGsq%%]", function(spec)
        -- обработка литерального '%%'
        if spec == "%%" or spec:match("^%%%%$") then
            return "%"
        end

        arg_i = arg_i + 1

        -- безопасно достаём аргумент из массива
        local v = args[arg_i]

		if v == nil then
			return "nil"
		end

		local t = type(v)

        if(t == "userdata") then
			local res = "<"
			if v.clsid then
				res = res .. "clsid=" .. v:clsid() .. ";"
			end
			if v.name then
				res = res .. "name=" .. v:name() .. ";"
			end
			if v.NameShort then
				res = res .. "NameShort=" .. v:NameShort() .. ";"
			end
			if v.type then
				res = res .. "type=" .. v:type() .. ";"
			end
			if res == "" then
				res ="userdata"
			end
			return res .. ">"
		end

		local ok, res = pcall(string.format, spec, v)
        if ok then
            return res
        end

		local ok, v = pcall(tostring, v)
		if not ok then
			v = "<!tostring_failed>"
		end

        if mark_errors then
            return string.format("<!%s:%s>", t, v)
        end
        return v

    end)

    return result
end

function strip_comment(s)
    if type(s) ~= "string" then return s end
    return s:match("^[^;]*")
end

function to_number(s, default)
    s = strip_comment(s)
    local n = tonumber(s)
    return n ~= nil and n or default
end

