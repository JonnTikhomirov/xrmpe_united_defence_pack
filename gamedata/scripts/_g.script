function getLocalActor()
	return db.mp_actors[LocalActor()]
end

function getNearestActor(obj)
	if obj ~= nil then
		local position
		if type(obj.id) == "number" then
			--this is a server object
			position = obj.position
		else
			position = obj:position()
		end
		
		local st = db.storage[get_nearest_actor(position)]
		if st and st.object then
			return st.object
		else
			printf_msg("!! No object for getNearestActor")
			callstack()
			return db.actor
		end
	else
		printf_msg("!! No object for getNearestActor")
		callstack()
		return db.actor
	end
end

---@param dist number
function getRelevantActors(obj, dist)
	local actors = { }
	if obj ~= nil then
		local position
		if type(obj.id) == "number" then
			--this is a server object
			position = obj.position
		else
			position = obj:position()
		end
		
		for k,v in pairs(db.mp_actors) do
			if v:position():distance_to(position) <= dist then
				table.insert(actors, v)
			end
		end
	end
	
	return actors
end

function give_info(info)
	db.actor:give_info_portion(info)
end

---@param info string
function disable_info(info)
	if has_alife_info(info) then
		printf("*INFO*: disabled npc='single_player' id='%s'", info)
		
		db.actor:disable_info_portion(info)
		
		if LocalActor() ~= 0 and OnClient() then
			local actor = db.mp_actors[LocalActor()]
			--in case we are spectator
			if actor ~= nil then
				actor:disable_info_portion(info)
			end
		end
	end
end

function create_ammo(section, position, lvi, gvi, pid, num)
	if OnServer() then
		local ini = system_ini()
	
		local num_in_box = ini:r_u32(section, "box_size")
		local t = {}
		while num > num_in_box do
			local obj = alife():create_ammo(section, position, lvi,	gvi, pid, num_in_box)
			table.insert(t, obj)
			num = num - num_in_box
		end
		local obj = alife():create_ammo(section, position, lvi,	gvi, pid, num)
		table.insert(t, obj)
		return t
	end
end

