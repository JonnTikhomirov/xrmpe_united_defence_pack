-- аргумент - код действия из перечисления key_bindings
-- для спринта bind_to_keyname( key_bindings.kACCEL ) вернет строку 'X', если спринт назначен на X
function bind_to_keyname(iNum)
	for k, v in pairs(keys) do if DIK_keys["DIK_" .. v] and dik_to_bind(DIK_keys["DIK_" .. v]) == iNum then return v end end
	return ""
end
