----------------------------------------
-- Общие переменные модуля
----------------------------------------
local sModule = script_name() -- / строковое имя файла-модуля
local con = get_console()
local screen_w, screen_h = nil, nil

-- параметры автоматического (при загрузке) назначения клавиш
-- key    - назначаемая клавиша
-- action - функция / текстовая ссылка на функцию
local tbinding = {
}

----------------------------------------
-- Инициализация
----------------------------------------

function init()
	DIK_keys.MOUSE_4 = 340
	DIK_keys.MOUSE_5 = 341
	-- xr_s.register_callback("game_load", on_load)
end

function on_load()
	for _, v in ipairs(tbinding) do bind_console_key(v.key, v.action) end
	xr_s.register_callback("update", update)
end

function update()
	local sw, sh = con:get_string("vid_mode"):match("(%d+)x(%d+)")
	if sh ~= screen_h or sw ~= screen_w then
		if sh == "0" then -- "key_codex0"
			con:execute("vid_mode " .. screen_w .. "x" .. screen_h)
			xr_s.on_event("on_btn_" .. sw, {key = sw})
		else
			screen_w, screen_h = sw, sh
		end
	end
end

function bind_console_key(key, action)
	if type(key) ~= 'string' then return end
	local f = Get_CheckedFunc(action)
	if f then
		local key_code = DIK_keys["DIK_" .. string.upper(key)]
		if key_code then
			con:execute("bind_console vid_mode " .. key_code .. "x0 k" .. key)
			xr_s.register_callback("on_btn_" .. key_code, f)
			xr_s.register_callback("actor_destroy", function() unbind_console_key(key) end)
		else
			key_code = DIK_keys[string.upper(key)]
			if key_code then -- mouse btns
				con:execute("bind_console vid_mode " .. key_code .. "x0 " .. key:gsub("_", ""))
				xr_s.register_callback("on_btn_" .. key_code, f)
				xr_s.register_callback("actor_destroy", function() unbind_console_key(key) end)
			end
		end
	else
		-- printf("bind_console_dbg:no_action_for_key_"..key)
	end
end

function unbind_console_key(key)
	if DIK_keys["DIK_" .. string.upper(key)] then
		con:execute("unbind_console k" .. key)
	elseif DIK_keys[string.upper(key)] and key:lower():match "^mouse_%d$" then -- mouse btns
		con:execute("unbind_console " .. key:gsub("_", ""))
	end
end

