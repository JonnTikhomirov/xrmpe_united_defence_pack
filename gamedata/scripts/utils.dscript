--' Вычитка свойств для спауна объектов.
function parse_names(s)
	s = s:match("^[^;]*")  -- +UP не учитываем комментарий
		local t = {}
		for name in string.gfind( s, "([%w_%-.\\]+)%p*" ) do
				table.insert( t, name )
		end
		return t
end

function read_file_to_string(fspath, fullname)
	if not getFS():exist(fspath, fullname) then
		return nil
	end
	
	local file_reader = getFS():r_open(fspath, fullname)
	if not file_reader then
		return nil
	end

	local str = ""
	while not file_reader:r_eof() do
		str = str .. string.char(file_reader:r_u8())
	end

	return str
end

function all_players_in_zone(npc, zone, connected_only)
	if zone == nil then
		return false
	end
	
	local has_actors = false
	for k,v in pairs(db.mp_actors) do
		has_actors = true
		
		local net_ready = true
		if connected_only then
			net_ready = IsActorNetReady(v:id())
		end
		
		if net_ready and not zone:inside(v:position()) and v.health > 0 then-- +UP на арене не срабатывало пока труп не исчез
			return false
		end
	end

	return has_actors
end

function play_particle(path, pos, vel)
	local prtcle = particles_object(path)
	prtcle:play_at_pos(pos)
	if vel ~= nil then
		prtcle:move_to(pos, vel)
	end
	return prtcle
end

function bone_pos(obj, bone)
	if obj:get_bone_id(bone) ~= 65535 then
		return obj:bone_position(bone)
	else 
		return nil
	end
end