--' Вычитка свойств для спауна объектов.
function parse_names(s)
	if not s then
		return nil
	end
	s = s:match("^[^;]*")  -- +UP не учитываем комментарий
		local t = {}
		for name in string.gfind( s, "([%w_%-.\\]+)%p*" ) do
				table.insert( t, name )
		end
		return t
end

function read_file_to_string(fspath, fullname)
	if not getFS():exist(fspath, fullname) then
		return nil
	end
	
	local file_reader = getFS():r_open(fspath, fullname)
	if not file_reader then
		return nil
	end

	local str = ""
	while not file_reader:r_eof() do
		str = str .. string.char(file_reader:r_u8())
	end

	return str
end

function all_players_in_zone(npc, zone, connected_only)
	if zone == nil then
		return false
	end
	
	local has_actors = false
	for k,v in pairs(db.mp_actors) do
		has_actors = true
		
		local net_ready = true
		if connected_only then
			net_ready = IsActorNetReady(v:id())
		end
		
		if net_ready and not zone:inside(v:position()) and v.health > 0 then-- +UP на арене не срабатывало пока труп не исчез
			return false
		end
	end

	return has_actors
end

function play_particle(path, pos, vel)
	local prtcle = particles_object(path)
	prtcle:play_at_pos(pos)
	if vel ~= nil then
		prtcle:move_to(pos, vel)
	end
	return prtcle
end

function bone_pos(obj, bone)
	if obj:get_bone_id(bone) ~= 65535 then
		return obj:bone_position(bone)
	else 
		return nil
	end
end

-- Функция-конструктор флагов для висячей лампы
-- @param opts table: Таблица с булевыми значениями (true/false). Не указанные поля считаются false.
-- @return number: Итоговое целочисленное значение флагов (uint16_t)
function build_lamp_flags(opts)
	opts = opts or {}
	local flags = 0
	
	if opts.physic        then flags = flags + hanging_lamp_flags.Physic end
	if opts.cast_shadow   then flags = flags + hanging_lamp_flags.CastShadow end
	if opts.r1            then flags = flags + hanging_lamp_flags.R1 end
	if opts.r2            then flags = flags + hanging_lamp_flags.R2 end
	if opts.type_spot     then flags = flags + hanging_lamp_flags.TypeSpot end
	if opts.point_ambient then flags = flags + hanging_lamp_flags.PointAmbient end
	
	return flags
end

function has_lamp_flag(flags, flag_value)
    return bit_and(flags, flag_value) ~= 0
end

-- Преобразует числовое значение флагов обратно в таблицу с булевыми значениями
-- @param flags number: Числовое значение флагов (например, 0x1C)
-- @return table: Таблица вида { r1 = true, r2 = true, type_spot = true, ... }
function parse_lamp_flags(flags)
	return {
		physic        = bit_and(flags, hanging_lamp_flags.Physic) ~= 0,
		cast_shadow   = bit_and(flags, hanging_lamp_flags.CastShadow) ~= 0,
		r1            = bit_and(flags, hanging_lamp_flags.R1) ~= 0,
		r2            = bit_and(flags, hanging_lamp_flags.R2) ~= 0,
		type_spot     = bit_and(flags, hanging_lamp_flags.TypeSpot) ~= 0,
		point_ambient = bit_and(flags, hanging_lamp_flags.PointAmbient) ~= 0,
	}
end

-- Вспомогательная функция для отладки: возвращает читаемую строку с названиями активных флагов
-- @param flags number: Числовое значение флагов
-- @return string: Например, "R1, R2, TYPE_SPOT"
function get_lamp_flags_string(flags)
	local active_flags = {}
	
	if bit_and(flags, hanging_lamp_flags.Physic) ~= 0        then table.insert(active_flags, "Physic") end
	if bit_and(flags, hanging_lamp_flags.CastShadow) ~= 0   then table.insert(active_flags, "CastShadow") end
	if bit_and(flags, hanging_lamp_flags.R1) ~= 0            then table.insert(active_flags, "R1") end
	if bit_and(flags, hanging_lamp_flags.R2) ~= 0            then table.insert(active_flags, "R2") end
	if bit_and(flags, hanging_lamp_flags.TypeSpot) ~= 0     then table.insert(active_flags, "TypeSpot") end
	if bit_and(flags, hanging_lamp_flags.PointAmbient) ~= 0 then table.insert(active_flags, "PointAmbient") end
	
	if #active_flags == 0 then
		return "NONE (0)"
	end
	
	return table.concat(active_flags, " | ")
end

--Преобразует массив строк или чисел {"R", "G", "B"} в 32-битное целое число
-- @param color_arr table: Массив из 3-х или 4-х элементов (значения от 0.0 до 1.0)
-- @return number: 32-битное целое число (формат 0xAARRGGBB)
function color_from_str_array(color_arr)
    if not color_arr or #color_arr < 3 then
        return 0
    end

    -- Преобразуем строки в числа и жестко ограничиваем диапазоном [0, 1]
    local r = math.max(0.0, math.min(1.0, tonumber(color_arr[1]) or 0.0))
    local g = math.max(0.0, math.min(1.0, tonumber(color_arr[2]) or 0.0))
    local b = math.max(0.0, math.min(1.0, tonumber(color_arr[3]) or 0.0))
    
    -- Опциональный 4-й элемент (Alpha). Для ламп обычно 0x00, но можно сделать 0xFF
    local a = 1
    if color_arr[4] then
        a = math.max(0.0, math.min(1.0, tonumber(color_arr[4]) or 0.0))
    end

	return GetARGB(a, r, g, b)
end

-- @param default_val number: color ARGB
-- @return number: color ARGB (формат 0xAARRGGBB)
function cfg_get_color(char_ini, section, field, object, mandatory, default_val)
	local str = cfg_get_string(char_ini, section, field, object, false, "", nil)
	if not str then
		if mandatory then
			local err = "'Attempt to read a non-existant color field '" ..
				field .. "' in section '" .. section .. "'";
			abort("%s", err)
			return nil
		end
		if type(default_val) == "string" then
			return color_from_str_array(parse_names(default_val))
		else
			return default_val
		end
	end
	return color_from_str_array(parse_names(str))
end