function CTreasureManager:register_restrictor(se_obj)
	local spawn_ini = se_obj:spawn_ini()
	if(spawn_ini:section_exist("secret")) then
		self.secret_restrs[se_obj:name()] = se_obj.id
	end
end
-- +UP
function CTreasureManager:build_chunks()
	local size = self.level_defaults.chunk_size
	local height = self.level_defaults.chunk_height
	local chunks = {}

	if size <= 0 then
		chunks["__global__"] = { secrets = {} }
		for id in pairs(self.secrets) do
			table.insert(chunks["__global__"].secrets, id)
		end
		return chunks
	end

	for id,v in pairs(self.secrets) do
		if v.items and not empty(v.items) then
			local rid = self.secret_restrs[id]
			if rid then
				local o = alife():object(rid)
				if o then
					local p = o.position
					local cx = math.floor(p.x / size)
					local cz = math.floor(p.z / size)
					local cy = (height > 0) and math.floor(p.y / height) or 0
					local key = cx..":"..cy..":"..cz
					chunks[key] = chunks[key] or { secrets = {} }
					table.insert(chunks[key].secrets, id)
				end
			else
				printf("treasure restrictor %s not found!", id)
			end
		end
	end

	return chunks
end

-- activation pipeline: only runs when use_level_mode==true
function CTreasureManager:activate_level_secrets()
	if not self.use_level_mode or self.activated_on_level then return end
	
	-- Сначала сканируем все объекты на уровне
	self:scan_level_objects()

	local chunks = self:build_chunks()
	local activated = {}
	
	for _,chunk in pairs(chunks) do
		local ids, weights = {}, {}
		for _,id in ipairs(chunk.secrets) do
			local p = self.secrets[id].prob
			if p > 0 then
				table.insert(ids, id)
				table.insert(weights, p)
			end
		end

		local maxp = self.level_defaults.max_per_chunk
		local selected = {}

		while #selected < maxp and #ids > 0 do
			local id, idx = weighted_pick(ids, weights)
			if not id then break end
			table.insert(selected, id)
			table.remove(ids, idx)
			table.remove(weights, idx)
		end

		-- добор до минимума БЕЗ учета шанса
		local minp = self.level_defaults.min_per_chunk
		if minp > #selected then
			for _,id in ipairs(chunk.secrets) do
				if #selected >= minp then break end
				if not table_has_value(selected, id) then
					table.insert(selected, id)
				end
			end
		end

		for _,id in ipairs(selected) do
			table.insert(activated, id)
		end
	end

	if self.level_defaults.max_activated > 0 then
		while #activated > self.level_defaults.max_activated do
			table.remove(activated, math.random(#activated))
		end
	end

	for id, _ in pairs(self.secrets) do
		local is_activated = table_has_value(activated, id)
		self:spawn_treasure(id, is_activated)
	end
	to_log("TreasureManager:activate_level_secrets: items_from_secrets")
	table.print(self.items_from_secrets)
	self.activated_on_level = true

end
-- -UP

function CTreasureManager:update()
	if not(self.items_spawned) then
		-- +UP
		if self.use_level_mode and not self.activated_on_level then
			self:activate_level_secrets()
			self.activated_on_level = true
			self.items_spawned = true
		-- -UP
		elseif not self.use_level_mode then-- +UP
			self:scan_level_objects()-- +UP
			for k,v in pairs(self.secrets) do
				self:spawn_treasure(k, true)
			end
			self.items_spawned = true
		end-- +UP
	end

	local global_time = time_global()
	if(self.check_time and global_time-self.check_time<=500) then
		return
	end
	self.check_time = global_time

	for k,v in pairs(self.secrets) do
		if(v.given) then
			if(v.empty) then
				local sect = xr_logic.pick_section_from_condlist(db.actor, nil, v.empty)
				if (sect=="true") and not v.checked then
					if self.secret_restrs[k] then-- +UP
						level.map_remove_object_spot(self.secret_restrs[k], "treasure")
					end-- +UP
					if db.mp_actors then-- +UP
						for kk,vv in pairs(db.mp_actors) do-- +UP
							xr_statistic.inc_founded_secrets_counter(vv:id())-- +UP
						end
					end-- +UP
					v.empty = nil
					v.checked = true
					printf("Empty secret [%s] remove map spot!", k)
				end
			elseif (v.refreshing and v.checked) then
				local sect = xr_logic.pick_section_from_condlist(db.actor, nil, v.refreshing)
				if (sect=="true") then
					v.given = false
					v.checked = false
					-- +UP
					v.to_find = 0
					-- При респавне нужно реактивировать объекты
					if v.disabled_ids then
						for _, obj_id in ipairs(v.disabled_ids) do
							local se_obj = alife():object(obj_id)
							if se_obj then
								se_obj:can_switch_online(true)
							end
						end
						v.disabled_ids = nil
					end
					-- Пересканируем объекты для этого тайника
					self.objects_scanned = false
					self:scan_level_objects()
					self:spawn_treasure(k)
					-- -UP
					printf("Given secret [%s] now is avaliable!", k)
				end
			end
		end
	end
end

-- +UP
function CTreasureManager:spawn_treasure(treasure_id, is_activated)
	if not(self.secrets[treasure_id]) then
		abort("There is no stored secret [%s]", tostring(treasure_id))
	end
	
	if(self.secrets[treasure_id].given) then
		return
	end
	
	if is_activated == nil then
		is_activated = true
	end

	-- Если еще не сканировали объекты - делаем это сейчас
	if not self.objects_scanned then
		self:scan_level_objects()
	end
	
	local secret_data = self.secrets[treasure_id]
	local scanned_items = self.scanned_objects[treasure_id]
	
	if not scanned_items then
		to_log("spawn_treasure: нет объектов для тайника " .. treasure_id)
		return
	end

	local total_spawned = 0
	local released_ids = {}
	
	if not is_activated then
		to_log("spawn_treasure: тайник " .. treasure_id .. " НЕ активирован, удаляем все предметы")
		
		for item_section, objects in pairs(scanned_items) do
			for _, obj_id in ipairs(objects) do
				local se_obj = alife():object(obj_id)
				if se_obj then
					alife():release(se_obj, true)
					table.insert(released_ids, obj_id)
					to_log("  Удалён объект " .. obj_id .. " (" .. item_section .. ")")
				end
			end
		end
		
		secret_data.to_find = 0
		secret_data.released_ids = released_ids
		return
	end

	for item_section, config in pairs(secret_data.items) do
		local objects = scanned_items[item_section]
		if objects then
			local max_count = config.count or 1
			local prob = config.prob or 1.0
			--printf("sect=%s in treasure_id=%s, max_count=%d, prob=%f", item_section, treasure_id, max_count, prob)
			-- Копируем и перемешиваем
			local shuffled = {}
			for _, obj_id in ipairs(objects) do
				table.insert(shuffled, obj_id)
			end
			
			for i = #shuffled, 2, -1 do
				local j = math.random(i)
				shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
			end
			
			local spawned_for_section = 0
			
			for _, obj_id in ipairs(shuffled) do
				local se_obj = alife():object(obj_id)
				if se_obj then
					local should_keep = false
					
					-- Сначала проверяем шанс
					if math.random() < prob then
						-- Затем проверяем лимит
						if spawned_for_section < max_count then
							should_keep = true
							spawned_for_section = spawned_for_section + 1 -- Увеличиваем ТОЛЬКО если оставили
						end
					end
					
					if should_keep then
						-- Оставляем (ничего не делаем)
						total_spawned = total_spawned + 1
						self.items_from_secrets[obj_id] = self.secret_restrs[treasure_id]
					else
						-- Удаляем
						--printf("Disable obj_id=%s in treasure_id=%s", obj_id, treasure_id)
						alife():release(se_obj, true)
						table.insert(released_ids, obj_id)
					end
				end
			end
		end
	end
	
	secret_data.to_find = total_spawned
	
	-- Сохраняем ID выключенных объектов для save/load
	secret_data.disabled_ids = disabled_ids
	
	to_log("spawn_treasure: " .. treasure_id .. " активировано " .. total_spawned .. " предметов")
end
-- -UP

function CTreasureManager:give_treasure(treasure_id, spawn)
	if not(self.secrets[treasure_id]) then
		abort("There is no stored secret [%s]", tostring(treasure_id))
	end
	if(self.secrets[treasure_id].given) then
		printf("Secret [%s] already given!", treasure_id)
		return
	end
	if(self.secrets[treasure_id].to_find==0 and not(self.secrets[treasure_id].empty)) then
		news_manager.send_treasure(2)
		printf("Secret [%s] already empty", treasure_id)
		return
	end
	if(spawn) then
		self:spawn_treasure(treasure_id)
	end
	if self.secret_restrs[treasure_id] then-- +UP
		level.map_add_object_spot_ser(self.secret_restrs[treasure_id], "treasure", "")
		level.map_sync_spot(self.secret_restrs[treasure_id], "treasure", SV_OBJECT_ID) -- SV_OBJECT_ID means send to all clients
	end-- +UP
	self.secrets[treasure_id].given = true
	news_manager.send_treasure(0)
	--printf_msg("Give secret [%s]", treasure_id)
end

function CTreasureManager:give_random()
	local rnd_tbl = {}
	for k,v in pairs(self.secrets) do
				if not(v.given) then
			table.insert(rnd_tbl, k)
				end
	end
	if(#rnd_tbl~=0) then
		self:give_treasure(rnd_tbl[math.random(1,#rnd_tbl)])
		return
	end
	printf("There are no treasures avaliable!")
end

function CTreasureManager:on_item_take(obj_id)
	to_log("TreasureManager:on_item_take: obj_id=%s", obj_id)-- TODO: убрать лог
	local restr_id = self.items_from_secrets[obj_id]
	local treasure_id = nil
	for k,v in pairs(self.secret_restrs) do
		if(restr_id==v) then
			treasure_id = k
			break-- +UP
		end
	end
	if(treasure_id) then
		to_log("TreasureManager: treasure_id=%s", treasure_id)-- TODO: убрать лог
		self.secrets[treasure_id].to_find = self.secrets[treasure_id].to_find - 1
		if(self.secrets[treasure_id].to_find==0) then
			to_log("TreasureManager:to_find==0: treasure_id=%s", treasure_id)-- TODO: убрать лог
			if self.secret_restrs[treasure_id] then-- +UP
				level.map_remove_object_spot(self.secret_restrs[treasure_id], "treasure")
			end-- +UP
			if db.mp_actors then-- +UP
				for k,v in pairs(db.mp_actors) do
					xr_statistic.inc_founded_secrets_counter(v:id())
				end
			end-- +UP
			--printf_msg("Secret [%s] now is empty!", treasure_id)
			self.secrets[treasure_id].checked = true
			news_manager.send_treasure(1)
		end
		self.items_from_secrets[obj_id] = nil
	end
end

function CTreasureManager:save(package)
	set_save_marker(package, "save", false, "CTreasureManager")
	package:w_bool(self.items_spawned)
	local num = 0
	for k,v in pairs(self.items_from_secrets) do
		num = num + 1
	end
	package:w_u16(num)
	for k,v in pairs(self.items_from_secrets) do
		package:w_u16(k)
		package:w_u16(v)
	end

	num = 0
	for k,v in pairs(self.secrets) do
		num = num + 1
	end
	package:w_u16(num)
	for k,v in pairs(self.secrets) do
		if not(self.secret_restrs[k]) then
			package:w_u16(-1)
		else
			package:w_u16(self.secret_restrs[k])
		end
		package:w_bool(v.given)
		package:w_bool(v.checked)
		package:w_u8(v.to_find)
	end
	set_save_marker(package, "save", true, "CTreasureManager")
end

function CTreasureManager:load(package)
	set_save_marker(package, "load", false, "CTreasureManager")
	self.items_spawned = package:r_bool()
	self.items_from_secrets = {}
	local num = package:r_u16()
	for i=1,num do
		local k = package:r_u16()
		local v = package:r_u16()
		self.items_from_secrets[k] = v
	end

	num = package:r_u16()-- +UP
	for i=1,num do
		local id = package:r_u16()
		for k,v in pairs(self.secret_restrs) do
			if(v==id) then
				id = k
				break
			end
		end
		local given = package:r_bool()
		local checked = package:r_bool()
		local to_find = package:r_u8()
		if(id~=65535 and self.secrets[id]) then
			self.secrets[id].given = given
			self.secrets[id].checked = checked
			self.secrets[id].to_find = to_find
			self.secrets[id].prob = 1-- +UP
		end
	end
	set_save_marker(package, "load", true, "CTreasureManager")
end

function CTreasureManager:send_map_locations(gameID)
	for k, v in pairs(self.secrets) do
		if v.given and not v.checked and self.secret_restrs[k] then-- +UP
			level.map_sync_spot(self.secret_restrs[k], "treasure", gameID)
		end
	end
end

function send_map_locations(gameID)
	get_treasure_manager():send_map_locations(gameID)
end

--------------------------------------------------------------------------------
function get_treasure_manager()
	if(treasure_manager==nil) then
		treasure_manager = CTreasureManager()
		treasure_manager:initialize()
	end
	return treasure_manager
end
