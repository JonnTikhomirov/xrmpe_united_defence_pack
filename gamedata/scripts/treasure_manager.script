local treasure_manager = nil
class "CTreasureManager"
function CTreasureManager:__init()
	self.items_spawned = false
	self.check_time = nil
	self.secrets = {}
	self.secret_restrs = {}
	self.items_from_secrets = {}
	-- +UP
	-- level-specific defaults (can be overridden)
	self.level_defaults = {
		chunk_size     = 0,  -- XZ
		chunk_height   = 0,  -- Y
		min_per_chunk  = 0,
		max_per_chunk  = 1,
		max_activated  = 0,  -- global hard cap (0 = no cap)
	}

	self.chunks = nil
	self.use_level_mode = false      -- whether to run chunked/weighted activation
	self.activated_on_level = false
	-- -UP
end
-- +UP
-- helper
local function table_has_value(tbl, value)
	for _, v in ipairs(tbl) do if v == value then return true end end
	return false
end

local function weighted_pick(ids, weights)
	local sum = 0
	for i=1,#weights do sum = sum + weights[i] end
	if sum <= 0 then return nil end

	local r = math.random() * sum
	local acc = 0
	for i=1,#ids do
		acc = acc + weights[i]
		if r <= acc then return ids[i], i end
	end
end

function CTreasureManager:get_level_ini()
	local str = utils.read_file_to_string("$level$", "secrets.ltx")
	
	local ok, ini = true, nil
	if str ~= "" then
		ok, ini = pcall(function()
			return create_ini_file(str)
		end)
	end

	if not ok then
		printf("load_level_file() error: %s", data)
		return nil
	end

	return ini
end

function CTreasureManager:AddItem(secret_id, item_section, spawn_params)
	printf("AddItem: secret_id=%s, item_section=%s, spawn_params=%s", secret_id, item_section, spawn_params)
	
	if not self.secrets[secret_id] then
		self.secrets[secret_id] = { items = {} }
	end
	
	local item_params = self.secrets[secret_id].items[item_section]
	if not item_params then
		item_params = {}
		self.secrets[secret_id].items[item_section] = item_params
	end
	
	-- Разбиваем строку на части по запятым
	local tbl = utils.parse_names(spawn_params)
	
	-- Состояния парсера
	local STATE_SECT = 1
	local STATE_COUNT = 2
	local STATE_PROB = 3
	
	local current_state = STATE_SECT
	local current_item = { sect = item_section, count = 1, prob = 1.0 }
	
	for i = 1, #tbl do
		local value = tbl[i]
		if value ~= nil and value ~= "" then
			value = string.trim(value)
			
			if current_state == STATE_SECT then
				-- Проверяем, является ли значение именем секции или числом (количеством)
				local num_value = tonumber(value)
				
				if num_value == nil then
					-- Это точно имя секции
					if system_ini():section_exist(value) then
						current_item.sect = value
					else
						printf("TreasureManager.AddItem: не найдена секция %s, используем %s", value, item_section)
						current_item.sect = item_section
					end
					current_state = STATE_COUNT
				elseif system_ini():section_exist(value) then
					-- Число, но такая секция существует (редкий случай)
					current_item.sect = value
					current_state = STATE_COUNT
				else
					-- Это число, значит секция не указана, используем default, а это количество
					current_item.sect = item_section
					current_item.count = num_value
					current_state = STATE_PROB
				end
				
			elseif current_state == STATE_COUNT then
				-- Ожидаем количество (обязательный параметр)
				local num_value = tonumber(value)
				if num_value ~= nil then
					current_item.count = math.floor(num_value)
					current_state = STATE_PROB
				else
					printf("TreasureManager.AddItem: ожидалось число (количество), получено: %s", value)
					-- Пропускаем невалидное значение, остаёмся в STATE_COUNT
				end
				
			elseif current_state == STATE_PROB then
				-- Ожидаем вероятность (опциональный параметр)
				local num_value = tonumber(value)
				local save_and_reset = false
				
				if num_value ~= nil then
					-- Проверяем, похоже ли это на вероятность (0-1) или на начало новой записи (количество)
					if num_value >= 0 and num_value <= 1 then
						current_item.prob = num_value
					else
						-- Это похоже на количество для следующей записи
						save_and_reset = true
						-- Начинаем новую запись с этим числом как количеством
						current_item = {
							sect = item_section,
							count = num_value,
							prob = 1.0
						}
						current_state = STATE_PROB -- после количества может идти вероятность
					end
				else
					-- Не число, значит это имя секции для следующей записи
					save_and_reset = true
					-- Начинаем новую запись
					if system_ini():section_exist(value) then
						current_item = {
							sect = value,
							count = 1,
							prob = 1.0
						}
					else
						printf("TreasureManager.AddItem: не найдена секция %s, используем %s", value, item_section)
						current_item = {
							sect = item_section,
							count = 1,
							prob = 1.0
						}
					end
					current_state = STATE_COUNT
				end
				
				if save_and_reset then
					-- Сохраняем предыдущий item
					table.insert(item_params, {
						sect = current_item.sect,
						count = current_item.count,
						prob = current_item.prob
					})
				end
			end
		end
	end
	
	-- Добавляем последний item (если он был заполнен)
	if current_item.count > 0 then
		table.insert(item_params, {
			sect = current_item.sect,
			count = current_item.count,
			prob = current_item.prob
		})
	end
	
	printf("TreasureManager.AddItem: всего добавлено %d записей", #item_params)
	for k, v in ipairs(item_params) do
		printf("  [%d] sect=%s, count=%d, prob=%.2f", k, v.sect, v.count, v.prob)
	end
end
-- +UP

function CTreasureManager:initialize()
	-- +UP
	local ini = self:get_level_ini()
	if ini then
		to_log("TreasureManager: level-файл перекрывает misc")
		self.use_level_mode = true
	else
		ini = ini_file("misc\\secrets.ltx")
	end
	-- пробуем defaults@level
	local defaults_sec = "defaults@"..level.name()
	if not ini:section_exist(defaults_sec) then
		defaults_sec = "defaults"
	end

	if ini:section_exist(defaults_sec) then
		self.level_defaults.chunk_size    = ini:r_float(defaults_sec,"chunk_size")
		self.level_defaults.chunk_height  = ini:r_float(defaults_sec,"chunk_height")
		self.level_defaults.min_per_chunk = ini:r_u32(defaults_sec,"min_per_chunk")
		self.level_defaults.max_per_chunk = ini:r_u32(defaults_sec,"max_per_chunk")
		self.level_defaults.max_activated = ini:r_u32(defaults_sec,"max_activated")
	end
	-- -UP
	local n = ini:line_count("list")
	for i=0,n-1 do
		local result, id, value	= ini:r_line("list",i,"","")
		if(ini:section_exist(id)) then
			self.secrets[id] = {items = {}, given = false, empty = nil, refreshing = false, checked = false, to_find = 0}
			self.secrets[id].prob = to_number(value) or 1-- +UP
					local items_count = ini:line_count(id)
					local item_section = ""
					for i=0,items_count-1 do
							result, item_section, str = ini:r_line(id,i,"","")
				if(item_section=="empty") then
									local parsed_condlist = xr_logic.parse_condlist(nil, "treasure_manager", "empty_cond", str)
					self.secrets[id].empty = parsed_condlist
				elseif(item_section=="refreshing") then
									local parsed_condlist = xr_logic.parse_condlist(nil, "treasure_manager", "refreshing_cond", str)
					self.secrets[id].refreshing = parsed_condlist
				else
					-- +UP
					-- 				self.secrets[id].items[item_section] = {}
					-- 				local tbl = utils.parse_spawns(str)
					-- 				if(#tbl==0) then
					-- 						abort("There is no items count set for treasure [%s], item [%s]", id, item_section)
					-- 				end
					-- for i=1,#tbl do
					-- 	local tbl = {count = to_number(tbl[i].section), prob = to_number(tbl[i].prob or 1)}
					-- 	table.insert(self.secrets[id].items[item_section], tbl)
					-- end
					self:AddItem(id, item_section, str)
					-- -UP
				end
			end
		else
			abort("There is no section [%s] in secrets.ltx", tostring(id))
		end
	end
end

function CTreasureManager:fill(se_obj, treasure_id)
	if(self.secrets[treasure_id]) then
		local item = self.secrets[treasure_id].items[se_obj:section_name()]
		if(item) then
			for i=1,#item do
							if not(item[i].item_ids) then
									item[i].item_ids = {}
							end
				local count = #item[i].item_ids
				if(count<item[i].count) then
					item[i].item_ids[count+1] = se_obj.id
					return true
				end
			end
		else
			printf("Attempt to register unknown item [%s] in secret [%s]", se_obj:section_name(), treasure_id)-- +UP
		end
	else
		printf("Attempt to register item [%s] in unexistent secret [%s]", se_obj:name(), treasure_id)-- +UP
	end
	return false -- +UP
end

function CTreasureManager:register_item(se_obj)
	-- +UP
	if se_obj:name() == nil or se_obj:name() == "" then
		return false
	end
	--UP
	local spawn_ini = se_obj:spawn_ini()
	if(spawn_ini:section_exist("secret")) then
		local result, id, value
		result, id, value	= spawn_ini:r_line("secret",0,"","")
		if id ~= "name" then
			printf("There is no 'name' field in [secret] section for object [%s]", se_obj:name())-- +UP
		else--end-- +UP
		if value == "" then
				printf("Field 'name' in [secret] section got no value for object [%s]", se_obj:name())-- +UP
			else-- +UP
				return self:fill(se_obj, value)-- +UP
			end
		end-- +UP
	end
	return false -- +UP
end

function CTreasureManager:register_restrictor(se_obj)
	local spawn_ini = se_obj:spawn_ini()
	if(spawn_ini:section_exist("secret")) then
		self.secret_restrs[se_obj:name()] = se_obj.id
	end
end
-- +UP
function CTreasureManager:build_chunks()
	local size = self.level_defaults.chunk_size
	local height = self.level_defaults.chunk_height
	local chunks = {}

	if size <= 0 then
		chunks["__global__"] = { secrets = {} }
		for id in pairs(self.secrets) do
			table.insert(chunks["__global__"].secrets, id)
		end
		return chunks
	end

	for id,v in pairs(self.secrets) do
		if v.items and not empty(v.items) then
			local rid = self.secret_restrs[id]
			if rid then
				local o = alife():object(rid)
				if o then
					local p = o.position
					local cx = math.floor(p.x / size)
					local cz = math.floor(p.z / size)
					local cy = (height > 0) and math.floor(p.y / height) or 0
					local key = cx..":"..cy..":"..cz
					chunks[key] = chunks[key] or { secrets = {} }
					table.insert(chunks[key].secrets, id)
				end
			else
				printf("treasure restrictor %s not found!", id)
			end
		end
	end

	return chunks
end

-- activation pipeline: only runs when use_level_mode==true
function CTreasureManager:activate_level_secrets()
	if not self.use_level_mode or self.activated_on_level then return end
	to_log("CTreasureManager:activate_level_secrets()")-- TODO: убрать лог
	local chunks = self:build_chunks()
	local activated = {}
	printf("TreasureManager:activate_level_secrets() chunks")-- TODO: убрать лог
	print_table(chunks)-- TODO: убрать лог
	for _,chunk in pairs(chunks) do
		local ids, weights = {}, {}
		for _,id in ipairs(chunk.secrets) do
			local p = self.secrets[id].prob
			if p > 0 then
				table.insert(ids, id)
				table.insert(weights, p)
			end
		end

		local maxp = self.level_defaults.max_per_chunk
		local selected = {}

		while #selected < maxp and #ids > 0 do
			local id, idx = weighted_pick(ids, weights)
			if not id then break end
			table.insert(selected, id)
			table.remove(ids, idx)
			table.remove(weights, idx)
		end

		-- добор до минимума БЕЗ учета шанса
		local minp = self.level_defaults.min_per_chunk
		if minp > #selected then
			for _,id in ipairs(chunk.secrets) do
				if #selected >= minp then break end
				if not table_has_value(selected, id) then
					table.insert(selected, id)
				end
			end
		end

		for _,id in ipairs(selected) do
			table.insert(activated, id)
		end
	end

	if self.level_defaults.max_activated > 0 then
		while #activated > self.level_defaults.max_activated do
			table.remove(activated, math.random(#activated))
		end
	end

	for _,id in ipairs(activated) do
		self:spawn_treasure(id)
	end
	to_log("TreasureManager:activate_level_secrets: items_from_secrets")
	table.print(self.items_from_secrets)
	to_log("TreasureManager:activate_level_secrets: secret_restrs")
	table.print(self.secret_restrs)
	self.activated_on_level = true
end
-- -UP

function CTreasureManager:update()
	if not(self.items_spawned) then
		if not self.use_level_mode then-- +UP
			for k,v in pairs(self.secrets) do
				self:spawn_treasure(k)
			end
			self.items_spawned = true
		end-- +UP
	end
	-- +UP
	if self.use_level_mode and not self.activated_on_level then
		self:activate_level_secrets()
		to_log("TreasureManager:activate_level_secrets: secrets")
		table.print(self.secrets)
		self.items_spawned = true
	end
	-- -UP
	local global_time = time_global()
	if(self.check_time and global_time-self.check_time<=500) then
		return
	end
	self.check_time = global_time

	for k,v in pairs(self.secrets) do
		if(v.given) then
			if(v.empty) then
				local sect = xr_logic.pick_section_from_condlist(db.actor, nil, v.empty)
				if (sect=="true") and not v.checked then
					if self.secret_restrs[k] then-- +UP
						level.map_remove_object_spot(self.secret_restrs[k], "treasure")
					end-- +UP
					if db.mp_actors then-- +UP
						for kk,vv in pairs(db.mp_actors) do-- +UP
							xr_statistic.inc_founded_secrets_counter(vv:id())-- +UP
						end
					end-- +UP
					v.empty = nil
					v.checked = true
					printf("Empty secret [%s] remove map spot!", k)
				end
			elseif (v.refreshing and v.checked) then
				local sect = xr_logic.pick_section_from_condlist(db.actor, nil, v.refreshing)
				if (sect=="true") then
					v.given = false
					v.checked = false
					printf("Given secret [%s] now is avaliable!", k)
				end
			end
		end
	end
end

-- +UP
function CTreasureManager:spawn_treasure(treasure_id)
	if not(self.secrets[treasure_id]) then
		abort("There is no stored secret [%s]", tostring(treasure_id))
	end
	
	if(self.secrets[treasure_id].given) then
		printf("Secret [%s] already given!", treasure_id)
		return
	end
	
	-- Проходим по всем группам предметов
	for item_section, item_params in pairs(self.secrets[treasure_id].items) do
		for num = 1, #item_params do
			-- Проверяем вероятность выпадения для данной записи
			local prob = math.random()
			local record = item_params[num]
			
			if(prob < (record.prob or 1)) then
				-- Спавним указанное количество предметов
				for i = 1, record.count do
					-- Используем секцию из распарсенных параметров (record.sect), 
					-- а не item_section из внешнего цикла
					local spawn_sect = record.sect or item_section
					
					if(record.item_ids and record.item_ids[i]) then
						local se_obj = alife():object(record.item_ids[i])
						if se_obj then
							local obj = alife():create(
								spawn_sect,
								se_obj.position,
								se_obj.m_level_vertex_id,
								se_obj.m_game_vertex_id
							)
							
							if obj then
								obj.angle = se_obj.angle
								if obj.use_ai_locations and se_obj.used_ai_locations then
									obj:use_ai_locations(se_obj:used_ai_locations())
								end
								self.items_from_secrets[obj.id] = self.secret_restrs[treasure_id]
								self.secrets[treasure_id].to_find = self.secrets[treasure_id].to_find + 1
							end
						end
					else
						printf("spawn_treasure() not item_ids, id=%s, item_section=%s, record_sect=%s", 
							treasure_id, item_section, spawn_sect)
					end
				end
			end
		end
	end
end
-- -UP

function CTreasureManager:give_treasure(treasure_id, spawn)
	if not(self.secrets[treasure_id]) then
		abort("There is no stored secret [%s]", tostring(treasure_id))
	end
	if(self.secrets[treasure_id].given) then
		printf("Secret [%s] already given!", treasure_id)
		return
	end
	if(self.secrets[treasure_id].to_find==0 and not(self.secrets[treasure_id].empty)) then
		news_manager.send_treasure(2)
		printf("Secret [%s] already empty", treasure_id)
		return
	end
	if(spawn) then
		self:spawn_treasure(treasure_id)
	end
	if self.secret_restrs[treasure_id] then-- +UP
		level.map_add_object_spot_ser(self.secret_restrs[treasure_id], "treasure", "")
		level.map_sync_spot(self.secret_restrs[treasure_id], "treasure", SV_OBJECT_ID) -- SV_OBJECT_ID means send to all clients
	end-- +UP
	self.secrets[treasure_id].given = true
	news_manager.send_treasure(0)
	--printf_msg("Give secret [%s]", treasure_id)
end

function CTreasureManager:give_random()
	local rnd_tbl = {}
	for k,v in pairs(self.secrets) do
				if not(v.given) then
			table.insert(rnd_tbl, k)
				end
	end
	if(#rnd_tbl~=0) then
		self:give_treasure(rnd_tbl[math.random(1,#rnd_tbl)])
		return
	end
	printf("There are no treasures avaliable!")
end

function CTreasureManager:on_item_take(obj_id)
	to_log("TreasureManager:on_item_take: obj_id=%s", obj_id)-- TODO: убрать лог
	local restr_id = self.items_from_secrets[obj_id]
	local treasure_id = nil
	for k,v in pairs(self.secret_restrs) do
		if(restr_id==v) then
			treasure_id = k
			break-- +UP
		end
	end
	if(treasure_id) then
		to_log("TreasureManager: treasure_id=%s", treasure_id)-- TODO: убрать лог
		self.secrets[treasure_id].to_find = self.secrets[treasure_id].to_find - 1
		if(self.secrets[treasure_id].to_find==0) then
			to_log("TreasureManager:to_find==0: treasure_id=%s", treasure_id)-- TODO: убрать лог
			if self.secret_restrs[treasure_id] then-- +UP
				level.map_remove_object_spot(self.secret_restrs[treasure_id], "treasure")
			end-- +UP
			if db.mp_actors then-- +UP
				for k,v in pairs(db.mp_actors) do
					xr_statistic.inc_founded_secrets_counter(v:id())
				end
			end-- +UP
			--printf_msg("Secret [%s] now is empty!", treasure_id)
			self.secrets[treasure_id].checked = true
			news_manager.send_treasure(1)
		end
		self.items_from_secrets[obj_id] = nil
	end
end

function CTreasureManager:save(package)
	set_save_marker(package, "save", false, "CTreasureManager")
	package:w_bool(self.items_spawned)
	local num = 0
	for k,v in pairs(self.items_from_secrets) do
		num = num + 1
	end
	package:w_u16(num)
	for k,v in pairs(self.items_from_secrets) do
		package:w_u16(k)
		package:w_u16(v)
	end

	num = 0
	for k,v in pairs(self.secrets) do
		num = num + 1
	end
	package:w_u16(num)
	for k,v in pairs(self.secrets) do
		if not(self.secret_restrs[k]) then
			package:w_u16(-1)
		else
			package:w_u16(self.secret_restrs[k])
		end
		package:w_bool(v.given)
		package:w_bool(v.checked)
		package:w_u8(v.to_find)
	end
	set_save_marker(package, "save", true, "CTreasureManager")
end

function CTreasureManager:load(package)
	set_save_marker(package, "load", false, "CTreasureManager")
	self.items_spawned = package:r_bool()
	self.items_from_secrets = {}
	local num = package:r_u16()
	for i=1,num do
		local k = package:r_u16()
		local v = package:r_u16()
		self.items_from_secrets[k] = v
	end

	num = package:r_u16()-- +UP
	for i=1,num do
		local id = package:r_u16()
		for k,v in pairs(self.secret_restrs) do
			if(v==id) then
				id = k
				break
			end
		end
		local given = package:r_bool()
		local checked = package:r_bool()
		local to_find = package:r_u8()
		if(id~=65535 and self.secrets[id]) then
			self.secrets[id].given = given
			self.secrets[id].checked = checked
			self.secrets[id].to_find = to_find
			self.secrets[id].prob = 1-- +UP
		end
	end
	set_save_marker(package, "load", true, "CTreasureManager")
end

function CTreasureManager:send_map_locations(gameID)
	for k, v in pairs(self.secrets) do
		if v.given and not v.checked and self.secret_restrs[k] then-- +UP
			level.map_sync_spot(self.secret_restrs[k], "treasure", gameID)
		end
	end
end

function send_map_locations(gameID)
	get_treasure_manager():send_map_locations(gameID)
end

--------------------------------------------------------------------------------
function get_treasure_manager()
	if(treasure_manager==nil) then
		treasure_manager = CTreasureManager()
		treasure_manager:initialize()
	end
	return treasure_manager
end
