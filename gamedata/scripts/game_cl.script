--	end
--end

function give_task(task_id, status)
	if getLocalActor() then
		local t = getLocalActor():get_task(tostring(task_id), true)
		if t then
			return
		end
	end

	task_manager.get_task_manager():give_task(task_id, status)
end

function set_task_finish_time(task_id, y, m, d, h, mi, s, ms)
	--printf_msg("set_task_finish_time called %s %s %s %s %s", tostring(y), tostring(m), tostring(d), tostring(h), tostring(mi))
	local task = task_manager.get_task_manager():get_task(task_id)
	if task ~= nil then
		local _time = game.CTime()
		_time:set(y, m, d, h, mi, s, ms)
		task:set_finish_time(_time)
	end
end

function complete_generic()
	local actor = db.storage[LocalActor()].object
	actor:disable_info_portion("xrmpe_ow_generic_update")
	actor:give_info_portion("xrmpe_ow_generic_complete")
	actor:give_info_portion("xrmpe_openworld_has_cooldown")
end

function executeFunctionOnServer(funcName)
	local packet = net_packet()
	packet:w_begin(19)--M_GAMEMESSAGE
	packet:w_u16(55)--GAME_EVENT_EXECUTE_SCRIPT_FUNC
	packet:w_stringZ(funcName)
	packet:w_u16(LocalActor())
	printf_msg(funcName)
	u_EventSend(packet);
end