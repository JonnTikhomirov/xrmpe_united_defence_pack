-- +UP
function campfire_turn(actor, button, p)

	if not button then
		to_log("campfire_turn: button is nil")
		return
	end
	local base = button:name():match("^(.-)_button")
	if not base then
		to_log("campfire_turn: wrong button name %s", button:name())
		return
	end
	if p ~= nil then
		p = string.toboolean(p[1])
	end
	bind_campfire.turn(actor, base, p)
end

-- кладет предмет в ящики как лут обороны
function df_loot(actor, npc, p)
	
	local item = p[1]
	local count = p[2] or 1
	local prob = p[3] or 1
	local ignore_players = p[4] or false

	if type(ignore_players) == "string" then
		ignore_players = string.toboolean(ignore_players)
	end
	
	if type(night_only) == "string" then
		night_only = string.toboolean(night_only)
	end
	
	if type(item) ~= "string" then
		to_log("df_loot: item is not string")
		return
	end
	if not system_ini():section_exist(item) then
		to_log("df_loot: section %s not found", item)
		return
	end

	if count < 1 then
		return
	end

	if ignore_players ~= true then
		count = count * (get_players_count() - 1)
	end
	
	boxes_id = treasure_manager.get_treasure_manager().inventory_boxes_id

	if #boxes_id == 0 then
		return
	end

	local last_box_index = 0
	for i=1, count do
		if math.random() < prob then
			local box_index = math.random(1, #boxes_id)
			if box_index == last_box_index and #boxes_id > 1 then
				box_index = box_index + 1
				if box_index > #boxes_id then
					box_index = 1
				end
			end
			local box_id = boxes_id[box_index]
			to_log("df_loot: create %s %s %s", item, count, box_id)
			alife():create(item,vector(),0,0,box_id)
		end
	end
end

function arena_spawn(actor, npc, p)
	local manager = arena_manager.get_manager()
	if manager == nil then
		to_log("arena_spawn: manager is nil")
		return
	end

	--' p[2] - имя патрульного пути где спа унить.
	local rank = p[1]
	if rank == nil then
		abort("Wrong rank for 'arena_spawn'")
	end

	local index = p[2]
	if index == nil then
		abort("Wrong path index for 'arena_spawn' function %s", tostring(path_name))
	end

	manager:spawn_enemy(rank, index)
end

function arena_reload(actor, npc, p)
	local manager = arena_manager.get_manager()
	if manager == nil then
		to_log("arena_reload: manager is nil")
		return
	end
	manager:reload(p)
end

function arena_set_actors_respawn_items(actor, npc, p)
	local manager = arena_manager.get_manager()
	if manager == nil then
		to_log("arena_reload: manager is nil")
		return
	end
	manager:set_actors_respawn_items(p)
end

function arena_on_enemy_death(actor, npc, p)
	local manager = arena_manager.get_manager()
	if manager == nil then
		to_log("arena_on_enemy_death: manager is nil")
		return
	end
	manager:on_enemy_death(npc)
end

function send_tip_temiout(actor, npc, p)
	news_manager.send_tip(actor, p[1], nil, p[2], p[4], p[3])
end

function spawn_to_all_players(actor, npc, p)
	local section = p[1]
	if section == nil then
		to_log("spawn_to_all_players: section is null")
		return
	end
	
	local count = p[2] or 1
	if count == nil then
		to_log("spawn_to_all_players: Wrong count")
		return
	end

	if not alife() then
		to_log("spawn_to_all_players: No alife")
		return
	end

	for v in alife():actors() do
		for i=1, count do
			alife():create(section, vector(), 0, 0, v.id)
		end
	end
end

function make_nearest_actor_visible_to_npc(actor,npc,p)
	local mp_actor = getNearestActor(npc)
	if mp_actor == nil then
		return
	end
	npc:make_object_visible_somewhen(mp_actor)
end

function play_particle_at_npc(actor, npc, p)
	local name = p[1]
	if name == nil or name == "" then
		abort("Wrong particle name for 'play_particle_at_npc'")
	end

	local bone = p[2] or ""

	if OnServer() then
		local packet = game_cl.GenerateGameMessage(GM_SCRIPT_PLAY_PARTICLE)
		packet:w_stringZ(name)
		packet:w_u16(npc:id())
		packet:w_stringZ(bone)
		u_EventSendReliable(packet)	
		return nil
	else
		local pos = npc:position()
		if bone ~= "" then
			pos = npc:bone_position(bone)
		end
		local prtcle = utils.play_particle(name, pos)
		local st = db.storage[npc:id()]
		st.particles = st.particles or {}
		table.insert(st.particles, { prtcle, bone })
		return prtcle
	end
end

function heli_say(actor, npc, p)
	for _, v in ipairs(p) do
		if v == nil or v == "" then
			to_log("Wrong sound for 'heli_say'")
		else
			bind_heli.heli_say(npc, v)
		end
	end
end

function heli_stop_say(actor, npc, p)
	bind_heli.heli_stop_say(npc)
end

function stop_sound_by_story(actor, obj, p)
	xr_sound.stop_sounds_by_id(get_story_object_id(p[1]))
end

-- +SP
-- Респавн игроков без жизней
function rs_dead_players()
    game.respawn_dead_players()
end

function send_msg(actor, npc, p)
    news_manager.send_tip(db.actor, p[1], nil, "leader", nil, nil)
end