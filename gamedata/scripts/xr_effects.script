--'-----------------------------------------------------------------------------------
--' Quest support
--'-----------------------------------------------------------------------------------
function give_task(actor, obj, p)
	if p[1] == nil then
		abort("No parameter in give_task function.")
	end
		
	if OnServer() then
		for k, v in pairs(db.mp_actors) do
			--printf_msg("give_task %s", tostring(p[1]))
			if not IsAllClientsConnectedToActors() then
				client_tasks.add_delayed_task(p[1])
			else
				client_tasks.give_task_to_client(p[1], v:id())
			end
			return
		end
	end
	if IsLocalPlayerSpectator() then
		return
	end
	
	local t = getLocalActor():get_task(tostring(p[1]), true)
	if t then
		return
	end
	
	client_tasks.give_task_to_client(p[1])
end

function set_active_task(actor, npc, p)
	if(p[1]) then
		local t = getLocalActor():get_task(tostring(p[1]), true)
		if(t) then
			getLocalActor():set_active_task(t)
		end
	end
end

-- Функции для работы с отношениями

function actor_friend(actor, npc)
	for k,v in pairs(db.mp_actors) do
		npc:force_set_goodwill(1000, v)
	end
end

function actor_neutral(actor, npc)
	for k,v in pairs(db.mp_actors) do
		npc:force_set_goodwill(0, v)
	end
end

function actor_enemy(actor, npc)
	for k,v in pairs(db.mp_actors) do
		npc:force_set_goodwill(-1000, v)
	end
end

function set_squad_neutral_to_actor(actor, npc, p)
	local squad_story_id = p[1]
	
	if OnClient() then
		local packet = net_packet()
		u_EventGen(packet, 145, LocalActor()) --GE_SCRIPT_CHANGE_SQUAD_GOODWILL_TO_ACTOR
		packet:w_stringZ(squad_story_id)
		packet:w_u8(1) --neutral
		u_EventSend(packet)
		return
	end
	
	local squad = get_story_squad(squad_story_id)
	if squad == nil then
		--printf("There is no squad with id[%s]", tostring(squad_story_id))
		return
	end
	
	local actor_sid = p[2]
	if actor_sid ~= nil then
		squad:set_squad_relation_by_sid("neutral")
	else
		squad:set_squad_relation("neutral")
	end
end

