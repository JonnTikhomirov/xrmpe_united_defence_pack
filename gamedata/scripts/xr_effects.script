		local packet = game_cl.GenerateGameMessage(GM_SCRIPT_ANIM_OBJECT)
		packet:w_u8(1) -- backward
		packet:w_stringZ(p[1])
		u_EventSendReliable(packet)
	end
end

function anim_obj_backward_impl(actor, npc, p)
	if p[1] ~= nil then
		db.anim_obj_by_name[p[1]]:anim_backward()
	end
end

function anim_obj_stop(actor, npc, p)
	if OnServer() and p[1] ~= nil then
		local packet = game_cl.GenerateGameMessage(GM_SCRIPT_ANIM_OBJECT)
		packet:w_u8(2) -- stop
		packet:w_stringZ(p[1])
		u_EventSendReliable(packet)
	end
end

function anim_obj_stop_impl(actor, npc, p)
	if p[1] ~= nil then
		db.anim_obj_by_name[p[1]]:anim_stop()
	end
end

