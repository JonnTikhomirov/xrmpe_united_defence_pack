function inc_faction_goodwill_to_actor(actor, npc, p)
	local community = p[1]
	local delta		= p[2]
	if delta and community then
		for k,v in pairs(db.mp_actors) do
			game_relations.change_factions_community_num(community,v:id(), tonumber(delta))
		end
		
		game_relations.change_factions_community_num(community,db.actor:id(), tonumber(delta))
	else
		abort("Wrong parameters in function 'inc_faction_goodwill_to_actor'")
	end
end

function dec_faction_goodwill_to_actor(actor, npc, p)
	local community = p[1]
	local delta		= p[2]
	if delta and community then
		for k,v in pairs(db.mp_actors) do
			game_relations.change_factions_community_num(community,v:id(), -tonumber(delta))
		end
		
		game_relations.change_factions_community_num(community,db.actor:id(), -tonumber(delta))
	else
		abort("Wrong parameters in function 'dec_faction_goodwill_to_actor'")
	end
end


