--Отключение воздействия вражеского нпс на индикатор видимости врага на хаде игрока.
--Исп. только из логики нпс.
function set_visual_memory_enabled(actor, npc, p)
	if (p and p[1]) and (tonumber(p[1]) >= 0) and (tonumber(p[1]) <= 1) then
		local boolval = false
		if (tonumber(p[1]) == 1) then
			boolval = true
		end
		npc:set_visual_memory_enabled(boolval)
	end
end

function disable_memory_object (actor, npc)
	local best_enemy = npc:best_enemy()
	if best_enemy then
		npc:enable_memory_object(best_enemy, false)
	end
end

function set_monster_animation (actor, npc, p)
	if not (p and p[1]) then
		abort("Wrong parameters in function 'set_monster_animation'!!!")
	end
	npc:set_override_animation (p[1])
end

function clear_monster_animation (actor, npc)
	npc:clear_override_animation ()
end

function upgrade_hint(actor, npc, p)
	if(p) then
		inventory_upgrades.cur_hint = p
	end
end

function force_obj(actor, npc, p)
	local obj = get_story_object(p[1])
	if not obj then
		abort("'force_obj' Target object does not exist")
		return
	end
	if p[2] == nil then p[2] = 20 end
	if p[3] == nil then p[3] = 100 end
	obj:set_const_force(vector():set(0,1,0), p[2], p[3])
end

--xrmpe stuff starts here
function kill_me(actor, obj, p)
	get_console():execute("g_kill")
end

function xrmpe_set_cam(actor, npc, p)
	if p[1] == 1 then
		set_first_person()
	else
		set_third_person()
	end
end

function xrmpe_enable_input(actor, npc, p)
	if p[1] == nil then
		return
	end
	set_enable_input_for_actor(p[1])
end

function xrmpe_teleport_local_actor(actor, npc, p)
	if IsDedicatedServer() then
		return
	end
	
	if p[1] == nil then
		return
	end
	
	local obj = db.mp_actors[LocalActor()]
	
	if obj ~= nil then  	
		local pos = patrol(p[1]):point(0)
		teleport_local_actor(pos, obj:direction())
	end
end

function xrmpe_teleport_actor_story(actor, npc, p)
	if OnClient() then
		return
	end
	
	if p[1] == nil then
		return
	end
	
	if p[2] == nil then
		return
	end
	
	local story_id = p[1]
	local actor_target = get_story_object(story_id)
	
	if actor_target == nil then
		return
	end
	
	local pos = patrol(p[2]):point(0)
	local look_name = p[3]
	
	local look = actor_target:position()
	if look_name ~= nil then
		look = patrol(look_name):point(0)
	end
	local dir = vector():sub( look, pos )	
	teleport_actor_sv(actor_target:id(), pos, dir)
end

function xrmpe_teleport_actors(actor, npc, p)
	if OnClient() then
		return
	end

	if p[1] == nil then
		return
	end
		
	local pos = patrol(p[1]):point(0)
	local look_name = p[2]

	for k,v in pairs(db.mp_actors) do
		local look = v:position()
		if look_name ~= nil then
			look = patrol(look_name):point(0)
		end
		local dir = vector():sub( look, pos )	
		teleport_actor_sv(v:id(), pos, dir)
	end
end

function xrmpe_teleport_relevant_actors(actor, npc, p)
	if OnClient() then
		return
	end

	if p[1] == nil or p[2] == nil then
		return
	end
	
	local relevantPos = vector()
	local story_id = p[1]
	local story_squad = get_story_squad(story_id)
	if story_squad == nil then
		local story_obj_id = get_story_object_id(story_id)
		local sv_obj = alife():object(story_obj_id)
		if sv_obj == nil then
			--printf_msg("! Can't teleport relevant actors to %s", tostring(story_id))
			return
		end
		relevantPos:set(sv_obj.position.x, sv_obj.position.y, sv_obj.position.z)
	else
		relevantPos:set(story_squad.position.x, story_squad.position.y, story_squad.position.z)
	end
	
	local relevantDist = 70
	local look_name
	if type(p[3]) == "number" or type(p[4]) == "string" then
		relevantDist = p[3] or 70
		look_name = p[4]
	elseif type(p[4]) == "number" or type(p[3]) == "string" then
		relevantDist = p[4] or 70
		look_name = p[3]
	end
	
	local pos = patrol(p[2]):point(0)	
	for k,v in pairs(db.mp_actors) do
		if v:position():distance_to_sqr(relevantPos) <= relevantDist * relevantDist then
			local look = v:position()
			if look_name ~= nil then
				look = patrol(look_name):point(0)
			end
			local dir = vector():sub( look, pos )			
			teleport_actor_sv(v:id(), pos, dir)
		end
	end
end

function xrmpe_set_script_anim(actor, npc, p)
	if p[1] == nil then
		return
	end	
	
	if p[2] ~= nil then
		local pos = patrol(p[2]):point(0)
		teleport_local_actor(pos, db.storage[LocalActor()].object:direction())
	end
	
	set_script_anim(p[1])
end


function xrmpe_set_timefactor(actor, npc, p)
	if p[1] == nil then
		return
	end	
	
	get_console():execute("time_factor "..tostring(p[1]))
end

function xrmpe_launch_rockets(actor, npc, p)
	if OnServer() then
		return
	end
	for k,v in pairs(db.signal_light) do
		if not(v:is_flying()) then
			v:launch()
		end
	end
end

function xrmpe_launch_signal_rocket(actor, npc, p)
    local obj_name = p[1]
    local light = db.signal_light[obj_name]
    
    if light ~= nil then
        light:launch()
    end    
end

function xrmpe_remove_df_cassette(actor, npc, p)
	local item = "cassette_yellow"
	
	for k, v in pairs(db.mp_actors) do
		local obj = v:object(item)
		if obj ~= nil then
			alife():release(alife():object(obj:id()), true)
		end
	end
end

function xrmpe_client_spawn(actor, npc, p)
--ванильный spawn_object не отсылает ивент клиентам о спавне объекта
--эта реализация взята из мультиплеерного режима
	local sect_name = p[1]	
	local yaw = p[3] or 0
	local index = p[4] or 0
	
	local pos = patrol(p[2]):point(index)
	local dir = vector():set(0, yaw * math.pi / 180, 0)
	
	spawnEntity(sect_name, pos, dir)
end

function xrmpe_client_spawn_vertex(actor, npc, p)
	local sect_name = p[1]
	local _patrol = patrol(p[2])
	local pos = _patrol:point(0)

	local dir = vector():set(0, 0, 0)
	if p[3] ~= nil then
		dir = p[3]
	end
	alife():create(sect_name, pos, _patrol:level_vertex_id(0), _patrol:game_vertex_id(0))
end

function isPlayersMoreThanOne(actor, npc)
  return get_players_count() > 1
end

function set_anim_to_last_frame(actor, npc, p)
	if p[1] == nil then
		return
	end
	local anim_object = get_story_object(p[1])
	if anim_object ~= nil then
		local physic_object = anim_object:get_physics_object()
		if physic_object ~= nil then
			local anim_length = physic_object:anim_length_get()
			if anim_length > 0 then
				physic_object:anim_time_set(anim_length)
			end
		end
	end
end

function playVoiceLine(actor, npc, p)
	xr_voicedialogs.start_dialog(p[1], p[2], p[3])
end

function defenceAddToExclude(actor, npc)
	df_add_exclude_id(npc:id())
end



