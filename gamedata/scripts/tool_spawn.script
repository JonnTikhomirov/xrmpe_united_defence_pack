	--to_log(sModule..":> InitControls") --/#~#

	-- список категорий слева
	self.group_list = xml:InitListBox("frame_left_spawn:group_list", owner.frame_left)
	self.group_list:ShowSelectedItem(true)
	owner:Register(self.group_list, "spawn_group_list")

	-- список записей справа (все подразделы, кроме отрядов)
	self.section_frame = xml:InitFrame("frame_right_spawn:section_frame", owner.frame_right)
