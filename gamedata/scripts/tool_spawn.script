-- Спавним патроны
function spawn:SpawnAmmo(section, number, npc_id, pos, lvid, gvid, drop)
	if number <= 0 then return end
	local sini = system_ini()
	if not sini:line_exist(section, "box_size") then
		self:SpawnItems(section, number, npc_id, pos, lvid, gvid)
		return
	end
	local boxSize = sini:r_u32(section, "box_size")
	-- local t = se_respawn.create_ammo(section, pos, lvid, gvid, npc_id, number*boxSize)-- +UP
	rc.cl_spawn_ammo(section, pos, lvid, gvid, npc_id, number*boxSize)-- +UP
	if drop then -- для варианта спавна через инвентарь с выбросом на землю (не используется в настоящее время)
		for _, v in ipairs(t) do
			-- + UP
			-- level.client_spawn_manager():add(v.id, 65535, function (id, obj) db.actor:drop_item(obj) end)
			level.client_spawn_manager():add(v.id, 65535, function (id, obj) getLocalActor():drop_item(obj) end)
			-- - UP
		end
	end
end
