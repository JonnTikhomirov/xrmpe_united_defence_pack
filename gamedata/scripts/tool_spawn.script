-- инициализация событий
function spawn:InitCallbacks(owner)
	--to_log(sModule..":> InitCallbacks") --/#~#
	owner:AddCallback("spawn_group_list", ui_events.LIST_ITEM_CLICKED, self.OnGroupListItemClicked, self)
--[[ -- для CoP пока скрываем
	owner:AddCallback("spawn_btn_select_nearest", ui_events.BUTTON_CLICKED, self.OnBtnSelectNearestSmart, self)
--]]
	owner:AddCallback("spawn_textbox_find_squad", ui_events.EDIT_TEXT_COMMIT, self.OnBtnFindSquad, self)
	owner:AddCallback("spawn_btn_find_squad", ui_events.BUTTON_CLICKED, self.OnBtnFindSquad, self)
	owner:AddCallback("spawn_textbox_find_smart", ui_events.EDIT_TEXT_COMMIT, self.OnBtnFindSmart, self)
	owner:AddCallback("spawn_btn_find_smart", ui_events.BUTTON_CLICKED, self.OnBtnFindSmart, self)
	owner:AddCallback("spawn_textbox_find", ui_events.EDIT_TEXT_COMMIT, self.OnBtnFind, self)
	owner:AddCallback("spawn_btn_find", ui_events.BUTTON_CLICKED, self.OnBtnFind, self)
	owner:AddCallback("spawn_btn_current", ui_events.BUTTON_CLICKED, self.OnBtnCurrent, self)
	owner:AddCallback("spawn_checkbox_mode", ui_events.BUTTON_CLICKED, self.OnCheckboxModeClick, self)
	owner:AddCallback("spawn_checkbox_mode_2", ui_events.BUTTON_CLICKED, self.OnCheckboxMode2Click, self)
	owner:AddCallback("spawn_btn_count_plus", ui_events.BUTTON_CLICKED, self.OnBtnCountPlus, self)
	owner:AddCallback("spawn_btn_count_minus", ui_events.BUTTON_CLICKED, self.OnBtnCountMinus, self)
	owner:AddCallback("spawn_btn_spawn", ui_events.BUTTON_CLICKED, self.OnBtnSpawn, self)
	owner:AddCallback("spawn_btn_shift_plus", ui_events.BUTTON_CLICKED, self.OnBtnShiftPlus, self)
	owner:AddCallback("spawn_btn_shift_minus", ui_events.BUTTON_CLICKED, self.OnBtnShiftMinus, self)
	owner:AddCallback("spawn_btn_shift_left", ui_events.BUTTON_CLICKED, self.OnBtnShiftLeft, self)
	owner:AddCallback("spawn_btn_shift_forward", ui_events.BUTTON_CLICKED, self.OnBtnShiftForward, self)
	owner:AddCallback("spawn_btn_shift_back", ui_events.BUTTON_CLICKED, self.OnBtnShiftBack, self)
	owner:AddCallback("spawn_btn_shift_right", ui_events.BUTTON_CLICKED, self.OnBtnShiftRight, self)
	owner:AddCallback("spawn_btn_continue", ui_events.BUTTON_CLICKED, self.OnBtnContinue, self)
	owner:AddCallback("spawn_btn_cancel", ui_events.BUTTON_CLICKED, self.OnBtnCancel, self)

	owner:AddCallback("spawn_section_list", ui_events.WINDOW_LBUTTON_DB_CLICK, self.OnBtnSpawn, self)-- +UP
end

-- подготовка данных при загрузке (объекты недоступны)
function spawn:PrepareData(ltx)
	--to_log(sModule..":> PrepareData start")
	local iCntGroups, iCntSections = 0, 0
	local trim, sini = string.trim, system_ini()
	local squad_caption = game.translate_string("tool_spawn_squad_caption").." "
	self.tSpawnSections = {}

	--/ чтение групп спавна
	local groups = Get_IniSection(ltx, "spawn_groups", "table", "key2num")
	for i = 1, #groups do
		local group = groups[i]
		local group_id = trim(group[1])
		iCntGroups = iCntGroups + 1
		table.insert(self.tSpawnGroups, { id = group_id, name = game.translate_string("tool_spawn_group_"..group_id), mode = trim(group[2]) })

		--/ чтение секций спавна
		if group_id == "squads" then
			-- чтение из штатных конфигов
			-- +UP поиск по вложенным папкам без строки в fsgame почему то ломает VPS и ui файлы не читаются
			--local flist = self.owner_script.GetFilesList(self.sSquadsConfigRoot, "squad*.ltx", FS.FS_ListFiles + FS.FS_RootOnly)
			--for _,v in ipairs(flist) do
				--local data = self.owner_script.ParseLtx(v.filename)
			flist= {
				{ filepath = "misc\\squad_descr.ltx" },
				{ filepath = "misc\\squad_descr_df_catacomb.ltx" },
				{ filepath = "misc\\squad_descr_df_prost_anom.ltx" },
				{ filepath = "misc\\squad_descr_df_zastava.ltx" },
				{ filepath = "misc\\squad_descr_xrmpe_test.ltx" },
			}
			-- -UP
			for _,v in ipairs(flist) do
				local data = self.owner_script.ParseLtx(v.filepath)
				for k in pairs(data) do
					iCntSections = iCntSections + 1
					local item = {
						group = group_id,
						section = k,
						name = squad_caption..game.translate_string(Get_Cfg_String(sini, k, "faction", ""))
					}
					table.insert(self.tSpawnSections, item)
				end
			end
		else
			-- чтение из конфига модуля
			local sections = Get_IniSection(ltx, group_id, "list", nil, ",")
			for _,v in ipairs(sections) do
				if v and v[1] then
					iCntSections = iCntSections + 1
					local section = trim(v[1])
					if not sini:section_exist(section) then-- +UP
						--to_log(sModule..":> PrepareData section=[%s] not found", section)-- +UP
					else-- +UP
						local item = {
							group = group_id,
							section = section,
							name = v[2] and string.gsub(trim(v[2]), "\"", "") or game.translate_string(Get_Cfg_String(sini, section, "inv_name", section))
						}
						table.insert(self.tSpawnSections, item)
					end-- +UP
				end
			end
		end
	end

	self.tSpawnSections = self.owner_script.SortTableByValue(self.tSpawnSections, "asc", "section")

	--to_log(sModule..":> PrepareData groups=[%d], sections=[%d]", iCntGroups, iCntSections)
end

-- подготовка данных при открытии диалога в игре (объекты доступны)
function spawn:PrepareRuntimeData()
	if self.bSmartsLoaded then return end --/>
	--to_log(sModule..":> PrepareRuntimeData start")

	local gg, iCntSmarts = game_graph(), 0

	-- заполнение списка смартов
	local board = sim_board.get_sim_board()
	for obj_name, smart in pairs(board.smarts_by_names) do
		iCntSmarts = iCntSmarts + 1
		table.insert(self.tSmarts, {
			id = obj_name,
			location = sim:level_name(gg:vertex(smart.m_game_vertex_id):level_id()),
			name = smart_names.get_smart_terrain_name(smart),
			pos = smart.position,
			lvid = smart.m_level_vertex_id,
			gvid = smart.m_game_vertex_id
		})
	end
	self.tSmarts = self.owner_script.SortTableByValue(self.tSmarts, "asc", "id")

	self.bSmartsLoaded = true
	--to_log(sModule..":> PrepareRuntimeData smarts=[%d]", iCntSmarts)
end

-- установка состояния органов управления под доп. диалогом
function spawn:SetControlsState(enable)
	self.section_list:Enable(enable)
	self.squad_list:Enable(enable)
--[[ -- для CoP пока скрываем
	self.btn_select_nearest:Enable(enable)
--]]
	self.smart_list:Enable(enable)
	self.textbox_shift:Enable(enable)
	self.btn_shift_plus:Enable(enable)
	self.btn_shift_minus:Enable(enable)
	self.btn_shift_left:Enable(enable)
	self.btn_shift_forward:Enable(enable)
	self.btn_shift_back:Enable(enable)
	self.btn_shift_right:Enable(enable)
	self.textbox_find_squad:Enable(enable)
	self.btn_find_squad:Enable(enable)
	self.textbox_find_smart:Enable(enable)
	self.btn_find_smart:Enable(enable)
	self.textbox_find:Enable(enable)
	self.btn_find:Enable(enable)
	self.btn_current:Enable(enable)
	self.textbox_gv:Enable(enable)
	self.textbox_lv:Enable(enable)
	self.textbox_x:Enable(enable)
	self.textbox_y:Enable(enable)
	self.textbox_z:Enable(enable)
	self.checkbox_mode_enabled = enable -- для (раз)блокировки чекбокса, чтобы не сбрасывалось состояние
	self.textbox_count:Enable(enable)
	self.btn_count_plus:Enable(enable)
	self.btn_count_minus:Enable(enable)
	self.btn_spawn:Enable(enable)
end

-- установка состояния доп. диалога выбора режима и органов управления под ним
function spawn:SetSpawnModeDialog(show)
	-- (раз)блокировка органов управления под доп. диалогом
	self:SetControlsState(not show)
	-- показ/скрытие диалога
	self.owner:SetFrameShowState(show, self.dlg_spawn_mode_frame, self.dlg_spawn_mode_frame_controls)
end

-- установка состояния доп. диалога сообщения и органов управления под ним
function spawn:ShowMessageDialog(message)
	-- местная блокировка органов управления под доп. диалогом
	self:SetControlsState(false)
	-- показ диалога с установкой коллбэка на закрытие
	self.owner:SetMessageDialog(message, { func = self.SetControlsState, data = true, userobj = self })
end

-- нажатия на кнопки
function spawn:OnKeyboard(activeTab, dik, keyboard_action)
	if activeTab ~= sModule then return true end --/>
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_ESCAPE then
			if self.dlg_spawn_mode_frame:IsShown() then
				self:SetSpawnModeDialog(false)
				return false --/>
			end
		end
		self.owner_script.FilterTextboxes(sModule)
	end
	return true --/>
end

-- открытие и инициализация раздела
function spawn:OnTabChange()
	--to_log(sModule..":> OnTabChange start")
	self.group_list:Show(true)
	for _,group in ipairs(self.tSpawnGroups) do
		self.owner:AddPrimaryListItem(self.group_list, group.name, group.id, self.color[0])
	end

	self.textbox_shift:SetText("3")
	-- + UP
	-- self.textbox_gv:SetText(string.format("%d", db.actor:game_vertex_id()))
	-- self.textbox_lv:SetText(string.format("%d", db.actor:level_vertex_id()))
	-- local pos = db.actor:position()
	-- local dir = db.actor:direction()
	self.textbox_gv:SetText(string.format("%d", getLocalActor():game_vertex_id()))
	self.textbox_lv:SetText(string.format("%d", getLocalActor():level_vertex_id()))
	local pos = getLocalActor():position()
	local dir = getLocalActor():direction()
	-- - UP

	pos = pos:add(dir:mul(3))
	self.textbox_x:SetText(string.format("%.3f", pos.x))
	self.textbox_y:SetText(string.format("%.3f", pos.y))
	self.textbox_z:SetText(string.format("%.3f", pos.z))
end

-- выбор группы спавна
function spawn:OnGroupListItemClicked()
	--to_log(sModule..":> OnGroupListItemClicked start")
	self:ClearFields()

	local group_id = self.owner:GetListItemSelectedValue(self.group_list)
	if not group_id or group_id == "null" then return end --/>

	local group = nil
	for _,v in ipairs(self.tSpawnGroups) do
		if v.id == group_id then
			group = v
			break
		end
	end
	if not group then return end --/>

	self.owner:SetFrameShowState(group_id ~= "squads", self.section_frame, self.section_frame_controls)
	self.owner:SetFrameShowState(group_id == "squads", self.squad_frame, self.squad_frame_controls)
	self.owner:SetFrameShowState(group_id == "squads", self.smart_frame, self.smart_frame_controls)
	self.owner:SetFrameShowState(group_id ~= "squads", self.buttons_frame_1, self.buttons_frame_1_controls)
	self.owner:SetFrameShowState(true, self.buttons_frame_2, self.buttons_frame_2_controls)
	self:SetSpawnModeDialog(false)
	if group.mode == "both" then
		-- предметы с признаком "both" могут спавниться как в окружающем мире, так и в инвентаре
		self.checkbox_mode:Show(true)
		self.checkbox_mode:SetCheck(true)
		self.checkbox_mode:TextControl():SetText(game.translate_string("tool_spawn_to_inventory"))
		self.checkbox_mode_2:Show(false)
		self.checkbox_mode_2:SetCheck(false)
	else
		if group_id == "stalkers" or group_id == "monsters" then
			-- сталкеры и монстры могут спавниться живыми и мёртвыми
			self.checkbox_mode:Show(true)
			self.checkbox_mode:SetCheck(false)
			self.checkbox_mode:TextControl():SetText(game.translate_string("tool_spawn_dead"))
		elseif group_id == "squads" then
			-- отряды могут спавниться с очисткой целевого смарта и без
			self.checkbox_mode:Show(true)
			self.checkbox_mode:SetCheck(true)
			self.checkbox_mode:TextControl():SetText(game.translate_string("tool_spawn_clear_smart"))
		else
			-- остальные объекты могут спавниться только в окружающем мире
			self.checkbox_mode:Show(false)
			self.checkbox_mode:SetCheck(false)
		end
		if group_id == "stalkers" then
			-- сталкеры могут спавниться здоровыми и ранеными
			self.checkbox_mode_2:Show(true)
			self.checkbox_mode_2:SetCheck(false)
		else
			self.checkbox_mode_2:Show(false)
			self.checkbox_mode_2:SetCheck(false)
		end
	end
	if group_id == "squads" or group_id == "stalkers" or group_id == "monsters" then
		-- отряды, сталкеры и монстры спавнятся по одному
		self.caption_count:Show(false)
		self.textbox_count:Show(false)
		self.btn_count_plus:Show(false)
		self.btn_count_minus:Show(false)
	else
		-- предметам при спавне можно задать кол-во, аномалиям - радиус
		self.caption_count:Show(true)
		self.textbox_count:Show(true)
		self.btn_count_plus:Show(true)
		self.btn_count_minus:Show(true)
		if group_id == "anomalies" then
			self.caption_count:TextControl():SetText(game.translate_string("tool_spawn_radius"))
			self.textbox_count:SetText("3")
		else
			self.caption_count:TextControl():SetText(game.translate_string("tool_spawn_count"))
			self.textbox_count:SetText("1")
		end
	end

	-- заполнение списка секций
	local list = group_id == "squads" and self.squad_list or self.section_list
	for _,v in ipairs(self.tSpawnSections) do
		if v.group == group_id then
			self.owner:AddSecondaryListItem(list, v.section, v.name, v.section, self.color[0])
		end
	end
	if group_id == "squads" then
		-- заполнение списка смартов
		for _,point in ipairs(self.tSmarts) do
			self.owner:AddSecondaryListItem(self.smart_list, point.id, point.name, point.id, self.color[0])
		end
	end
end

-- очистка полей
function spawn:ClearFields(clear_all)
	--to_log(sModule..":> ClearFields start, clear_all=[%s]", tostring(clear_all))
	if clear_all then
		self.group_list:ScrollToBegin()
		self.group_list:RemoveAll()
	end
	self.section_list:ScrollToBegin()
	self.section_list:RemoveAll()
	self.squad_list:ScrollToBegin()
	self.squad_list:RemoveAll()
	self.smart_list:ScrollToBegin()
	self.smart_list:RemoveAll()
	self.textbox_find_squad:SetText("")
	self.textbox_find_smart:SetText("")
	self.textbox_find:SetText("")
	self.checkbox_mode:SetCheck(false)
	self.checkbox_mode_2:SetCheck(false)
	self.textbox_count:SetText("")
end

-- скрытие полей
function spawn:HideFields()
	--to_log(sModule..":> HideFields start")
	self.group_list:Show(false)
	self.owner:SetFrameShowState(false, self.section_frame)
	self.owner:SetFrameShowState(false, self.squad_frame)
	self.owner:SetFrameShowState(false, self.smart_frame)
	self.owner:SetFrameShowState(false, self.buttons_frame_1)
	self.owner:SetFrameShowState(false, self.buttons_frame_2)
	self:SetSpawnModeDialog(false)
end

-- кнопка Поиск (фильтр секций отрядов)
function spawn:OnBtnFindSquad()
	--to_log(sModule..":> OnBtnFindSquad start")

	self.squad_list:ScrollToBegin()
	self.squad_list:RemoveAll()

	local sFilter = self.owner_script.StringLowerRus(self.textbox_find_squad:GetText():trim())
	local bHasFilter = sFilter:len() > 0
	for _,v in ipairs(self.tSpawnSections) do
		if v.group == "squads" and (not bHasFilter or string.find(self.owner_script.StringLowerRus(v.section), sFilter, 1, true) or string.find(self.owner_script.StringLowerRus(v.name), sFilter, 1, true)) then
			self.owner:AddSecondaryListItem(self.squad_list, v.section, v.name, v.section, self.color[0])
		end
	end
	if self.squad_list:GetSize() == 0 and bHasFilter then
		self.owner:AddSecondaryListItem(self.squad_list, game.translate_string("tool_spawn_empty"), nil, "null", self.color[0])
	end
end

-- кнопка Поиск (фильтр секций смартов)
function spawn:OnBtnFindSmart()
	--to_log(sModule..":> OnBtnFindSmart start")

	self.smart_list:ScrollToBegin()
	self.smart_list:RemoveAll()

	local sFilter = self.owner_script.StringLowerRus(self.textbox_find_smart:GetText():trim())
	local bHasFilter = sFilter:len() > 0
	for _,v in ipairs(self.tSmarts) do
		if not bHasFilter or string.find(self.owner_script.StringLowerRus(v.id), sFilter, 1, true) or string.find(self.owner_script.StringLowerRus(v.name), sFilter, 1, true) then
			self.owner:AddSecondaryListItem(self.smart_list, v.id, v.name, v.id, self.color[0])
		end
	end
	if self.smart_list:GetSize() == 0 and bHasFilter then
		self.owner:AddSecondaryListItem(self.smart_list, game.translate_string("tool_spawn_empty"), nil, "null", self.color[0])
	end
end

