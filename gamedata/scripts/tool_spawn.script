-- кнопка Сдвиг плюс
function spawn:OnBtnShiftPlus()
	--to_log(sModule..":> OnBtnShiftPlus start")
	local value = tonumber(self.textbox_shift:GetText()) or 0
	self.textbox_shift:SetText(string.format("%d", math.floor(value) + 1))
end

-- кнопка Сдвиг минус
function spawn:OnBtnShiftMinus()
	--to_log(sModule..":> OnBtnShiftMinus start")
	local value = tonumber(self.textbox_shift:GetText()) or 1
	if math.floor(value) < value then value = math.floor(value) else value = value - 1 end
	if value < 1 then value = 1 end
	self.textbox_shift:SetText(string.format("%d", value))
end

function spawn:SetNewPosition(angle)
	-- получаем дистанцию из диалога
	local dist = tonumber(self.textbox_shift:GetText())
	if not dist then return end --/>
	-- получаем координаты из диалога
	local pos_x = tonumber(self.textbox_x:GetText())
	local pos_y = tonumber(self.textbox_y:GetText())
	local pos_z = tonumber(self.textbox_z:GetText())
	if not (pos_x and pos_y and pos_z) then return end --/>
	-- сдвигаем позицию в направлении взгляда + угол angle на расстояние dist
	-- + UP
	-- local pos = self.owner_script.MoveAtDirection(vector():set(pos_x, pos_y, pos_z), db.actor:direction(), angle, dist)
	local pos = self.owner_script.MoveAtDirection(vector():set(pos_x, pos_y, pos_z), getLocalActor():direction(), angle, dist)
	-- - UP
	-- получаем вертексы из новой позиции
	local lvid = lua_helper.Get_Never_idLv_by_Pos(pos)
	local gvid = lua_helper.Get_idGv_by_Pos(pos, db.idMapNow)
	-- устанавливаем новые значения в диалоге
	self.textbox_gv:SetText(string.format("%d", gvid))
	self.textbox_lv:SetText(string.format("%d", lvid))
	self.textbox_x:SetText(string.format("%.3f", pos.x))
	self.textbox_y:SetText(string.format("%.3f", pos.y))
	self.textbox_z:SetText(string.format("%.3f", pos.z))
end

-- кнопка Сдвиг влево
function spawn:OnBtnShiftLeft()
	--to_log(sModule..":> OnBtnShiftLeft start")
	self:SetNewPosition(-90)
end

-- кнопка Сдвиг вперёд
function spawn:OnBtnShiftForward()
	--to_log(sModule..":> OnBtnShiftForward start")
	self:SetNewPosition(0)
end

-- кнопка Сдвиг назад
function spawn:OnBtnShiftBack()
	--to_log(sModule..":> OnBtnShiftBack start")
	self:SetNewPosition(180)
end

-- кнопка Сдвиг вправо
function spawn:OnBtnShiftRight()
	--to_log(sModule..":> OnBtnShiftRight start")
	self:SetNewPosition(90)
end

-- кнопка Центрировать на игроке
function spawn:OnBtnCurrent()
	--to_log(sModule..":> OnBtnCurrent start")
	-- + UP
	-- self.textbox_gv:SetText(string.format("%d", db.actor:game_vertex_id()))
	-- self.textbox_lv:SetText(string.format("%d", db.actor:level_vertex_id()))
	-- local pos = db.actor:position()
	self.textbox_gv:SetText(string.format("%d", getLocalActor():game_vertex_id()))
	self.textbox_lv:SetText(string.format("%d", getLocalActor():level_vertex_id()))
	local pos = getLocalActor():position()
	-- - UP
	self.textbox_x:SetText(string.format("%.3f", pos.x))
	self.textbox_y:SetText(string.format("%.3f", pos.y))
	self.textbox_z:SetText(string.format("%.3f", pos.z))
end

--[[ -- для CoP пока скрываем
-- кнопка Выбрать ближайшую
function spawn:OnBtnSelectNearestSmart()
	to_log(sModule..":> OnBtnSelectNearestSmart start")

	-- поиск смарта, ближайшего к текущей позиции игрока
	local actor_loc, actor_pos, min_dist, smart_name = level.name(), db.actor:position(), 100000000, nil
	for _,v in ipairs(self.tSmarts) do
		local dist = actor_pos:distance_to_sqr(v.pos)
		if actor_loc == v.location and dist < min_dist then
			min_dist = dist
			smart_name = v.id
		end
	end

	-- выбор найденного смарта в списке
	if smart_name then
		self.owner:SelectListItem(self.smart_list, smart_name)
		local smart_name, oListItem = self.owner:GetListItemSelectedValue(self.smart_list)
		if oListItem then self.smart_list:ScrollToPos(self.smart_list:GetItemPos(oListItem)) end
	end
end
--]]

-- кнопка Создать
function spawn:OnBtnSpawn()
	--to_log(sModule..":> OnBtnSpawn start")

	local group_id = self.owner:GetListItemSelectedValue(self.group_list)
	if not group_id or group_id == "null" then return end --/>

	local section = group_id == "squads" and self.owner:GetListItemSelectedValue(self.squad_list) or self.owner:GetListItemSelectedValue(self.section_list)
	if not section or section == "null" then return end --/>

	if group_id == "squads" then
		-- создание отряда
		local smart_name = self.owner:GetListItemSelectedValue(self.smart_list)
		if not smart_name or smart_name == "null" then return end --/>

		self:SpawnSquad(section, smart_name, self.checkbox_mode:GetCheck()) -- с очисткой или без
		return --/>
	end

	local number = tonumber(self.textbox_count:GetText()) or (group_id == "anomalies" and 3 or 1)
	-- + UP
	-- local gvid = tonumber(self.textbox_gv:GetText()) or db.actor:game_vertex_id()
	-- local lvid = tonumber(self.textbox_lv:GetText()) or db.actor:level_vertex_id()	
	local gvid = tonumber(self.textbox_gv:GetText()) or getLocalActor():game_vertex_id()
	local lvid = tonumber(self.textbox_lv:GetText()) or getLocalActor():level_vertex_id()
	-- - UP
	local pos_x = tonumber(self.textbox_x:GetText())
	local pos_y = tonumber(self.textbox_y:GetText())
	local pos_z = tonumber(self.textbox_z:GetText())
	-- + UP
	-- local pos = (pos_x and pos_y and pos_z) and vector():set(pos_x, pos_y, pos_z) or db.actor:position()
	local pos = (pos_x and pos_y and pos_z) and vector():set(pos_x, pos_y, pos_z) or getLocalActor():position()
	-- - UP

	if group_id == "anomalies" then
		-- создание аномалий
		self:SpawnAnomaly(section, number, pos, lvid, gvid)
	elseif group_id == "ammo" then
		-- создание патронов
		if self.checkbox_mode:GetCheck() then -- в инвентаре
			-- + UP
			-- self:SpawnAmmo(section, number, db.actor:id(), vector(), 0, 0)
			self:SpawnAmmo(section, number, LocalActor(), vector(), 0, 0)
			-- - UP
		else -- в окр. мире
			self:SpawnItems(section, number, nil, pos, lvid, gvid)
			-- self:SpawnAmmo(section, number, db.actor:id(), vector(), 0, 0, true)
		end
	elseif group_id == "stalkers" or group_id == "monsters" then
		-- создание сталкеров и монстров
		self:SpawnNpc(section, 1, pos, lvid, gvid, self.checkbox_mode:GetCheck(), self.checkbox_mode_2:GetCheck()) -- живых, мёртвых или (сталкеров) раненых
	else
		-- создание предмета(ов)
		if self.checkbox_mode:GetCheck() then -- в инвентаре
			-- + UP
			-- self:SpawnItems(section, number, db.actor:id(), vector(), 0, 0)
			self:SpawnItems(section, number, LocalActor(), vector(), 0, 0)
			-- - UP
		else -- в окр. мире
			self:SpawnItems(section, number, nil, pos, lvid, gvid)
		end
	end
end

-- кнопка Плюс
function spawn:OnBtnCountPlus()
	--to_log(sModule..":> OnBtnCountPlus start")
	local value = tonumber(self.textbox_count:GetText()) or 0
	self.textbox_count:SetText(string.format("%d", math.floor(value) + 1))
end

-- кнопка Минус
