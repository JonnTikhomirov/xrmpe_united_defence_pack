local sModule = script_name() --/ строковое имя файла-модуля
local sim = alife() --/ кеширование алайфа

class "spawn"

function spawn:__init(owner_name)
	--to_log(sModule..":> __init") --/#~#
	self.owner_script = _G[owner_name]
	self.tSpawnGroups = {} -- массив групп спавна
	self.tSpawnSections = {} -- массив секций
	self.tSmarts = {} --/ массив смартов для спавна отрядов
	self.sSquadsConfigRoot = Get_Cfg_String(ltx, "squads_config_settings", "config_root", "$game_config$") -- +UP
	self.color = { --/ цветовое оформление списка секций
		[0] = GetARGB(255, 216, 186, 140), --/ секция
		[1] = GetARGB(255,  49, 174,  66)  --/ заголовок
	}
end

function spawn:__finalize() end

-- инициализация элементов
