	--to_log(sModule..":> OnBtnCountMinus start")
	local value = tonumber(self.textbox_count:GetText()) or 1
	if math.floor(value) < value then value = math.floor(value) else value = value - 1 end
	if value < 1 then value = 1 end
	self.textbox_count:SetText(string.format("%d", value))
end

-- чекбокс, клик
function spawn:OnCheckboxModeClick()
	--to_log(sModule..":> OnCheckboxModeClick start")
	if not self.checkbox_mode_enabled then
		self.checkbox_mode:SetCheck(not self.checkbox_mode:GetCheck())
	elseif self.checkbox_mode:GetCheck() then
		-- если чекбокс 1 включили, чекбокс 2 выключаем
		self.checkbox_mode_2:SetCheck(false)
	end
end

-- чекбокс 2, клик
function spawn:OnCheckboxMode2Click()
	--to_log(sModule..":> OnCheckboxMode2Click start")
	if not self.checkbox_mode_enabled then
		self.checkbox_mode_2:SetCheck(not self.checkbox_mode_2:GetCheck())
	elseif self.checkbox_mode_2:GetCheck() then
		-- если чекбокс 2 включили, чекбокс 1 выключаем
		self.checkbox_mode:SetCheck(false)
	end
end

-- Спавним отряд
function spawn:SpawnSquad(squad_id, smart_name, clear_smart)
	--to_log(sModule..":> SpawnSquad start")

	local board = sim_board.get_sim_board()
	local smart = board.smarts_by_names[smart_name]
	if smart == nil then
		--to_log(sModule..":> SpawnSquad Smart is not found by name [%s].", smart_name)
		self:ShowMessageDialog("tool_spawn_squad_smart_not_found")
		return --/>
	end
	-- to_log(sModule..":> SpawnSquad smart [%s] chosen", smart_name)

	local ltx = sim_board.squad_ltx
	if not ltx:section_exist(squad_id) then
		--to_log(sModule..":> SpawnSquad Wrong squad identificator [%s]. Squad descr doesnt exist.", tostring(squad_id))
		return --/>
	end

--[[ -- для CoP пока скрываем
	local player_name = Get_Cfg_String(ltx, squad_id, "faction", "", true)
	local player = board.players[player_name]
	if player == nil then
		to_log(sModule..":> SpawnSquad Wrong player_name [%s] for squad [%s]", tostring(player_name), tostring(squad_id))
		self:ShowMessageDialog("tool_spawn_squad_section_not_found")
		return --/>
	end

	if not clear_smart then
		-- если очистка смарта не выбрана, проверяем, что текущее население отсутствует или такое же, как у создаваемого отряда
		if smart.player_name ~= player_name and smart.player_name ~= "none" then
			to_log(sModule..":> SpawnSquad Smart player_name [%s] not equals squad player_name [%s]", tostring(smart.player_name), tostring(player_name))
			self:ShowMessageDialog("tool_spawn_squad_wrong_smart_player")
			return --/> смарт занят отрядом другой группировки
		end

		-- также проверяем на достижение максимальной популяции смарта
		local population = board:get_smart_population(smart)
		if population >= smart.squad_capacity then
			to_log(sModule..":> SpawnSquad Smart population [%s] has reached or greater then its maximum [%s]", tostring(population), tostring(smart.squad_capacity))
			self:ShowMessageDialog("tool_spawn_squad_smart_population_reached_maximum")
			return --/> смарт достиг максимальной популяции
		end
	end
--]]

	self.create_squad_params = { smart = smart, squad_id = squad_id, clear_smart = clear_smart }

	for _,v in pairs(board.smarts) do
		if v.squads[squad_id] ~= nil then
			-- отряд с таким же id уже есть, запоминаем параметры спавна и спрашиваем что делать
			if self.dlg_spawn_mode_frame:IsShown() then return end --/> доп. диалог уже показан
			self.dlg_mode_tab:SetActiveTab("squad_auto_id")
			self:SetSpawnModeDialog(true)
			return --/>
		end
	end

	-- отряда с таким же id нет, новый создаём сразу
	self:CreateSquad()
end

-- кнопка диалога Продолжить
function spawn:OnBtnContinue()
	--to_log(sModule..":> OnBtnContinue start")
	if self.dlg_spawn_mode_frame:IsShown() then
		self:SetSpawnModeDialog(false)
	end

	local mode_id = self.dlg_mode_tab:GetActiveId()
	self:CreateSquad(mode_id == "squad_auto_id" and 0 or mode_id == "squad_clear_existing" and 1 or nil)
end

-- кнопка диалога Отменить
function spawn:OnBtnCancel()
	--to_log(sModule..":> OnBtnCancel start")
	if self.dlg_spawn_mode_frame:IsShown() then
		self:SetSpawnModeDialog(false)
	end
	-- обнуление использованных параметров
	self.create_squad_params = nil
end

-- Создаём отряд по заданным параметрам, mode - режим (0 - задать случайный id, 1 - удалить имеющийся отряд с тем же id, nil - ничего дополнительно не делать)
function spawn:CreateSquad(mode)
	local p = self.create_squad_params
	--to_log(sModule..":> CreateSquad start: smart=[%s], squad_id=[%s], clear_smart=[%s], mode=[%s]", tostring(p.smart:name()), tostring(p.squad_id), tostring(p.clear_smart), tostring(mode))
	if not p or not (p.smart and p.squad_id) then return end --/>

	local board = sim_board.get_sim_board()
	if p.clear_smart then
		-- очистка смарта перед спавном
		if board.smarts[p.smart.id] then
			for _,squad in pairs(board.smarts[p.smart.id].squads) do
				board:exit_smart(squad, p.smart.id)
				board:remove_squad(squad)
			end
		end
	end

	if mode == 1 then
		-- выбран режим удаления отряда с тем же id
		local squad = board.squads[p.squad_id]
		if squad then -- на случай, если отряд уже был удалён выше при очистке целевого смарта перед спавном
			-- to_log(sModule..":> CreateSquad remove squad: check=[%s], to_remove=[%s]", tostring(squad.squad_id), tostring(p.squad_id))
			if squad.squad_id == p.squad_id then
				board:exit_smart(squad, board.smarts[squad.entered_smart].smrt)
				board:remove_squad(squad)
			end
		end
	end

	-- создание нового отряда
	local squad = board:create_squad(p.smart, p.squad_id)
	board:enter_smart(squad, p.smart.id)
	for k in squad:squad_members() do
		board:setup_squad_and_group(k.object)
	end
	squad:update()

	-- обнуление использованных параметров
	self.create_squad_params = nil
end

