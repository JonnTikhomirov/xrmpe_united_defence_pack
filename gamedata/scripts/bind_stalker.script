function init    (obj)
				if (OnClient()) then
					obj:bind_object(bind_stalker_cl(obj))
				else
					xr_motivator.AddToMotivator(obj)
				end
end

function actor_init    (npc)
	npc:bind_object(actor_binder(npc))	
end

function mp_actor_init    (npc)
					npc:bind_object(mp_actor_binder(npc))			
end

local game_difficulty_by_num = {
				[0] = "gd_novice",
				[1] = "gd_stalker",
				[2] = "gd_veteran",
				[3] = "gd_master"
				}

local weapon_hide = {}

class "mp_actor_binder" (object_binder)
function mp_actor_binder:__init (obj) super(obj)
	self.bCheckStart = false
	self.last_level_name = nil
	self.deimos_intensity = nil
	self.loaded_active_slot = 3
	self.loaded_slot_applied = false
	self.weather_manager = level_weathers.get_weather_manager()														
	self.surge_manager = surge_manager.get_surge_manager()
end

delayed_functions = {}

function add_delayed_function(funcName, timeout, params)
	local timestamp = time_global()
	
	local num = #delayed_functions + 1
	delayed_functions[num] = {}
	delayed_functions[num].name = funcName
	delayed_functions[num].timestamp = timestamp
	delayed_functions[num].timeout = timeout
	delayed_functions[num].params = params
end

function mp_actor_binder:update_delayed_functions()
	for k, v in pairs(delayed_functions) do
		if time_global() - v.timestamp > v.timeout then
			xr_effects[v.name](nil, nil, v.params)
			table.remove(delayed_functions, k)
		end
	end
end

function mp_actor_binder:net_spawn(data)
--	printf("actor net spawn")
	level.show_indicators()
	self.bCheckStart = true
	self.weapon_hide = false -- спрятано или нет оружие при разговоре.
	self.weapon_hide_in_dialog = false
	weapon_hide = {} -- устанавливаем глобальный дефолтовый флаг.
	self.task_manager = task_manager.get_task_manager()
	if object_binder.net_spawn(self,data) == false then
		return false
	end
				 
	db.add_obj(self.object)
	db.add_mp_actor(self.object)

	self.deimos_intensity = nil

	level.enable_input()

	--'Устанавливаем ссылку на таскменеджер
	--self.task_manager = task_manager.get_task_manager()
	self.spawn_frame = device().frame
	self.already_jumped = false
	self.primary_objects_filled = false
	self.loaded = true

	if data.story_id ~= "" then
		local previous_sid = get_object_story_id(self.object:id())
		if previous_sid == nil or previous_sid ~= data.story_id then
			add_story_object(self.object:id(), data.story_id)
		end
	end
	
	-- + UP
	if OnServer() then
		-- +UP ссорим с игроком при возрождении игрока
		if db.heli_enemies then
			for i = 0, db.heli_enemy_count - 1 do
				local enemy_obj = db.heli_enemies[i]
				if enemy_obj and is_df_enemy(enemy_obj) then
					set_df_enemy_relation_to_actor(enemy_obj, self.object)
				end
			end
		end
	end
	-- - UP

	return true
end

function mp_actor_binder:reinit()
	object_binder.reinit(self)
	local npc_id = self.object:id()
	db.storage[npc_id] = { }
	self.st = db.storage[npc_id]
	self.st.pstor = nil
	
	self.object:set_callback(callback.inventory_info, self.info_callback, self)
	self.object:set_callback(callback.on_item_take, self.on_item_take, self)
	self.object:set_callback(callback.on_item_drop, self.on_item_drop, self)
	self.object:set_callback(callback.trade_sell_buy_item, self.on_trade, self) -- for game stats
	self.object:set_callback(callback.task_state, self.task_callback, self)
	self.object:set_callback(callback.take_item_from_box, self.take_item_from_box, self)
	self.object:set_callback(callback.use_object, self.use_inventory_item, self)

	-- + UP
	if OnClient() then
		--/#+# [lua_helper] ------------------------------------------------
		if lua_helper.Init_ActorPStor then lua_helper.Init_ActorPStor() end
		--/< ---------------------------------------------------------------
	end
	-- - UP

end

function mp_actor_binder:task_callback(_task, _state)
	if GameType() == game_cl.game_id_coop then
		if _state ~= task.fail then
			if not _task:is_silent_notify() then
				if _state == task.completed then
					news_manager.send_task(db.actor, "complete", _task)
				else
					news_manager.send_task(db.actor, "new", _task)
				end
			end
		end
		
		task_manager.task_callback(_task, _state)
		
		if _task:is_silent_notify() and _state == _task:get_target_state() then
			_task:set_silent_notify(false)
		end
	end
end

function mp_actor_binder:on_item_take(obj)
	--printf_msg("on_item_take [%s]", obj:name())
	if OnServer() then
		treasure_manager.get_treasure_manager():on_item_take(obj:id())
	end
	
	if isArtefact(obj) then
		if OnServer() then
			local anomal_zone = bind_anomaly_zone.parent_zones_by_artefact_id[obj:id()]
			if anomal_zone ~= nil then
				anomal_zone:on_artefact_take(obj)
			else
				bind_anomaly_zone.artefact_ways_by_id[obj:id()] = nil
			end
			local artefact = obj:get_artefact()
			artefact:FollowByPath("NULL",0,vector():set(500,500,500))
			xr_statistic.inc_founded_artefacts_counter(obj:id(), self.object:id())
		elseif (getLocalActor() and self.object:id() == getLocalActor():id()) then -- Client
			xr_statistic.inc_founded_artefacts_counter(obj:id(), self.object:id())
		end
	end
	if OnClient() then self:update_quick_slots() end-- +UDP
end

-- +UDP
function mp_actor_binder:update_quick_slots()
	for slot = 0, 3 do
		local slot_name = "slot_" .. slot
		local slot_section = get_console():get_string(slot_name)

		if slot_section and slot_section ~= "" then
			local slot_clsid = system_ini():r_clsid(slot_section, "class")

			if slot_clsid then
				local same_item = false
				local best_item = nil
				local best_cost = -1

				self.object:iterate_inventory(
					function(dummy, item)
						local item_section = item:section()

						-- Такой же предмет уже есть в инвентаре
						if item_section == slot_section then
							same_item = true
							return
						end

						-- Предмет того же класса
						if item:clsid() == slot_clsid then
							local cost = item:cost()

							if cost > best_cost then
								best_cost = cost
								best_item = item
							end
						end
					end,
					nil
				)

				-- Точного предмета нет, но есть замена того же класса
				if not same_item and best_item then
					get_console():execute(
						slot_name .. " " .. best_item:section()
					)
				end
			end
		end
	end
end

function mp_actor_binder:use_inventory_item(obj)
	if OnClient() then self:update_quick_slots() end
end

function mp_actor_binder:on_item_drop(obj)
	if OnClient() then self:update_quick_slots() end
end
-- -UDP

function actor_have_items()
	local n=3 -- количество
	local count=0
	
	db.storage[LocalActor()].object:iterate_inventory(function (dummy, item) if item:section()=="kolbasa" then count=count+1 end end, nil)
	
	if count>=n then
		return true
	else
		return false
	end
end

function mp_actor_binder:update(delta)
	if LocalActor() ~= self.object:id() or (IsServerClient() and LocalActor() == self.object:id()) then
		if OnServer() then
			-- Апдейт прятание оружия игрока в зоне sr_no_weapon
			if check_for_weapon_hide_by_zones(self.object:id()) == true then
				if self.weapon_hide == false then
					self.object:hide_weapon_except_safe_items()
					self.weapon_hide = true
				end
			else
				if self.weapon_hide == true then
					self.object:restore_weapon_except_safe_items()
					self.weapon_hide = false
				end
			end

			xr_sound.update(self.object:id())
			-- +UP
			local a_manager = arena_manager.get_manager()
			if a_manager ~= nil then
				a_manager:on_mp_actor_update(self.object) -- потому что стартовый лут спавнится после net_spawn
			end
			-- -UP
		end
		
		if not IsServerClient() then
			return
		end
		
	end
	
	object_binder.update(self, delta)
	
	local time = time_global()
	game_stats.update (delta, self.object)

	--' Апдейт саундменеджера
	xr_sound.update(self.object:id())
	
	-- Обновление отключения ввода с клавиатуры.
	self.st.disable_input_time = nil
	
	-- Апдейт прятание оружия игрока во время диалога
	if self.object:is_talking() then
		if self.weapon_hide_in_dialog == false then
			self.object:hide_weapon()
			printf("hiding weapon!!!")
			self.weapon_hide_in_dialog = true
		end
	else
		if self.weapon_hide_in_dialog == true then
			printf("restoring weapon!!!")
			self.object:restore_weapon()
			self.weapon_hide_in_dialog = false
		end
	end
	
	-- обновление пси-антенны
	if sr_psy_antenna.psy_antenna then
		sr_psy_antenna.psy_antenna:update(delta)
	end
	
	if self.bCheckStart then
		-- +SP
		--printf("SET DEFAULT INFOS")
		-- old del
		--if not has_alife_info("global_dialogs") then
		--	self.object:give_info_portion("global_dialogs")
		--end
		--if not has_alife_info("level_changer_icons") then
		--	self.object:give_info_portion("level_changer_icons")
		--end
		-- -SP
		self.bCheckStart = false
	end
	
	if self.surge_manager then
		if self.f_surge_manager_loaded ~= true and not self.start_from_load then
			self.surge_manager:initialize()
			self.f_surge_manager_loaded = true
		end
		self.surge_manager:update()
	end
	if not self.loaded_slot_applied then
		self.object:activate_slot(self.loaded_active_slot)
		self.loaded_slot_applied = true
	end
	
	xr_s.on_actor_update(delta)
	
	if not(self.primary_objects_filled) then
		pda.fill_primary_objects()
		self.primary_objects_filled = true
	end
	pda.fill_sleep_zones()
	
	xr_voicedialogs.update()
	self:update_delayed_functions()
	
	sim_squad_scripted_cl_manager.get_squad_manager():update()
	
	for k, v in pairs(game_relations.temp_goodwill_table) do
		SetGoodwillForce(k, self.object:id(), v)
	end
	game_relations.temp_goodwill_table = { }
	-- +UP
	if OnClient() then
		bind_heli.heli_explode_update()
	end
	-- -UP
end

function mp_actor_binder:net_destroy()
	xr_sound.stop_sounds_by_id(self.object:id())
	local board_factions = sim_board.get_sim_board().players
	if(board_factions) then
			for k,v in pairs (board_factions) do
					xr_sound.stop_sounds_by_id(v.id)
			end
	end
	if(actor_stats.remove_from_ranking~=nil)then
		actor_stats.remove_from_ranking(self.object:id())
	end
	level.show_weapon(true)
	db.del_obj(self.object)
	db.del_mp_actor(self.object)

	if sr_psy_antenna.psy_antenna then
		sr_psy_antenna.psy_antenna:destroy()
		sr_psy_antenna.psy_antenna = false
	end
	
	self.object:set_callback(callback.inventory_info, nil)
	self.object:set_callback(callback.article_info, nil)
	self.object:set_callback(callback.on_item_take, nil)
	self.object:set_callback(callback.on_item_drop, nil)
	self.object:set_callback(callback.task_state, nil)
	self.object:set_callback(callback.level_border_enter, nil)
	self.object:set_callback(callback.level_border_exit, nil)
	self.object:set_callback(callback.take_item_from_box, nil)
	self.object:set_callback(callback.use_object, nil)
	
	object_binder.net_destroy(self)
end
----------------------------------------------------------------------------------------------------------------------
class "actor_binder" (object_binder)
----------------------------------------------------------------------------------------------------------------------
function actor_binder:__init (obj) super(obj)
	self.bCheckStart = false
	self.weather_manager = level_weathers.get_weather_manager()
	self.surge_manager = surge_manager.get_surge_manager()
	--self.actor_detector = xr_detector.actor_detector()
	self.last_level_name = nil
	self.deimos_intensity = nil
--	self.actor_weapon_on_start = true
	self.loaded_active_slot = 3
	self.loaded_slot_applied = false
	self.last_detective_achievement_spawn_time 	= nil
	self.last_mutant_hunter_achievement_spawn_time	= nil
	-- +UP
	if OnServer() then
		local ini = game_ini()
		if ini:section_exist(level.name()) then

			local section = "start_hours_range"
			if ini:line_exist(level.name(), section) then
				
				local shr = ini:r_string(level.name(), section)

				if shr and shr ~= "" then
					local range = utils.parse_names(shr)
					local startHour = tonumber(range[1])
					local endHour = tonumber(range[2])

					if startHour < endHour then
						-- Прямой диапазон (например, с 10 до 15)
						totalMinutes = (endHour - startHour) * 60
					elseif startHour > endHour then
						-- Диапазон через полночь (например, с 22 до 6)
						totalMinutes = (24 - startHour + endHour) * 60
					else
						-- Если часы равны (например, 10 до 10), берем случайные минуты внутри 1 часа
						totalMinutes = 60 
					end

					-- Генерируем случайное смещение в минутах.
					-- Вычитаем 1, чтобы время не перешагивало в следующий час 
					-- (например, для 22-6 максимум будет 05:59, а не 06:00).
					local randomOffset = math.random(0, math.max(0, totalMinutes - 1))

					-- Считаем итоговое время в минутах от начала суток
					local totalMinsFromMidnight = startHour * 60 + randomOffset

					-- Вычисляем часы и минуты с учетом перехода через 24:00 (используем остаток от деления на 24)
					local finalHour = math.floor(totalMinsFromMidnight / 60) % 24
					local finalMinute = totalMinsFromMidnight % 60
					
					get_console():execute(string.format("sv_setenvtime %d:%d", finalHour, finalMinute))
				end
			end
			
			section = "logic_restrictors"
			if ini:line_exist(level.name(), section) then
				local logic_srs = ini:r_string(level.name(), section)
				if logic_srs ~= "" then
					for _, sr in ipairs(utils.parse_names(logic_srs)) do
						if sr ~= "" and system_ini():section_exist(sr) then
							alife():create(sr, vector(), 0, 0)
							to_log("! levels logic_restrictor section [%s] create", sr)
						else
							to_log("! levels logic_restrictor section [%s] not found", sr)
						end
					end
				end
			end

			section = "lobby_light_offset"
			if ini:line_exist(level.name(), section) then
				self.lobby_light_offset = ini:r_vector(level.name(), section)
			end
		end
	end
	-- -UP
end
-- +UP
function actor_binder:lobby_light_update()
	
	if not self.lobby_light_offset then
		return
	end

	if xr_conditions.time_hour_in_range(self.object, self.object, {21,3}) and not has_alife_info("all_players_spawned") then
		if self.lobby_light_id == nil or alife():object(self.lobby_light_id) == nil then
			local pos = level.object_by_id(LocalActor()):position()
			local lobby_light = alife():create("df_lobby_light", pos:add(self.lobby_light_offset), 0, 0)
			if lobby_light then
				self.lobby_light_id = lobby_light.id
			end
		end
	elseif self.lobby_light_id and alife():object(self.lobby_light_id) ~= nil then
		alife():release(alife():object(self.lobby_light_id))
		self.lobby_light_id = nil
	end

end
-- -UP
----------------------------------------------------------------------------------------------------------------------
function actor_binder:net_spawn(data)
--	printf("actor net spawn")
	level.show_indicators()
	self.bCheckStart = true
	self.weapon_hide = false -- спрятано или нет оружие при разговоре.
	self.weapon_hide_in_dialog = false
	weapon_hide = {} -- устанавливаем глобальный дефолтовый флаг.
	if object_binder.net_spawn(self,data) == false then
		return false
	end
	
	if self.object:id() == SV_OBJECT_ID then
		db.add_actor(self.object)
		db.actor.deimos_intensity = self.deimos_intensity
	end
	
	self.deimos_intensity = nil
	if self.st.disable_input_time == nil then
		level.enable_input()
	end
	xr_s.on_game_load()                                    --' Distemper 03.2008 --
	self.weather_manager:reset()
	--' Загружаем настройки дропа
	death_manager.init_drop_settings()
	--'Устанавливаем ссылку на таскменеджер
	self.task_manager = task_manager.get_task_manager()
	self.spawn_frame = device().frame
	self.already_jumped = false
	self.loaded = false
	benchmark.main()							          --' Distemper 06.2008 --
	return true
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:net_destroy()
	xr_sound.stop_sounds_by_id(self.object:id())
	local board_factions = sim_board.get_sim_board().players
	if(board_factions) then
			for k,v in pairs (board_factions) do
					xr_sound.stop_sounds_by_id(v.id)
			end
	end
	if(actor_stats.remove_from_ranking~=nil)then
		actor_stats.remove_from_ranking(self.object:id())
	end
	level.show_weapon(true)
	
	if self.object:id() == SV_OBJECT_ID then
		db.del_actor(self.object)
	end
	
	self.object:set_callback(callback.inventory_info, nil)
	self.object:set_callback(callback.article_info, nil)
	self.object:set_callback(callback.on_item_take, nil)
	self.object:set_callback(callback.on_item_drop, nil)
	self.object:set_callback(callback.task_state, nil)
	self.object:set_callback(callback.level_border_enter, nil)
	self.object:set_callback(callback.level_border_exit, nil)
	self.object:set_callback(callback.take_item_from_box, nil)
	self.object:set_callback(callback.use_object, nil)

	log("--------->"..tostring(_G.amb_vol))
	log("--------->"..tostring(_G.mus_vol))
	if(_G.amb_vol~=0) then
		get_console():execute("snd_volume_eff "..tostring(_G.amb_vol))
		_G.amb_vol = 0
	end
	if(_G.mus_vol~=0) then
	    get_console():execute("snd_volume_music "..tostring(_G.mus_vol))
		_G.mus_vol = 0
	end
	if sr_psy_antenna.psy_antenna then
		sr_psy_antenna.psy_antenna:destroy()
		sr_psy_antenna.psy_antenna = false
	end
	xrs_dyn_music.finish_theme()
	xr_s.on_actor_destroy()
	object_binder.net_destroy(self)
	-- +UDP
	if self.g_dynamic_music == true then
		get_console():execute("g_dynamic_music on")
	end
	-- -UDP
end
