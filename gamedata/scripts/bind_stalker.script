function actor_binder:use_inventory_item(obj)
	if(obj) then
		local s_obj = alife():object(obj:id())
		if(s_obj) and (s_obj:section_name()=="drug_anabiotic") then
			xr_effects.disable_ui_only(db.actor, nil)
			level.add_cam_effector("camera_effects\\surge_02.anm", 10, false, "bind_stalker.anabiotic_callback")
			level.add_pp_effector("surge_fade.ppe", 11, false)
			give_info("anabiotic_in_process")
			_G.mus_vol = get_console():get_float("snd_volume_music")
			_G.amb_vol = get_console():get_float("snd_volume_eff")
			get_console():execute("snd_volume_music 0")
			get_console():execute("snd_volume_eff 0")
		end
	end
end

function anabiotic_callback()
	level.add_cam_effector("camera_effects\\surge_01.anm", 10, false, "bind_stalker.anabiotic_callback2")
	local rnd = math.random(35,45)
	local m = surge_manager.get_surge_manager()
	if(m.started) then
		local tf = level.get_time_factor()
		local diff_sec = math.ceil(game.get_game_time():diffSec(m.inited_time)/tf)
			if(rnd>(m.surge_time-diff_sec)*tf/60) then
			m.time_forwarded = true
			m.ui_disabled = true
			m:kill_all_unhided()
			m:end_surge()
		end
	end
	--level.change_game_time(0,0,rnd)
	--level_weathers.get_weather_manager():forced_weather_change()
	printf("anabiotic_callback: time forwarded on [%d]", rnd)
end

function anabiotic_callback2()
	xr_effects.enable_ui(db.actor, nil)
    get_console():execute("snd_volume_music "..tostring(_G.mus_vol))
	get_console():execute("snd_volume_eff "..tostring(_G.amb_vol))
	_G.amb_vol = 0
	_G.mus_vol = 0
	disable_info("anabiotic_in_process")
end
----------------------------------------------------------------------------------------------------------------------

function actor_binder:task_callback(_task, _state, _silent)
	if _state ~= task.fail then
		if _state == task.completed then
			news_manager.send_task(db.actor, "complete", _task)
		else
			news_manager.send_task(db.actor, "new", _task)
		end
	end
	task_manager.task_callback(_task, _state)
end

----------------------------------------------------------------------------------------------------------------------

function actor_binder:try_start_game()
	if not story_flags.has_flag("GAME_STARTED") then
		local num = 0
		for k,v in pairs(db.mp_actors) do
			num = num + 1
		end
		
		local num_players = get_players_count()
		if IsDedicatedServer() then
			num_players = num_players - 1
		end
		
		if num > 0 and num_players == num then
			story_flags.give_flag("GAME_STARTED")
		end
	end
end

function actor_binder:update(delta)
	object_binder.update(self, delta)
	
	if string.find(command_line(), "-designer") then
		return
	end

	if OnServer() then
		self.weather_manager:update()

		local time = time_global()
		game_stats.update (delta, self.object)
	
		self:check_detective_achievement()
		self:check_mutant_hunter_achievement()
	
		-- Апдейт саундменеджера
		xr_sound.update(self.object:id())
		
		-- обновление пси-антенны
		if sr_psy_antenna.psy_antenna then
			sr_psy_antenna.psy_antenna:update(delta)
		end
		
		if self.bCheckStart then
			-- +SP
			--printf("SET DEFAULT INFOS")
			-- old del
			--if not has_alife_info("global_dialogs") then
			--	self.object:give_info_portion("global_dialogs")
			--end
			--if not has_alife_info("level_changer_icons") then
			--	self.object:give_info_portion("level_changer_icons")
			--end
			-- -SP
			self.bCheckStart = false
		end
	
		if not self.loaded_slot_applied then
			self.object:activate_slot(self.loaded_active_slot)
			self.loaded_slot_applied = true
		end
		
		xr_s.on_actor_update(delta)
		
		if(self.surge_manager) then
			if(self.f_surge_manager_loaded ~= true) then
				self.surge_manager:initialize()
				self.f_surge_manager_loaded = true
			end
			if(self.surge_manager.levels_respawn[level.name()]) then
				self.surge_manager:respawn_artefacts_and_replace_anomaly_zone()
			end
			self.surge_manager:update()
		end
		-- Апдейт доступности для симуляции.
		simulation_objects.get_sim_obj_registry():update_avaliability(alife():actor())
		treasure_manager.get_treasure_manager():update()
	
		if not self.loaded then
			--get_console():execute("dump_infos")
			self.loaded = true
		end
	
		pda.fill_sleep_zones()
		
		self:try_start_game()
		task_manager.get_task_manager():send_server_objects_target_pos()
		client_tasks.update_delayed_tasks()
	-- +UDP
		bind_heli.heli_explode_update()
		self:lobby_light_update()
	else
		if _G.stereo_themes ~= nil then
			local has_playing_sthemes = false
			for _, v in ipairs(_G.stereo_themes) do
				if v:playing() then
					v:update(get_console():get_float("snd_volume_music"))
					has_playing_sthemes = true
				end
			end
			if has_playing_sthemes then
				to_log("has_playing_sthemes")
				if self.g_dynamic_music == nil then
					self.g_dynamic_music = get_console():get_bool("g_dynamic_music")
					if self.g_dynamic_music == true then
						to_log("g_dynamic_music off")
						get_console():execute("g_dynamic_music off")
					end
				end
			else
				to_log("has_playing_sthemes false")
				if self.g_dynamic_music == true then
					to_log("g_dynamic_music on")
					get_console():execute("g_dynamic_music on")
					self.g_dynamic_music = nil
				end
				_G.stereo_themes = {}
			end
		end
	-- -UDP
	end

	-- +UDP
	if OnClient() and LocalActor() ~= 0 then
		if self.weather_repaired ~= true then
			level.set_weather(level.get_weather(), true) -- при смене времени суток погода иногда застревает в одном состоянии, особенно на старте
			self.weather_repaired = true
		end
		if self.tool_tryInit ~= true then-- LocalActor() не равен 0 только когда начинается update, иначе возврат команды авторизации приходит не тому клиенту
			-- ++ The Tool
			lua_helper.attach() -- если вспомогательный модуль Артоса ещё не подключён
			m_netpk.attach() -- если модуль нет-пакетов Артоса ещё не подключён
			if keylogger then keylogger.init() end -- если кейлоггер Чарси ещё не подключён
			if keylogger then keylogger.on_load() end
			-- -- The Tool
			if tool then tool.TryInit() end
			self.tool_tryInit = true
		end
	end
	-- -UDP
	if self.already_jumped==false and jump_level.need_jump==true and (device().frame > self.spawn_frame+2000) then
		jump_level.try_to_jump()
		self.already_jumped = true
		return
	end

	-- Вызов апдейта переноса игрока проводником
	if travel_func ~= nil then
		travel_func()
	end
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:save(packet)

	-- + UP
	if OnClient() then
		-- ++ The Tool
		xr_s.on_event("actor_save")
		-- -- The Tool
	end
	-- - UP

	set_save_marker(packet, "save", false, "actor_binder")
	object_binder.save(self, packet)
	self.weather_manager:save(packet)
	release_body_manager.get_release_body_manager():save(packet)										
	self.surge_manager:save(packet)
	treasure_manager.get_treasure_manager():save(packet)
	xr_statistic.save(packet)
	client_tasks.save_delayed_tasks(packet)
	set_save_marker(packet, "save", true, "actor_binder")
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:load(reader)
	set_save_marker(reader, "load", false, "actor_binder")
	object_binder.load(self, reader)
	self.weather_manager:load(reader)
	release_body_manager.get_release_body_manager():load(reader)
	self.surge_manager:load(reader)
	treasure_manager.get_treasure_manager():load(reader)
	xr_statistic.load(reader)
	client_tasks.load_delayed_tasks(reader)
	set_save_marker(reader, "load", true, "actor_binder")
end

--*************************************************************
--*					Подспаун вещей в ящики					  *
--*************************************************************
local detective_achievement_items 		= {	"medkit",
											"antirad",
											"bandage"}

local mutant_hunter_achievement_items	= {	"ammo_5.45x39_ap",
											"ammo_5.56x45_ap",
											"ammo_9x39_ap",
											"ammo_5.56x45_ap",
											"ammo_12x76_zhekan"}

local function spawn_achivement_items(items_table, count, inv_box_story_id)
	local inv_box = alife():object(get_story_object_id(inv_box_story_id))
	for i = 1,count do
		alife():create(items_table[math.random(#items_table)],
						inv_box.position,
						inv_box.m_level_vertex_id,
						inv_box.m_game_vertex_id,
						inv_box.id)
	end
end

function actor_binder:check_detective_achievement()
	if not has_alife_info("detective_achievement_gained") then
		return
	end
	if self.last_detective_achievement_spawn_time == nil then
		self.last_detective_achievement_spawn_time = game.get_game_time()
	end
	if game.get_game_time():diffSec(self.last_detective_achievement_spawn_time) > 43200 then
		spawn_achivement_items(detective_achievement_items, 4, "zat_a2_actor_treasure")
		xr_effects.send_tip(db.actor, nil, {"st_detective_news","got_medicine"})
		self.last_detective_achievement_spawn_time = game.get_game_time()
	end
end

function actor_binder:check_mutant_hunter_achievement()
	if not has_alife_info("mutant_hunter_achievement_gained") then
		return
	end
	if self.last_mutant_hunter_achievement_spawn_time == nil then
		self.last_mutant_hunter_achievement_spawn_time = game.get_game_time()
	end
	if game.get_game_time():diffSec(self.last_mutant_hunter_achievement_spawn_time) > 43200 then
		spawn_achivement_items(mutant_hunter_achievement_items, 5, "jup_b202_actor_treasure")
		xr_effects.send_tip(db.actor, nil, {"st_mutant_hunter_news","got_ammo"})
		self.last_mutant_hunter_achievement_spawn_time = game.get_game_time()
	end

end

----------------------------------------------------------------------------------------------------------------------

function check_for_weapon_hide_by_zones(actor_id)
	for k,v in pairs(weapon_hide) do
		if v[actor_id] == true then
			return true
		end
	end
	return false
end

-- Weapon functions
function hide_weapon(zone_id, actor_id)
	if weapon_hide[zone_id] == nil then
		weapon_hide[zone_id] = { }
	end
	
	printf("[WEAPON_CONTROL]:hiding weapon from zone [%s] in section [%s]!!!", zone_id, db.storage[zone_id].active_section)
	weapon_hide[zone_id][actor_id] = true	
end

function restore_weapon(zone_id, actor_id)
	if weapon_hide[zone_id] == nil then
		weapon_hide[zone_id] = { }
	end
	
	printf("[WEAPON_CONTROL]:restoring weapon from zone [%s] in section [%s]!!!", zone_id, db.storage[zone_id].active_section)
	weapon_hide[zone_id][actor_id] = false
end

class "bind_stalker_cl" (object_binder)
function bind_stalker_cl:__init (obj) super(obj)
end

function bind_stalker_cl:net_spawn(data)
	if not object_binder.net_spawn(self, data) then
		return false
	end

	db.add_obj(self.object)
	self.object:set_callback(callback.death, bind_stalker_cl.death_callback, self)
	self.object:set_callback(callback.hit, bind_stalker_cl.hit_callback, self)													   

	if character_community(self.object) ~= "monster" then
		sound_theme.init_npc_sound(self.object)
		set_level_spot(self.object:id(), data.level_spot_id)
		trade_manager.trade_init(self.object, data.trade_ini)
	end
	
	if data.goodwill ~= 127 then
		local goodwill = data.goodwill
		if getLocalActor() then
			SetGoodwillForce(self.object:id(), getLocalActor():id(), goodwill)
		else
			game_relations.temp_goodwill_table[self.object:id()] = goodwill
		end
	end
	
	return true
end

function bind_stalker_cl:net_import(packet)
	--object_binder.net_import(self, packet)
	
	if dev_debug then
		if self.st.debug_info == nil then
			self.st.debug_info = { }
		end
	
		self.st.debug_info.active_section = packet:r_stringZ()
		self.st.debug_info.best_enemy_name = packet:r_stringZ()
		
		self.st.debug_info.squad_id = packet:r_stringZ()
		self.st.debug_info.squad_current_action = packet:r_stringZ()
	end	
end

function bind_stalker_cl:reinit()
	object_binder.reinit(self)
	local npc_id = self.object:id()
	db.storage[npc_id] = { }   
	self.st = db.storage[npc_id]
	self.st.pstor = nil
end	

function bind_stalker_cl:update(delta)
	object_binder.update(self, delta)
	if self.object:alive() then
		trade_manager.update(self.object)
	end
end

function bind_stalker_cl:net_destroy()
	db.del_obj(self.object)
	db.storage[self.object:id()] = nil
	object_binder.net_destroy(self)
end
function bind_stalker_cl:death_callback(victim, who)
	if who and getLocalActor() and getLocalActor():id() == who:id() then
		xr_statistic.inc_killed_stalkers_counter(who:id())
	end
end

function bind_stalker_cl:hit_callback(obj, amount, local_direction, who, bone_index)
	if who and getLocalActor() and getLocalActor():id() == who:id() then
		xr_statistic.set_best_weapon(amount, who)
	end
end
function set_level_spot(npc_id, map_spot)
	if map_spot ~= nil and map_spot ~= 0 then
		local map_location = ""
		local hint = ""
		local profession = 0 --eNone
		if map_spot == 1 then
				map_location = "ui_pda2_trader_location"
				hint = "st_ui_pda_legend_trader"
				profession = 1 --eTrader
		elseif map_spot == 2 then
				map_location = "ui_pda2_mechanic_location"
				hint = "st_ui_pda_legend_mechanic"
				profession = 2 --eMechanic
		elseif map_spot == 3 then
				map_location = "ui_pda2_scout_location"
				hint = "st_ui_pda_legend_scout"
				profession = 3 --eGuider
		elseif map_spot == 4 then
				map_location = "ui_pda2_quest_npc_location"
				hint = "st_ui_pda_legend_vip"
		elseif map_spot == 5 then
				map_location = "ui_pda2_medic_location"
				hint = "st_ui_pda_legend_medic"
				profession = 4 --eMedic
		end
		
		if level.map_has_object_spot(npc_id, map_location) ~= 0 then
			level.map_remove_object_spot(npc_id, map_location)
		end
		
		level.map_add_object_spot(npc_id, map_location, hint)
		
		local npc = db.storage[npc_id] and db.storage[npc_id].object
		if npc ~= nil then
			npc:set_profession(profession)
		end
	end
end