#include "tool\teleport.ltx"
#include "tool\teleport_custom.ltx"
#include "tool\spawn.ltx"
#include "tool\actor.ltx"
#include "tool\clean.ltx"
#include "tool\info.ltx"
#include "tool\weather.ltx"
#include "tool\misc.ltx"

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;; Настройки менеджера

[settings]
; раздел по умолчанию (не обязательно)
; при отсутствии или несовпадении идентификатора установится первый по счёту раздел из секции [tabs]
default_tab = weather

; запоминать или нет активный раздел
remember_active_tab = false

; настройки расположения кнопок разделов при их автоматическом формировании
y_line_1        = 6   ; расположение по высоте первой линии кнопок
y_line_2        = 43  ; расположение по высоте второй линии кнопок
tab_interval    = 105 ; расстояние между кнопками для квадратных мониторов
tab_interval_16 = 120  ; расстояние между кнопками для широкоформатных мониторов

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;; Настройки разделов

[tabs]
; сквозной порядковый номер раздела = идентификатор, видимость, линия
01 = teleport , true,  1     ; "Переход"
02 = spawn    , true,  1     ; "Объекты"
03 = inventory, true,  1     ; "Инвентарь"
04 = factions , true,  1     ; "Фракции"
05 = actor    , true,  1     ; "Игрок"
06 = clean    , true,  2     ; "Очистка"
07 = info     , true,  2     ; "Инфо"
08 = weather  , true,  2     ; "Погода"
09 = misc     , true,  2     ; "Разное" ("Время", "Музыка", "Видео")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;; Настройки горячих клавиш

[key_bindings]
tool_manager = J
npc_info     = f9
hud_stats    = k
