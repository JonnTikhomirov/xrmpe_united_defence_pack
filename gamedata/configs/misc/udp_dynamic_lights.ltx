[dynamic_light]:lights_hanging_lamp
script_binding 	= bind_dynamic_light.init

range 			= 18.0
brightness		= 1
color			= 0.9,0.9,0.5
color_animator	= koster_00
type_spot		= false
point_ambient 	= false
ambient_radius 	= 5
ambient_power 	= 1
physic 			= true
cast_shadow		= true

; special
time 			= ; сек время работы
release_time	= ; сек время удаления объекта
particles		=
snd 			=

[explosive_light]:dynamic_light
script_binding 		= bind_dynamic_light.init_explosive

; special
particles_explode	=
snd_explode			=
explode_on_kick		= false

throwable_part		=
parts_count 		= 6
parts_impulse 		= 10.0
parts_impulse_rand 	= 0.0; 0.2 означает разброс силы импульса от -20% до +20%

;Общий наклон вектора вверх.
;0 — чисто горизонтальный разлет.
;0.3 — умеренно вверх.
parts_vertical_bias = 0.35

parts_vertical_rand = 0.0; Случайный разброс вертикальной составляющей.

;0 — идеально равномерный радиальный разброс.
;Например, 0.15 — небольшой случайный сдвиг углов.
parts_angle_jitter = 0.0

;Смещение и высота спавна частей относительно точки взрыва.
parts_spawn_offset = 0.03
parts_spawn_height = 0.05

[heli_flame_light]:lights_hanging_lamp
$spawn        = "physics\heli flame lamp"
range 			= 30
brightness		= 1.0
color			= 0.9,0.9,0.5
color_animator	= koster_00
