[outfit_base]
slot                         = 6 ; слот предмета

additional_inventory_weight  = 0 ; к переносимому весу
additional_inventory_weight2 = 0
;artefact_count              = 0 ; (по умолчанию: 0, максимум: 5) количество ячеек под артефакты
;bones_koeff_protection      = actor_armor_suit ; секция защиты костей из damages.ltx
control_inertion_factor      = 1.0 ; коэффициент * на скорость вращения камерой, чем больше - тем медленнее
default_to_ruck              = false ; при получении предмета, он будет в рюкзаке (true) или в слоте (false)
full_icon_name               = npc_icon_without_outfit ; иконка - параметр читается, но не используется
;helmet_avaliable            = true ; (по умолчанию: true) возможность надеть шлем
hit_fraction_actor           = 1.0 ; процент игнорируемого урона fire_wound
;nightvision_sect            = effector_nightvision_1 ; секция ночного визора из postprocess.ltx
;power_loss                  = 1.0 ; (по умолчанию: 1.0, без костюма: 0.5 ) коэффициент * выносливость
sprint_allowed               = true ; можно ли бегать с данным предметом

