;;;;;;;;;; Список категорий спавна

; второй параметр влияет на доступность соотв. режима спавна в диалоге
; out - спавн только в окружающем пространстве
; both - возможен спавн в инвентаре и в окружающем пространстве
[spawn_groups]
1  = squads       , out
2  = stalkers     , out
3  = outfit       , both
4  = weapon       , both
5  = ammo         , both
6  = addons       , both
7  = items        , both
8  = quest_items  , both
9  = monsters     , out
10 = anomalies    , out
11 = artefacts    , both
12 = other        , out

