;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;; Настройки модуля

[teleport_settings]
; загрузка смартов
load_smarts        = false
; загрузка точек из конфига
load_static_points = true
; состояние чекбокса "искать в контейнерах" по умолчанию
checkbox_boxes_default = true
; состояние чекбокса "искать на текущей локации" по умолчанию
checkbox_current_location_default = true
; состояние чекбокса "искать на других локациях" по умолчанию
checkbox_other_locations_default = true

