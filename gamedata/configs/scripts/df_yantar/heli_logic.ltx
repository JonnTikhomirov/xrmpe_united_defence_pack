[logic]
active = heli_move@idle

[heli_move@idle]
path_move = df_yan_heli_idle
path_look = df_yan_heli_way
engine_sound = false
max_velocity = 100
invulnerable = true
immortal = true
on_info = {+defence_wave_last_start} heli_move@timer

[heli_move@timer]
path_move = df_yan_heli_idle
path_look = df_yan_heli_way
engine_sound = false
max_velocity = 100
invulnerable = true
immortal = true
on_timer = 30000 | heli_move@come

[heli_move@come]
path_move = df_yan_heli_way_come
path_look = df_yan_heli_look
max_velocity = 50
engine_sound = true
invulnerable = true
immortal = true
on_signal = path_end | heli_move@fly %=heli_stop_say =heli_say(df_yantar_heli_come)%

[heli_move@fly]
path_move = df_yan_heli_way
path_look = df_yan_heli_look
max_velocity = 50
engine_sound = true
enemy = defence
use_rocket = false
fire_trail = false
invulnerable = true
immortal = true
on_signal = path_end | heli_move@anomaly %=play_particle_at_npc(anomaly2\tornado_00) =play_sound(emi_blowout) =xrmpe_client_spawn(heli_anomaly_light:df_yan_heli_way_death)%

[heli_move@anomaly]
path_move = df_yan_heli_way_death
path_look = df_yan_heli_look
max_velocity = 10
engine_sound = true
invulnerable = true
immortal = true
on_timer = 1000 | heli_move@death %=heli_stop_say =heli_say(df_yantar_heli_death_1:df_yantar_heli_death_2) =heli_start_flame%

[heli_move@death]
path_move = df_yan_heli_way_death
path_look = df_yan_heli_look
max_velocity = 10
engine_sound = true
invulnerable = true
immortal = false
on_timer = 6000 | nil %=heli_stop_say =heli_say(df_yantar_heli_death_3) =heli_die%




