[logic]
active = heli_move@idle

[heli_move@idle]
path_move = df_yan_heli_idle
path_look = df_yan_heli_way
engine_sound = false
max_velocity = 100
on_info = {+all_players_spawned} heli_move@fly

[heli_move@fly]
path_move = df_yan_heli_way
path_look = df_yan_heli_look
max_velocity = 50
engine_sound = true
enemy = defence
use_rocket = false
on_signal = come | %=heli_stop_say =heli_say(df_yantar_heli_come)%
on_signal2 = path_end | heli_move@death %+DF_YANTAR_HELI_DIE =play_particle_at_npc(anomaly2\tornado_00) =heli_stop_say =heli_say(df_yantar_heli_death_1:df_yantar_heli_death_2) =heli_start_flame%

[heli_move@death]
path_move = df_yan_heli_way_death
path_look = df_yan_heli_look
max_velocity = 10
engine_sound = true
fire_trail = true
on_timer = 7000 | heli_move@dead %=heli_say(df_yantar_heli_death_3) =heli_die%

[heli_move@dead]
path_move = df_yan_heli_way_death
path_look = df_yan_heli_look
max_velocity = 10
engine_sound = false




