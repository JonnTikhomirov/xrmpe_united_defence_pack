[logic]
active = sr_idle@check

[sr_idle@check]
on_info = {+DF_ARENA_FIGHT_START} sr_idle@select_rnd

[sr_idle@select_rnd]
on_info = {~35} sr_idle@pause_3 %=play_sound(df_arena_com_theme)%, {~50} sr_idle@pause_2 %=play_sound(df_arena_com_theme)%, sr_idle@pause_1 %=play_sound(df_arena_com_theme)%

[sr_idle@pause_1]
on_timer = 10000 | sr_idle@check

[sr_idle@pause_2]
on_timer = 8900 | sr_idle@check

[sr_idle@pause_3]
on_timer = 13000 | sr_idle@check
