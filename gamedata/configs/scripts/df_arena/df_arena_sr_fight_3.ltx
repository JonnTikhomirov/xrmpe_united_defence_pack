on_info = sr_idle@check_end %=xrmpe_teleport_actors(df_arena_teleport_to_fight_walk:df_arena_teleport_to_fight_look)%

[sr_idle@check_end]
on_info = {=check_players_count(5) =counter_equal(enemy_dead:16)} sr_idle@end, {=check_players_count(4) =counter_equal(enemy_dead:12)} sr_idle@end, {=check_players_count(3) =counter_equal(enemy_dead:8)} sr_idle@end, {=check_players_count(2) =counter_equal(enemy_dead:4)} sr_idle@end;+UP

[sr_idle@end]
on_info = nil %+DF_ARENA_FIGHT_3_END =set_counter(enemy_dead:0) -DF_ARENA_FIGHT_START%
