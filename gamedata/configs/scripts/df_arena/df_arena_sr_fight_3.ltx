[sr_idle@check_num_players]
on_info = {=check_players_count(5)} sr_idle@num_players_4, {=check_players_count(4)} sr_idle@num_players_3, {=check_players_count(3)} sr_idle@num_players_2, {=check_players_count(2)} sr_idle@num_players_1

[sr_idle@num_players_1]
; on_info = sr_idle@teleport_players %=spawn_object(df_arena_enemy_3:df_arena_enemy_sp_01) =spawn_object(df_arena_enemy_3:df_arena_enemy_sp_02) =spawn_object(df_arena_enemy_2:df_arena_enemy_sp_03)%;+UP
on_info = sr_idle@teleport_players %=arena_spawn(veteran:1) =arena_spawn(veteran:2) =arena_spawn(veteran:3) =arena_spawn(normal:4)%;+UP

