; on_info = sr_idle@teleport_players %=spawn_object(df_arena_enemy_3:df_arena_enemy_sp_01) =spawn_object(df_arena_enemy_3:df_arena_enemy_sp_02) =spawn_object(df_arena_enemy_2:df_arena_enemy_sp_03) =spawn_object(df_arena_enemy_3:df_arena_enemy_sp_04) =spawn_object(df_arena_enemy_3:df_arena_enemy_sp_05) =spawn_object(df_arena_enemy_2:df_arena_enemy_sp_06)%;+UP
