installed_upgrades = 
upgrade_scheme = upgrade_scheme_tt33


ammo_in_chamber = true

;-TTX-----------------------------------------------------------------------------
hit_power           		= 0.76, 0.76, 0.76, 0.76
hit_impulse		 			= 75
hit_type 					= fire_wound
fire_distance       		= 200
bullet_speed				= 430
rpm                 		= 320

use_aim_bullet				= false		;Поддерживается ли первая суппер пуля
time_to_aim					= 2.0

hud                      	= wpn_tt33_hud

misfire_probability        = 0.005 ;вероятность осечки при максимальном износе  !!!old - now not working
;изношенность, при которой появляется шанс осечки
misfire_start_condition		= 0.5
;изношеность при которой шанс осечки становится константным
misfire_end_condition		= 0.1
;шанс осечки при изношености больше чем misfireStartCondition
misfire_start_prob	     	= 0.007
;шанс осечки при изношености больше чем misfireEndCondition
misfire_end_prob	     	= 0.07
;увеличение изношености при одиночном выстреле
condition_shot_dec      	= 0.0014
;увеличение изношености при выстреле очередью
condition_queue_shot_dec	= 0.0014

;////////////////////////////////////////////Осечки////////////////////////////////////////////////////////////
;Это - разновидность задержки => происходит только в указанных для задержек пределах
;включаем использование осечек
use_light_misfire = true
;начальное состояние оружия, при котором происходят осечки; независимо от указанного тут значения, при состояниях лучшем, чем misfire_start_condition, осечек не будет
light_misfire_start_condition = 0.5
;состояние, хуже которого вероятность осечки константа
light_misfire_end_condition = 0.1
;какая часть всех задержек будет осечками в начальном состоянии
light_misfire_start_probability = 0.8
;какая часть всех задержек будет осечками на нижнем пороге
light_misfire_end_probability = 0.4


ammo_elapsed		 	= 8
ammo_mag_size		 	= 8
ammo_class		 		= ammo_762x25mm_tt
hand_dependence		 	= 1
single_handed			= 1

;---DOF-------------------------------------------------------------------------
zoom_dof					= -1000, 1.0, 1000
reload_dof				= 0.0, 0.5, 5, 1.7

;---дисперсия---------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base	= 0.30 ;0.15	;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)
crosshair_inertion		= 3.45

;отдача
cam_return				= 0
cam_relax_speed         = 7		;скорость возврата в исходное положение
cam_relax_speed_ai      = 360
cam_dispersion          = 1.8	;увеличения угла (в градусах) с каждым выстрелом
cam_dispersion_inc		= 1.8	;увеличениe cam_dispersion с каждым выстрелом
cam_dispersion_frac		= 1.0	;ствол будет подыматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle			= 60.0	;максимальный угол отдачи
cam_max_angle_horz		= 10.0	;(degree) maximum shot horizontal degree
cam_step_angle_horz		= 1.2	;(degree) size of step camera moved in horizontal position while shooting
detector_disp_factor            = 3                     ;во сколько раз увеличится дисперсия оружия при активном детекторе в другой руке.

PDM_disp_base 				= 1.35
PDM_disp_vel_factor 		= 1.1
PDM_disp_accel_factor 		= 1.1
PDM_disp_crouch	 				= 1.0
