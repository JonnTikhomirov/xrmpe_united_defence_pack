cform          		 = skeleton
class				 = AMMO_S
$prefetch 			 = 64
k_dist				 = 1 ;максимальная дистанция пули, после которой она исчезнет
k_disp				 = 1 ;точность полета пули
k_hit				 = 1 ;урон (умножается на hit_power оружия)
k_impulse			 = 1 ;с какой физической силой пуля долбанет по чему то (например насколько сильно откинетсяю/сдвинется объект по которому стрельнут)
k_ap				 = 1 ;коэффицент пробиваемости/бронебойности (насколько сильно пуля пробивает бронежилет (в прошлых частях k_pierce))
impair				 = 1 ;коэффициент износа оружия при стрельбе с этим припасом
buck_shot			 = 1 ;количество вылетающих пуль за раз
tracer				 = off ;будет ли пуля трассирующей
wm_size				 = 0.05 ;размер отверстия от пули
k_air_resistance 	 = 1 ;сопротивление воздуху (влияет на дальность полета пули, в простонародии настильность)

