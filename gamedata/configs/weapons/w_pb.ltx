inv_weight				= 0.77

upgrades = vartree_pb_barrel1, vartree_pb_shell_ejector, vartree_pb_details, vartree_pb_sights, vartree_pb_handle, vartree_pb_mag
installed_upgrades      =
upgrade_scheme          = upgrade_scheme_pb

def_hide_bones = sight

;--TTX---------------------------------------------------------------------------
hit_power           		= 0.53, 0.53, 0.53, 0.53
hit_impulse	 		 		= 50
hit_type 					= fire_wound
fire_distance           	= 200
bullet_speed		 		= 315
rpm                     	= 340

use_aim_bullet					= false		;Поддерживается ли первая суппер пуля
time_to_aim						= 2.0

hud                     	= wpn_pb_hud

misfire_probability        = 0.005 ;вероятность осечки при максимальном износе  !!!old - now not working
;изношенность, при которой появляется шанс осечки
misfire_start_condition		= 0.5
;изношеность при которой шанс осечки становится константным
misfire_end_condition		= 0.1
;шанс осечки при изношености больше чем misfireStartCondition
misfire_start_prob	     	= 0.0085
;шанс осечки при изношености больше чем misfireEndCondition
misfire_end_prob	     	= 0.085
;увеличение изношености при одиночном выстреле
condition_shot_dec      	= 0.002
;увеличение изношености при выстреле очередью
condition_queue_shot_dec	= 0.002

ammo_elapsed		 	= 8
ammo_mag_size		 	= 8
ammo_class		 		= ammo_9x18_fmj, ammo_9x18_pmm, ammo_9x18_pbp
hand_dependence		 	= 1
single_handed			= 1

;---дисперсия----------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base	= 0.25 ;0.15 			;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)
