[wpn_pb]:identity_immunities,weapon_probability,default_weapon_params
$spawn                  	= "weapons\pb"		; option for Level Editor
cform             			= skeleton
class                   	= WP_PM
description					= st_wpn_pb_descr
ef_weapon_type				= 5

tracers                           = off
tracers_color_ID                  = 2

;-------------------------------------------------------------------------------
