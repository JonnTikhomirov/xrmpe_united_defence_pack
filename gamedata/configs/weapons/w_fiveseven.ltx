hit_power           		= 0.87, 0.87, 0.87, 0.87
hit_impulse	 		 		= 100
hit_type 					= fire_wound
fire_distance           	= 200
bullet_speed		 		= 716
rpm                     	= 320

use_aim_bullet				= false		;Поддерживается ли первая суппер пуля
time_to_aim					= 2.0

hud                     	= wpn_fiveseven_hud

misfire_probability        = 0.005 ;вероятность осечки при максимальном износе  !!!old - now not working
;изношенность, при которой появляется шанс осечки
misfire_start_condition		= 0.5
;изношеность при которой шанс осечки становится константным
misfire_end_condition		= 0.1
;шанс осечки при изношености больше чем misfireStartCondition
misfire_start_prob	     	= 0.0055
;шанс осечки при изношености больше чем misfireEndCondition
misfire_end_prob	     	= 0.055
;увеличение изношености при одиночном выстреле
condition_shot_dec      	= 0.0013
;увеличение изношености при выстреле очередью
condition_queue_shot_dec	= 0.0013

;////////////////////////////////////////////Осечки////////////////////////////////////////////////////////////
;Это - разновидность задержки => происходит только в указанных для задержек пределах
;включаем использование осечек
use_light_misfire = true
;начальное состояние оружия, при котором происходят осечки; независимо от указанного тут значения, при состояниях лучшем, чем misfire_start_condition, осечек не будет
light_misfire_start_condition = 0.5
;состояние, хуже которого вероятность осечки константа
light_misfire_end_condition = 0.1
;какая часть всех задержек будет осечками в начальном состоянии
light_misfire_start_probability = 0.8
;какая часть всех задержек будет осечками на нижнем пороге
light_misfire_end_probability = 0.4

