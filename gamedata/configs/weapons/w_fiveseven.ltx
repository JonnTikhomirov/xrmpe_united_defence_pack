launch_speed      = 0
hand_dependence		 	= 1
single_handed			= 1

;---DOF-------------------------------------------------------------------------
zoom_dof					= -1000, 1.0, 1000
reload_dof						= 0.0, 0.5, 5, 1.7

;---дисперсия---------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base	= 0.19 ;0.7 			;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)
