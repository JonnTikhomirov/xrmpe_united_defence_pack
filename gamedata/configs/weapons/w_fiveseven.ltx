;отдача
cam_return				= 0
cam_relax_speed         = 7				;скорость возврата в исходное положение
cam_dispersion          = 0.7				;увеличения угла (в градусах) с каждым выстрелом
cam_dispersion_inc		= 0.3				;увеличениe cam_dispersion с каждым выстрелом
cam_dispersion_frac		= 0.8				;ствол будет подыматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle			= 30.0			;максимальный угол отдачи
cam_max_angle_horz		= 10.0			;(degree) maximum shot horizontal degree
cam_step_angle_horz		= 1.0				;(degree) size of step camera moved in horizontal position while shooting
detector_disp_factor            = 3                     ;во сколько раз увеличится дисперсия оружия при активном детекторе в другой руке.

