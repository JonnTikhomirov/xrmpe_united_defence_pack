[sniper_vision_free]:stalker_vision_free
min_view_distance 			= 0.8		; коэффициент, который множится на eye_range, в зависимости от угла
max_view_distance 			= 1.6		; коэффициент, который множится на eye_range, в зависимости от угла
visibility_threshold	 	= 60		; значение, при достижении суммой которого объект считается видимым
decrease_value				= 0.05		; значение, на которое уменьшается вес, если объект попал в фрустум, но отсёкся по каким-то причинам
luminocity_factor			= 1.0		; фактор освещения (только для Актёра)
transparency_threshold	 	= 0.7

