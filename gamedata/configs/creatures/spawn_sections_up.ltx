[sniper_vision_free]:stalker_vision_danger
min_view_distance   		= 2.5		; коэффициент, который множится на eye_range, в зависимости от угла
max_view_distance	 		= 3			; коэффициент, который множится на eye_range, в зависимости от угла
visibility_threshold	 	= 10.0		; значение, при достижении суммой которого объект считается видимым
always_visible_distance 	= 1
decrease_value				= 0.01		; значение, на которое уменьшается вес, если объект попал в фрустум, но отсёкся по каким-то причинам
time_quant					= 0.005
velocity_factor		     	= 0.8
luminocity_factor			= 1.0		; фактор освещения (только для Актёра)
transparency_threshold	 	= 0.9; видимость всквозь ВСЕ

