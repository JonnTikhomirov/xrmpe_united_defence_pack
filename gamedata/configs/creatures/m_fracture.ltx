health_hit_part 	= 1.0		;0.8			;процент хита, уходящий на отнимание здоровья
power_hit_part 		= 1.0		;0.9			;процент хита, уходящий на отнимание силы
psy_health_v = 0.1						;скорость восстановления psy-здоровья

;Immunities
