<!-- frame_right -->
<frame_right_weather>
	<weather_frame x="0" y="0" width="518" height="371">
		<!-- <texture>ui_stroketextbox</texture> +UP -->
		<weather_list x="1" y="1" width="516" height="370" item_height="20" always_show_scroll="0" can_select="1">
			<font font="letterica16" r="216" g="186" b="140"/>
		</weather_list>
	</weather_frame>
	<weather_frame_buttons x="0" y="372" width="518" height="30"><!-- +UP -->
		<checkbox_now x="10" y="6" width="22" height="22">
			<text font="letterica18" align="l" x="-10" y="-1" r="216" g="186" b="140" complex_mode="0">tool_weather_set_now</text>
			<!-- + UP -->
			<check_mark anchor="mid-center" width="30" height="22"/>
			<!-- - UP -->
		</checkbox_now>
		<btn_set x="329" y="3" width="90" height="26">
			<texture_e>ui_button_ordinary_e</texture_e>
			<texture_t>ui_button_ordinary_t</texture_t>
			<texture_h>ui_button_ordinary_h</texture_h>
			<text font="letterica18" x="0" y="0" align="c" vert_align="c" color="ui_6">tool_weather_set</text>
		</btn_set>
		<btn_surge x="424" y="3" width="90" height="26">
			<texture_e>ui_button_ordinary_e</texture_e>
			<texture_t>ui_button_ordinary_t</texture_t>
			<texture_h>ui_button_ordinary_h</texture_h>
			<text font="letterica18" x="0" y="0" align="c" vert_align="c" color="ui_6">tool_weather_surge</text>
		</btn_surge>
		<!-- +UP -->
		<btn_add_hour x="230" y="3" width="70" height="26">
			<texture_e>ui_button_ordinary_e</texture_e>
			<texture_t>ui_button_ordinary_t</texture_t>
			<texture_h>ui_button_ordinary_h</texture_h>
			<text font="letterica18" x="0" y="0" align="c" vert_align="c" color="ui_6">tool_weather_add_hour</text>
		</btn_add_hour>
		<!-- -UP -->
	</weather_frame_buttons>
	<!-- +UP -->
	<time_track x="297" y="505" width="518" height="50" step="0.005" percent_value="1">
		<auto_static anchor="top-center" width="398" height="35" stretch="1">
			<texture>ui_inGame2_sky_panorama</texture>
		</auto_static>
		<dec_button anchor="mid-left" width="40" height="35" stretch="1">
			<texture>ui_mainmenu_left_arrow_btn</texture>
			<sound_h>interface\ui_aim_button</sound_h>
			<sound_t>interface\select_button</sound_t>
		</dec_button>
		<inc_button anchor="mid-right" width="40" height="35" stretch="1">
			<texture>ui_mainmenu_right_arrow_btn</texture>
			<sound_h>interface\ui_aim_button</sound_h>
			<sound_t>interface\select_button</sound_t>
		</inc_button>
		<fill anchor="mid-center" width="468" height="35" stretch="1">
			<text y="-5" font="din_next17_bold" vert_align="c" align="c"/>
			<text_color>
				<e color="gray_mpe"/>
				<t color="ui_white"/>
				<d color="dark_gray_mpe"/>
				<h color="ui_white"/>
			</text_color>
			<sound_h>interface\ui_aim_button</sound_h>
			<sound_t>interface\select_button</sound_t>
		</fill>
		<hour_st x="54" y="35" width="19" height="15" complex_mode="0">
			<text align="l" vert_align="c" font="letterica16" r="180" g="180" b="180"/>
		</hour_st>
		<marker x="48" y="0" width="10" height="35" stretch="0">
			<texture>ui_inGame2_marker</texture>
		</marker>
	</time_track>
	<!-- -UP -->
</frame_right_weather>
