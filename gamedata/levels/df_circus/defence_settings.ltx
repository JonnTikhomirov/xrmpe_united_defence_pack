[defence_gamedata]
spawn_delay = 2 ; время задержки между спавном мутантов (в секундах)
spawn_particles = anomaly2\teleport_out ; партикл, с которым спавнятся монстры, можно удалить
;spawn_sound = ambient\defence\defence_teleport ; звук, с которым спавнятся монстры, можно удалить
start_time = 9 ; стартовое время на локации, работает аналогично консольной команде sv_setenvtime, возможные значения 0-23, можно удалить


[defence_modifiers]
